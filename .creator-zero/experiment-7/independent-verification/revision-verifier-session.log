   \"supporting_evidence\": [\n        {\n          \"frozen_artifact\": \"experiment-5/controls/shadow-a/launch-provenance.json\",\n          \"sha256\": \"32ab5c3ed5287d7b5daa5460560a14802b82e43912dccaa702780e1064480513\"\n        },\n        {\n          \"frozen_artifact\": \"experiment-5/aggregate-results.json\",\n          \"sha256\": \"635621885c398b308228dc9bafabb39c5ab65a2f7b928cab663f57a6a60af185\"\n        }\n      ],\n      \"version\": 1\n    },\n    {\n      \"contradicting_evidence\": [],\n      \"id\": \"P-ATTENUATION\",\n      \"parent_principles\": [],\n      \"preconditions\": [\n        \"topology:creates_child\"\n      ],\n      \"predicted_topology_effects\": [\n        \"child contract passes check_attenuation against its parent\"\n      ],\n      \"scope\": [\n        \"child-creation\",\n        \"governance\"\n      ],\n      \"statement\": \"Every descendant contract is monotonically attenuated: no authority axis may increase from parent to child, checked locally at every creation.\",\n      \"status\": \"SUPPORTED\",\n      \"supporting_evidence\": [\n        {\n          \"frozen_artifact\": \"experiment-4/root-contract.json\",\n          \"sha256\": \"17bb0c888c1366d2ef49f884743027afec179c6fbed8b67cbf4e701fc1f4f382\"\n        },\n        {\n          \"frozen_artifact\": \"experiment-4/child-1-contract.json\",\n          \"sha256\": \"4a0d935115089ff5d77abdb225f25e1d11ed32a3fdc26dc9aa0bf153c905f90c\"\n        },\n        {\n          \"frozen_artifact\": \"experiment-4/child-2-contract.json\",\n          \"sha256\": \"4f6865fec22eada3eb73ed537ca23a0a1461abdb095501230fc75d7a883d04d9\"\n        },\n        {\n          \"frozen_artifact\": \"experiment-4/closure-correction/corrected-k3-attestation.json\",\n          \"sha256\": \"5ff1a8502cdd7e325d21c00af14e50f1579492219a08d08136d1bf603213e92a\"\n        }\n      ],\n      \"version\": 1\n    },\n    {\n      \"contradicting_evidence\": [],\n      \"falsifier\": \"a reference-exposed path yields evidence scored admissible for a clean-room distinction, or the isolated clean-room author fails to add admissible value where the requirement is present\",\n      \"id\": \"P-AUTHORSHIP-INDEPENDENCE\",\n      \"parent_principles\": [\n        \"P-INDEPENDENCE\"\n      ],\n      \"preconditions\": [\n        \"feature:requires_clean_room_authorship\"\n      ],\n      \"predicted_topology_effects\": [\n        \"adds an independent path with canonical role clean_room_author\",\n        \"that path's evidence is admissible for CLEAN_ROOM_AUTHORSHIP distinctions (required vector [1, 0, 0, 0])\",\n        \"cheaper admissible paths dominate costlier ones at equal coverage (saturating value)\"\n      ],\n      \"scope\": [\n        \"topology-decision\",\n        \"verification\"\n      ],\n      \"statement\": \"When a distinction requires clean-room authorship \\u2014 an artifact written without exposure to the existing solution it might otherwise copy \\u2014 admissible evidence is supplied by an isolated fresh child node operating in the clean_room_author role, whose launch provenance shows it never had access to the contaminating material. An artifact authored in the parent session, or by any node that read the existing solution before writing, does not satisfy the relation, no matter how independently the work is later characterized. Isolation is required here only to guarantee non-exposure at authoring time; it adds no evidential weight beyond that guarantee.\",\n      \"status\": \"CANDIDATE\",\n      \"supporting_evidence\": [\n        {\n          \"context_kind\": \"CLEAN_ROOM_AUTHORSHIP\",\n          \"evidence_event_id\": \"H-e6-t01-branching-ev002\",\n          \"source\": \"experiment-6 imported theory evidence\"\n        },\n        {\n          \"context_kind\": \"CLEAN_ROOM_AUTHORSHIP\",\n          \"evidence_event_id\": \"H-e6-t01-branching-ev008\",\n          \"source\": \"experiment-6 imported theory evidence\"\n        },\n        {\n          \"context_kind\": \"CLEAN_ROOM_AUTHORSHIP\",\n          \"evidence_event_id\": \"H-e6-t01-isolated-child-ev002\",\n          \"source\": \"experiment-6 imported theory evidence\"\n        },\n        {\n          \"context_kind\": \"CLEAN_ROOM_AUTHORSHIP\",\n          \"evidence_event_id\": \"H-e6-t01-isolated-child-ev008\",\n          \"source\": \"experiment-6 imported theory evidence\"\n        },\n        {\n          \"context_kind\": \"CLEAN_ROOM_AUTHORSHIP\",\n          \"evidence_event_id\": \"H-e6-t05-isolated-child-ev002\",\n          \"source\": \"experiment-6 imported theory evidence\"\n        },\n        {\n          \"context_kind\": \"CLEAN_ROOM_AUTHORSHIP\",\n          \"evidence_event_id\": \"H-e6-t05-isolated-child-ev007\",\n          \"source\": \"experiment-6 imported theory evidence\"\n        },\n        {\n          \"context_kind\": \"CLEAN_ROOM_AUTHORSHIP\",\n          \"evidence_event_id\": \"H-e6-t07-branching-ev002\",\n          \"source\": \"experiment-6 imported theory evidence\"\n        },\n        {\n          \"context_kind\": \"CLEAN_ROOM_AUTHORSHIP\",\n          \"evidence_event_id\": \"H-e6-t07-branching-ev008\",\n          \"source\": \"experiment-6 imported theory evidence\"\n        },\n        {\n          \"context_kind\": \"CLEAN_ROOM_AUTHORSHIP\",\n          \"evidence_event_id\": \"H-e6-t07-isolated-child-ev002\",\n          \"source\": \"experiment-6 imported theory evidence\"\n        },\n        {\n          \"context_kind\": \"CLEAN_ROOM_AUTHORSHIP\",\n          \"evidence_event_id\": \"H-e6-t07-isolated-child-ev008\",\n          \"source\": \"experiment-6 imported theory evidence\"\n        },\n        {\n          \"context_kind\": \"CLEAN_ROOM_AUTHORSHIP\",\n          \"evidence_event_id\": \"H-e6-t19-isolated-child-ev001\",\n          \"source\": \"experiment-6 imported theory evidence\"\n        },\n        {\n          \"context_kind\": \"CLEAN_ROOM_AUTHORSHIP\",\n          \"evidence_event_id\": \"H-e6-t19-isolated-child-ev007\",\n          \"source\": \"experiment-6 imported theory evidence\"\n        }\n      ],\n      \"version\": 1\n    },\n    {\n      \"contradicting_evidence\": [],\n      \"falsifier\": \"a decomposition produced with access to the first is scored admissible, or the isolated decomposer duplicates the first decomposition without novel enumeration evidence\",\n      \"id\": \"P-INDEPENDENT-DECOMPOSITION\",\n      \"parent_principles\": [\n        \"P-INDEPENDENCE\"\n      ],\n      \"preconditions\": [\n        \"feature:requires_independent_decomposition\"\n      ],\n      \"predicted_topology_effects\": [\n        \"adds an independent path with canonical role independent_decomposer\",\n        \"that path's evidence is admissible for INDEPENDENT_DECOMPOSITION distinctions (required vector [0, 0, 1, 0])\",\n        \"cheaper admissible paths dominate costlier ones at equal coverage (saturating value)\"\n      ],\n      \"scope\": [\n        \"topology-decision\",\n        \"verification\"\n      ],\n      \"statement\": \"When a distinction requires independent decomposition \\u2014 a breakdown of the problem derived without access to the parent's own decomposition \\u2014 admissible evidence is supplied by a child node in the independent_decomposer role that produces its decomposition before seeing the parent's version. A node that receives, refines, or merely ratifies the parent's existing breakdown does not satisfy the relation, and neither does the parent re-decomposing within its own session. The relation claims only that the second decomposition was derived independently, so its agreement or divergence is informative; it does not claim that an isolated node's decomposition is generally better than local work.\",\n      \"status\": \"CANDIDATE\",\n      \"supporting_evidence\": [\n        {\n          \"context_kind\": \"INDEPENDENT_DECOMPOSITION\",\n          \"evidence_event_id\": \"H-e6-t09-branching-ev003\",\n          \"source\": \"experiment-6 imported theory evidence\"\n        },\n        {\n          \"context_kind\": \"INDEPENDENT_DECOMPOSITION\",\n          \"evidence_event_id\": \"H-e6-t09-branching-ev008\",\n          \"source\": \"experiment-6 imported theory evidence\"\n        },\n        {\n          \"context_kind\": \"INDEPENDENT_DECOMPOSITION\",\n          \"evidence_event_id\": \"H-e6-t09-isolated-child-ev003\",\n          \"source\": \"experiment-6 imported theory evidence\"\n        },\n        {\n          \"context_kind\": \"INDEPENDENT_DECOMPOSITION\",\n          \"evidence_event_id\": \"H-e6-t09-isolated-child-ev008\",\n          \"source\": \"experiment-6 imported theory evidence\"\n        },\n        {\n          \"context_kind\": \"INDEPENDENT_DECOMPOSITION\",\n          \"evidence_event_id\": \"H-e6-t16-isolated-child-ev002\",\n          \"source\": \"experiment-6 imported theory evidence\"\n        },\n        {\n          \"context_kind\": \"INDEPENDENT_DECOMPOSITION\",\n          \"evidence_event_id\": \"H-e6-t16-isolated-child-ev007\",\n          \"source\": \"experiment-6 imported theory evidence\"\n        },\n        {\n          \"context_kind\": \"INDEPENDENT_DECOMPOSITION\",\n          \"evidence_event_id\": \"H-e6-t17-branching-ev002\",\n          \"source\": \"experiment-6 imported theory evidence\"\n        },\n        {\n          \"context_kind\": \"INDEPENDENT_DECOMPOSITION\",\n          \"evidence_event_id\": \"H-e6-t17-branching-ev007\",\n          \"source\": \"experiment-6 imported theory evidence\"\n        },\n        {\n          \"context_kind\": \"INDEPENDENT_DECOMPOSITION\",\n          \"evidence_event_id\": \"H-e6-t17-isolated-child-ev002\",\n          \"source\": \"experiment-6 imported theory evidence\"\n        },\n        {\n          \"context_kind\": \"INDEPENDENT_DECOMPOSITION\",\n          \"evidence_event_id\": \"H-e6-t17-isolated-child-ev007\",\n          \"source\": \"experiment-6 imported theory evidence\"\n        },\n        {\n          \"context_kind\": \"INDEPENDENT_DECOMPOSITION\",\n          \"evidence_event_id\": \"H-e6-t18-isolated-child-ev002\",\n          \"source\": \"experiment-6 imported theory evidence\"\n        },\n        {\n          \"context_kind\": \"INDEPENDENT_DECOMPOSITION\",\n          \"evidence_event_id\": \"H-e6-t18-isolated-child-ev007\",\n          \"source\": \"experiment-6 imported theory evidence\"\n        }\n      ],\n      \"version\": 1\n    },\n    {\n      \"contradicting_evidence\": [],\n      \"falsifier\": \"a method-sharing verification is scored admissible for a method-disjoint distinction, or the method-disjoint verifier fails to add admissible value where the requirement is present\",\n      \"id\": \"P-METHOD-DISJOINT-VERIFICATION\",\n      \"parent_principles\": [\n        \"P-INDEPENDENCE\"\n      ],\n      \"preconditions\": [\n        \"feature:requires_method_disjoint_verification\"\n      ],\n      \"predicted_topology_effects\": [\n        \"adds an independent path with canonical role method_disjoint_verifier\",\n        \"that path's evidence is admissible for METHOD_DISJOINT_VERIFICATION distinctions (required vector [0, 0, 0, 1])\",\n        \"cheaper admissible paths dominate costlier ones at equal coverage (saturating value)\"\n      ],\n      \"scope\": [\n        \"topology-decision\",\n        \"verification\"\n      ],\n      \"statement\": \"When a distinction requires method-disjoint verification \\u2014 checking a result by a method different from the one that produced it \\u2014 admissible evidence is supplied by a node in the method_disjoint_verifier role whose check demonstrably uses a distinct method from the original derivation. Re-running the original method, even in a fully isolated fresh session, is replication rather than method-disjoint verification and does not satisfy the relation. Isolation matters here only insofar as it prevents the original method from leaking into the check; the evidential weight comes from the disjointness of methods, not from the isolation itself.\",\n      \"status\": \"CANDIDATE\",\n      \"supporting_evidence\": [\n        {\n          \"context_kind\": \"METHOD_DISJOINT_VERIFICATION\",\n          \"evidence_event_id\": \"H-e6-t03-isolated-child-ev002\",\n          \"source\": \"experiment-6 imported theory evidence\"\n        },\n        {\n          \"context_kind\": \"METHOD_DISJOINT_VERIFICATION\",\n          \"evidence_event_id\": \"H-e6-t03-isolated-child-ev007\",\n          \"source\": \"experiment-6 imported theory evidence\"\n        },\n        {\n          \"context_kind\": \"METHOD_DISJOINT_VERIFICATION\",\n          \"evidence_event_id\": \"H-e6-t06-isolated-child-ev003\",\n          \"source\": \"experiment-6 imported theory evidence\"\n        },\n        {\n          \"context_kind\": \"METHOD_DISJOINT_VERIFICATION\",\n          \"evidence_event_id\": \"H-e6-t06-isolated-child-ev008\",\n          \"source\": \"experiment-6 imported theory evidence\"\n        },\n        {\n          \"context_kind\": \"METHOD_DISJOINT_VERIFICATION\",\n          \"evidence_event_id\": \"H-e6-t14-branching-ev002\",\n          \"source\": \"experiment-6 imported theory evidence\"\n        },\n        {\n          \"context_kind\": \"METHOD_DISJOINT_VERIFICATION\",\n          \"evidence_event_id\": \"H-e6-t14-branching-ev007\",\n          \"source\": \"experiment-6 imported theory evidence\"\n        },\n        {\n          \"context_kind\": \"METHOD_DISJOINT_VERIFICATION\",\n          \"evidence_event_id\": \"H-e6-t14-isolated-child-ev002\",\n          \"source\": \"experiment-6 imported theory evidence\"\n        },\n        {\n          \"context_kind\": \"METHOD_DISJOINT_VERIFICATION\",\n          \"evidence_event_id\": \"H-e6-t14-isolated-child-ev007\",\n          \"source\": \"experiment-6 imported theory evidence\"\n        },\n        {\n          \"context_kind\": \"METHOD_DISJOINT_VERIFICATION\",\n          \"evidence_event_id\": \"H-e6-t20-isolated-child-ev004\",\n          \"source\": \"experiment-6 imported theory evidence\"\n        },\n        {\n          \"context_kind\": \"METHOD_DISJOINT_VERIFICATION\",\n          \"evidence_event_id\": \"H-e6-t20-isolated-child-ev008\",\n          \"source\": \"experiment-6 imported theory evidence\"\n        }\n      ],\n      \"version\": 1\n    },\n    {\n      \"contradicting_evidence\": [],\n      \"falsifier\": \"the independent examiner's search is scored inadmissible where predicted admissible, or an isolated child strictly outperforms the examiner on the same search requirement at equal admissibility and equal coverage\",\n      \"id\": \"P-NONAUTHOR-SEARCH\",\n      \"parent_principles\": [\n        \"P-INDEPENDENCE\"\n      ],\n      \"preconditions\": [\n        \"feature:requires_nonauthor_search\"\n      ],\n      \"predicted_topology_effects\": [\n        \"adds an independent path with canonical role non_author_examiner\",\n        \"that path's evidence is admissible for NON_AUTHOR_SEARCH distinctions (required vector [0, 1, 0, 0])\",\n        \"cheaper admissible paths dominate costlier ones at equal coverage (saturating value)\"\n      ],\n      \"scope\": [\n        \"topology-decision\",\n        \"verification\"\n      ],\n      \"statement\": \"When a distinction requires a non-author search \\u2014 examination of an artifact by a party that did not write it \\u2014 admissible evidence is supplied by a child node in the non_author_examiner role that inspects the artifact without having contributed to its authorship. The author re-examining its own work does not satisfy the relation, and neither does evidence from a node in a different role (such as a clean-room author) that never actually examined the artifact. The relation demands only that examiner and author be distinct; it does not require, and gains nothing from, the examiner being isolated from information beyond the authorship boundary.\",\n      \"status\": \"CANDIDATE\",\n      \"supporting_evidence\": [\n        {\n          \"context_kind\": \"NON_AUTHOR_SEARCH\",\n          \"evidence_event_id\": \"H-e6-t08-isolated-child-ev003\",\n          \"source\": \"experiment-6 imported theory evidence\"\n        },\n        {\n          \"context_kind\": \"NON_AUTHOR_SEARCH\",\n          \"evidence_event_id\": \"H-e6-t08-isolated-child-ev007\",\n          \"source\": \"experiment-6 imported theory evidence\"\n        },\n        {\n          \"context_kind\": \"NON_AUTHOR_SEARCH\",\n          \"evidence_event_id\": \"H-e6-t10-isolated-child-ev002\",\n          \"source\": \"experiment-6 imported theory evidence\"\n        },\n        {\n          \"context_kind\": \"NON_AUTHOR_SEARCH\",\n          \"evidence_event_id\": \"H-e6-t10-isolated-child-ev007\",\n          \"source\": \"experiment-6 imported theory evidence\"\n        },\n        {\n          \"context_kind\": \"NON_AUTHOR_SEARCH\",\n          \"evidence_event_id\": \"H-e6-t11-isolated-child-ev003\",\n          \"source\": \"experiment-6 imported theory evidence\"\n        },\n        {\n          \"context_kind\": \"NON_AUTHOR_SEARCH\",\n          \"evidence_event_id\": \"H-e6-t11-isolated-child-ev007\",\n          \"source\": \"experiment-6 imported theory evidence\"\n        },\n        {\n          \"context_kind\": \"NON_AUTHOR_SEARCH\",\n          \"evidence_event_id\": \"H-e6-t13-isolated-child-ev003\",\n          \"source\": \"experiment-6 imported theory evidence\"\n        },\n        {\n          \"context_kind\": \"NON_AUTHOR_SEARCH\",\n          \"evidence_event_id\": \"H-e6-t13-isolated-child-ev007\",\n          \"source\": \"experiment-6 imported theory evidence\"\n        }\n      ],\n      \"version\": 1\n    }\n  ],\n  \"provenance\": {\n    \"revised_from\": 1,\n    \"revision_id\": \"rev-split-p-independence\"\n  },\n  \"revision_graph\": [\n    {\n      \"candidate_principles\": [\n        {\n          \"contradicting_evidence\": [],\n          \"falsifier\": \"a reference-exposed path yields evidence scored admissible for a clean-room distinction, or the isolated clean-room author fails to add admissible value where the requirement is present\",\n          \"id\": \"P-AUTHORSHIP-INDEPENDENCE\",\n          \"parent_principles\": [\n            \"P-INDEPENDENCE\"\n          ],\n          \"preconditions\": [\n            \"feature:requires_clean_room_authorship\"\n          ],\n          \"predicted_topology_effects\": [\n            \"adds an independent path with canonical role clean_room_author\",\n            \"that path's evidence is admissible for CLEAN_ROOM_AUTHORSHIP distinctions (required vector [1, 0, 0, 0])\",\n            \"cheaper admissible paths dominate costlier ones at equal coverage (saturating value)\"\n          ],\n          \"scope\": [\n            \"topology-decision\",\n            \"verification\"\n          ],\n          \"statement\": \"When a distinction requires clean-room authorship \\u2014 an artifact written without exposure to the existing solution it might otherwise copy \\u2014 admissible evidence is supplied by an isolated fresh child node operating in the clean_room_author role, whose launch provenance shows it never had access to the contaminating material. An artifact authored in the parent session, or by any node that read the existing solution before writing, does not satisfy the relation, no matter how independently the work is later characterized. Isolation is required here only to guarantee non-exposure at authoring time; it adds no evidential weight beyond that guarantee.\",\n          \"status\": \"CANDIDATE\",\n          \"supporting_evidence\": [\n            {\n              \"context_kind\": \"CLEAN_ROOM_AUTHORSHIP\",\n              \"evidence_event_id\": \"H-e6-t01-branching-ev002\",\n              \"source\": \"experiment-6 imported theory evidence\"\n            },\n            {\n              \"context_kind\": \"CLEAN_ROOM_AUTHORSHIP\",\n              \"evidence_event_id\": \"H-e6-t01-branching-ev008\",\n              \"source\": \"experiment-6 imported theory evidence\"\n            },\n            {\n              \"context_kind\": \"CLEAN_ROOM_AUTHORSHIP\",\n              \"evidence_event_id\": \"H-e6-t01-isolated-child-ev002\",\n              \"source\": \"experiment-6 imported theory evidence\"\n            },\n            {\n              \"context_kind\": \"CLEAN_ROOM_AUTHORSHIP\",\n              \"evidence_event_id\": \"H-e6-t01-isolated-child-ev008\",\n              \"source\": \"experiment-6 imported theory evidence\"\n            },\n            {\n              \"context_kind\": \"CLEAN_ROOM_AUTHORSHIP\",\n              \"evidence_event_id\": \"H-e6-t05-isolated-child-ev002\",\n              \"source\": \"experiment-6 imported theory evidence\"\n            },\n            {\n              \"context_kind\": \"CLEAN_ROOM_AUTHORSHIP\",\n              \"evidence_event_id\": \"H-e6-t05-isolated-child-ev007\",\n              \"source\": \"experiment-6 imported theory evidence\"\n            },\n            {\n              \"context_kind\": \"CLEAN_ROOM_AUTHORSHIP\",\n              \"evidence_event_id\": \"H-e6-t07-branching-ev002\",\n              \"source\": \"experiment-6 imported theory evidence\"\n            },\n            {\n              \"context_kind\": \"CLEAN_ROOM_AUTHORSHIP\",\n              \"evidence_event_id\": \"H-e6-t07-branching-ev008\",\n              \"source\": \"experiment-6 imported theory evidence\"\n            },\n            {\n              \"context_kind\": \"CLEAN_ROOM_AUTHORSHIP\",\n              \"evidence_event_id\": \"H-e6-t07-isolated-child-ev002\",\n              \"source\": \"experiment-6 imported theory evidence\"\n            },\n            {\n              \"context_kind\": \"CLEAN_ROOM_AUTHORSHIP\",\n              \"evidence_event_id\": \"H-e6-t07-isolated-child-ev008\",\n              \"source\": \"experiment-6 imported theory evidence\"\n            },\n            {\n              \"context_kind\": \"CLEAN_ROOM_AUTHORSHIP\",\n              \"evidence_event_id\": \"H-e6-t19-isolated-child-ev001\",\n              \"source\": \"experiment-6 imported theory evidence\"\n            },\n            {\n              \"context_kind\": \"CLEAN_ROOM_AUTHORSHIP\",\n              \"evidence_event_id\": \"H-e6-t19-isolated-child-ev007\",\n              \"source\": \"experiment-6 imported theory evidence\"\n            }\n          ],\n          \"version\": 1\n        },\n        {\n          \"contradicting_evidence\": [],\n          \"falsifier\": \"a decomposition produced with access to the first is scored admissible, or the isolated decomposer duplicates the first decomposition without novel enumeration evidence\",\n          \"id\": \"P-INDEPENDENT-DECOMPOSITION\",\n          \"parent_principles\": [\n            \"P-INDEPENDENCE\"\n          ],\n          \"preconditions\": [\n            \"feature:requires_independent_decomposition\"\n          ],\n          \"predicted_topology_effects\": [\n            \"adds an independent path with canonical role independent_decomposer\",\n            \"that path's evidence is admissible for INDEPENDENT_DECOMPOSITION distinctions (required vector [0, 0, 1, 0])\",\n            \"cheaper admissible paths dominate costlier ones at equal coverage (saturating value)\"\n          ],\n          \"scope\": [\n            \"topology-decision\",\n            \"verification\"\n          ],\n          \"statement\": \"When a distinction requires independent decomposition \\u2014 a breakdown of the problem derived without access to the parent's own decomposition \\u2014 admissible evidence is supplied by a child node in the independent_decomposer role that produces its decomposition before seeing the parent's version. A node that receives, refines, or merely ratifies the parent's existing breakdown does not satisfy the relation, and neither does the parent re-decomposing within its own session. The relation claims only that the second decomposition was derived independently, so its agreement or divergence is informative; it does not claim that an isolated node's decomposition is generally better than local work.\",\n          \"status\": \"CANDIDATE\",\n          \"supporting_evidence\": [\n            {\n              \"context_kind\": \"INDEPENDENT_DECOMPOSITION\",\n              \"evidence_event_id\": \"H-e6-t09-branching-ev003\",\n              \"source\": \"experiment-6 imported theory evidence\"\n            },\n            {\n              \"context_kind\": \"INDEPENDENT_DECOMPOSITION\",\n              \"evidence_event_id\": \"H-e6-t09-branching-ev008\",\n              \"source\": \"experiment-6 imported theory evidence\"\n            },\n            {\n              \"context_kind\": \"INDEPENDENT_DECOMPOSITION\",\n              \"evidence_event_id\": \"H-e6-t09-isolated-child-ev003\",\n              \"source\": \"experiment-6 imported theory evidence\"\n            },\n            {\n              \"context_kind\": \"INDEPENDENT_DECOMPOSITION\",\n              \"evidence_event_id\": \"H-e6-t09-isolated-child-ev008\",\n              \"source\": \"experiment-6 imported theory evidence\"\n            },\n            {\n              \"context_kind\": \"INDEPENDENT_DECOMPOSITION\",\n              \"evidence_event_id\": \"H-e6-t16-isolated-child-ev002\",\n              \"source\": \"experiment-6 imported theory evidence\"\n            },\n            {\n              \"context_kind\": \"INDEPENDENT_DECOMPOSITION\",\n              \"evidence_event_id\": \"H-e6-t16-isolated-child-ev007\",\n              \"source\": \"experiment-6 imported theory evidence\"\n            },\n            {\n              \"context_kind\": \"INDEPENDENT_DECOMPOSITION\",\n              \"evidence_event_id\": \"H-e6-t17-branching-ev002\",\n              \"source\": \"experiment-6 imported theory evidence\"\n            },\n            {\n              \"context_kind\": \"INDEPENDENT_DECOMPOSITION\",\n              \"evidence_event_id\": \"H-e6-t17-branching-ev007\",\n              \"source\": \"experiment-6 imported theory evidence\"\n            },\n            {\n              \"context_kind\": \"INDEPENDENT_DECOMPOSITION\",\n              \"evidence_event_id\": \"H-e6-t17-isolated-child-ev002\",\n              \"source\": \"experiment-6 imported theory evidence\"\n            },\n            {\n              \"context_kind\": \"INDEPENDENT_DECOMPOSITION\",\n              \"evidence_event_id\": \"H-e6-t17-isolated-child-ev007\",\n              \"source\": \"experiment-6 imported theory evidence\"\n            },\n            {\n              \"context_kind\": \"INDEPENDENT_DECOMPOSITION\",\n              \"evidence_event_id\": \"H-e6-t18-isolated-child-ev002\",\n              \"source\": \"experiment-6 imported theory evidence\"\n            },\n            {\n              \"context_kind\": \"INDEPENDENT_DECOMPOSITION\",\n              \"evidence_event_id\": \"H-e6-t18-isolated-child-ev007\",\n              \"source\": \"experiment-6 imported theory evidence\"\n            }\n          ],\n          \"version\": 1\n        },\n        {\n          \"contradicting_evidence\": [],\n          \"falsifier\": \"a method-sharing verification is scored admissible for a method-disjoint distinction, or the method-disjoint verifier fails to add admissible value where the requirement is present\",\n          \"id\": \"P-METHOD-DISJOINT-VERIFICATION\",\n          \"parent_principles\": [\n            \"P-INDEPENDENCE\"\n          ],\n          \"preconditions\": [\n            \"feature:requires_method_disjoint_verification\"\n          ],\n          \"predicted_topology_effects\": [\n            \"adds an independent path with canonical role method_disjoint_verifier\",\n            \"that path's evidence is admissible for METHOD_DISJOINT_VERIFICATION distinctions (required vector [0, 0, 0, 1])\",\n            \"cheaper admissible paths dominate costlier ones at equal coverage (saturating value)\"\n          ],\n          \"scope\": [\n            \"topology-decision\",\n            \"verification\"\n          ],\n          \"statement\": \"When a distinction requires method-disjoint verification \\u2014 checking a result by a method different from the one that produced it \\u2014 admissible evidence is supplied by a node in the method_disjoint_verifier role whose check demonstrably uses a distinct method from the original derivation. Re-running the original method, even in a fully isolated fresh session, is replication rather than method-disjoint verification and does not satisfy the relation. Isolation matters here only insofar as it prevents the original method from leaking into the check; the evidential weight comes from the disjointness of methods, not from the isolation itself.\",\n          \"status\": \"CANDIDATE\",\n          \"supporting_evidence\": [\n            {\n              \"context_kind\": \"METHOD_DISJOINT_VERIFICATION\",\n              \"evidence_event_id\": \"H-e6-t03-isolated-child-ev002\",\n              \"source\": \"experiment-6 imported theory evidence\"\n            },\n            {\n              \"context_kind\": \"METHOD_DISJOINT_VERIFICATION\",\n              \"evidence_event_id\": \"H-e6-t03-isolated-child-ev007\",\n              \"source\": \"experiment-6 imported theory evidence\"\n            },\n            {\n              \"context_kind\": \"METHOD_DISJOINT_VERIFICATION\",\n              \"evidence_event_id\": \"H-e6-t06-isolated-child-ev003\",\n              \"source\": \"experiment-6 imported theory evidence\"\n            },\n            {\n              \"context_kind\": \"METHOD_DISJOINT_VERIFICATION\",\n              \"evidence_event_id\": \"H-e6-t06-isolated-child-ev008\",\n              \"source\": \"experiment-6 imported theory evidence\"\n            },\n            {\n              \"context_kind\": \"METHOD_DISJOINT_VERIFICATION\",\n              \"evidence_event_id\": \"H-e6-t14-b