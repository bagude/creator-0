   \"predicted_topology_effects\": [\n237\t            \"adds an independent path with canonical role independent_decomposer\",\n238\t            \"that path's evidence is admissible for INDEPENDENT_DECOMPOSITION distinctions (required vector [0, 0, 1, 0])\",\n239\t            \"cheaper admissible paths dominate costlier ones at equal coverage (saturating value)\"\n240\t          ],\n241\t          \"scope\": [\n242\t            \"topology-decision\",\n243\t            \"verification\"\n244\t          ],\n245\t          \"statement\": \"When a distinction requires independent decomposition \\u2014 a breakdown of the problem derived without access to the parent's own decomposition \\u2014 admissible evidence is supplied by a child node in the independent_decomposer role that produces its decomposition before seeing the parent's version. A node that receives, refines, or merely ratifies the parent's existing breakdown does not satisfy the relation, and neither does the parent re-decomposing within its own session. The relation claims only that the second decomposition was derived independently, so its agreement or divergence is informative; it does not claim that an isolated node's decomposition is generally better than local work.\",\n246\t          \"status\": \"CANDIDATE\",\n247\t          \"supporting_evidence\": [\n248\t            {\n249\t              \"context_kind\": \"INDEPENDENT_DECOMPOSITION\",\n250\t              \"evidence_event_id\": \"H-e6-t09-branching-ev003\",\n251\t              \"source\": \"experiment-6 imported theory evidence\"\n252\t            },\n253\t            {\n254\t              \"context_kind\": \"INDEPENDENT_DECOMPOSITION\",\n255\t              \"evidence_event_id\": \"H-e6-t09-branching-ev008\",\n256\t              \"source\": \"experiment-6 imported theory evidence\"\n257\t            },\n258\t            {\n259\t              \"context_kind\": \"INDEPENDENT_DECOMPOSITION\",\n260\t              \"evidence_event_id\": \"H-e6-t09-isol