tatus\": \"CANDIDATE\",\n46\t      \"type\": \"DEPRECATE\"\n47\t    },\n48\t    \"SPECIALIZE\": {\n49\t      \"candidate_principles\": [\n50\t        {\n51\t          \"contradicting_evidence\": [],\n52\t          \"falsifier\": \"\",\n53\t          \"id\": \"P-INDEPENDENCE-SPECIALIZED\",\n54\t          \"parent_principles\": [\n55\t            \"P-INDEPENDENCE\"\n56\t          ],\n57\t          \"preconditions\": [\n58\t            \"feature:requires_isolation\",\n59\t            \"feature:contamination\"\n60\t          ],\n61\t          \"predicted_topology_effects\": [\n62\t            \"adds an isolated fresh child (or independent verifier) node\",\n63\t            \"child evidence is novel, not a duplicate of parent evidence\",\n64\t            \"child resolves the assigned distinctions\"\n65\t          ],\n66\t          \"scope\": [\n67\t            \"topology-decision\",\n68\t            \"verification\"\n69\t          ],\n70\t          \"statement\": \"When a distinction requires evidence that the current session cannot produce without contaminating it (clean-room, independent authorship, adversarial check), an isolated fresh descendant or independent examiner adds epistemic value that local work cannot. [SPECIALIZED: preconditions narrowed to admissibility contexts ['CLEAN_ROOM_AUTHORSHIP'] in which the principle's predictions held]\",\n71\t          \"status\": \"CANDIDATE\",\n72\t          \"supporting_evidence\": [\n73\t            {\n74\t              \"frozen_artifact\": \"experiment-5/trials/t-031/decision.json\",\n75\t              \"sha256\": \"36611ccc00073203ca5430e5cd52481b79ecbe9d58f48f56b1ff3f677b90aaa5\"\n76\t            },\n77\t            {\n78\t              \"frozen_artifact\": \"experiment-5/trials/t-031/child/launch-provenance.json\",\n79\t              \"sha256\": \"9cb765b6b2c970188b2fa86e71cc5564d773c3dbc72a721b4d5caf489e4cbf05\"\n80\t            },\n81\t            {\n82\t              \"frozen_artifact\": \"experiment-5/aggregate-results.json\",\n83\t              \"sha256\": \"635621885c398b308228dc9bafabb39c5ab65a2f7b928cab663f57a6a60af185\"\n84\t            },\n85\t            {\n86\t              \"frozen_artifact\": \"experiment-3/execution-ledger.jsonl\",\n87\t              \"sha256\": \"bb561f728cc7e991266c9a33865894cfa528051dd825f4bcce40ceff415f3446\"\n88\t            }\n89\t          ],\n90\t          \"version\": 1\n91\t        }\n92\t      ],\n93\t      \"changed_predictions\": [],\n94\t      \"context_partition\": {\n95\t        \"retained_contexts\": [\n96\t          \"CLEAN_ROOM_AUTHORSHIP\"\n97\t        ]\n98\t      },\n99\t      \"historical_cases_affected\": [],\n100\t      \"motivating_evidence\": [\n101\t        \"H-e6-t03-isolated-child-ev002\",\n102\t        \"H-e6-t03-isolated-child-ev007\",\n103\t        \"H-e6-t06-isolated-child-ev003\",\n104\t        \"H-e6-t06-isolated-child-ev008\",\n105\t        \"H-e6-t08-isolated-child-ev003\",\n106\t        \"H-e6-t08-isolated-child-ev007\",\n107\t        \"H-e6-t09-branching-ev003\",\n108\t        \"H-e6-t09-branching-ev008\",\n109\t        \"H-e6-t09-isolated-child-ev003\",\n110\t        \"H-e6-t09-isolated-child-ev008\",\n111\t        \"H-e6-t10-isolated-child-ev002\",\n112\t        \"H-e6-t10-isolated-child-ev007\",\n113\t        \"H-e6-t11-isolated-child-ev003\",\n114\t        \"H-e6-t11-isolated-child-ev007\",\n115\t        \"H-e6-t13-isolated-child-ev003\",\n116\t        \"H-e6-t13-isolated-child-ev007\",\n117\t        \"H-e6-t14-branching-ev002\",\n118\t        \"H-e6-t14-branching-ev007\",\n119\t        \"H-e6-t14-isolated-child-ev002\",\n120\t        \"H-e6-t14-isolated-child-ev007\",\n121\t        \"H-e6-t16-isolated-child-ev002\",\n122\t        \"H-e6-t16-isolated-child-ev007\",\n123\t        \"H-e6-t17-branching-ev002\",\n124\t        \"H-e6-t17-branching-ev007\",\n125\t        \"H-e6-t17-isolated-child-ev002\",\n126\t        \"H-e6-t17-isolated-child-ev007\",\n127\t        \"H-e6-t18-isolated-child-ev002\",\n128\t        \"H-e6-t18-isolated-child-ev007\",\n129\t        \"H-e6-t20-isolated-child-ev004\",\n130\t        \"H-e6-t20-isolated-child-ev008\"\n131\t      ],\n132\t      \"parents\": [\n133\t        \"P-INDEPENDENCE\"\n134\t      ],\n135\t      \"revision_id\": \"rev-specialize-p-independence\",\n136\t      \"status\": \"CANDIDATE\",\n137\t      \"type\": \"SPECIALIZE\"\n138\t    },\n139\t    \"SPLIT\": {\n140\t      \"candidate_principles\": [\n141\t        {\n142\t          \"contradicting_evidence\": [],\n143\t          \"falsifier\": \"a reference-exposed path yields evidence scored admissible for a clean-room distinction, or the isolated clean-room author fails to add admissible value where the requirement is present\",\n144\t          \"id\": \"P-AUTHORSHIP-INDEPENDENCE\",\n145\t          \"parent_principles\": [\n146\t            \"P-INDEPENDENCE\"\n147\t          ],\n148\t          \"preconditions\": [\n149\t            \"feature:requires_clean_room_authorship\"\n150\t          ],\n151\t          \"predicted_topology_effects\": [\n152\t            \"adds an independent path with canonical role clean_room_author\",\n153\t            \"that path's evidence is admissible for CLEAN_ROOM_AUTHORSHIP distinctions (required vector [1, 0, 0, 0])\",\n154\t            \"cheaper admissible paths dominate costlier ones at equal coverage (saturating value)\"\n155\t          ],\n156\t          \"scope\": [\n157\t            \"topology-decision\",\n158\t            \"verification\"\n159\t          ],\n160\t          \"statement\": \"When a distinction requires clean-room authorship \\u2014 an artifact written without exposure to the existing solution it might otherwise copy \\u2014 admissible evidence is supplied by an isolated fresh child node operating in the clean_room_author role, whose launch provenance shows it never had access to the contaminating material. An artifact authored in the parent session, or by any node that read the existing solution before writing, does not 