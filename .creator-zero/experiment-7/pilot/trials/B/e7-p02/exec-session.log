scendants.\",\n  \"allowed_primitives\": [\"observe\", \"hypothesize\", \"verify\", \"return\"],\n  \"allowed_relations\": [\"observe\", \"verify\", \"authorize\", \"return\"],\n  \"allowed_tools\": [\"Read\", \"Write\"],\n  \"max_children\": 0,\n  \"max_depth\": 0,\n  \"max_model_calls\": 1,\n  \"may_create_creator\": false,\n  \"may_realize_creation\": false,\n  \"required_primitives_for_mutation\": [\"verify\"],\n  \"protected_rules\": [\n    \"No child may increase its authority envelope.\",\n    \"Model output is a proposal, never authorization.\",\n    \"Mutation-capable topology requires verification.\",\n    \"The child is terminal: it may not create, delegate, or launch anything.\"\n  ]\n}\n","numLines":21,"startLine":1,"totalLines":21}}}
