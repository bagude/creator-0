 \"verify\",\n      \"tools\": [\"Read\"],\n      \"can_create\": false,\n      \"execution_mode\": \"in_session\",\n      \"instructions\": \"Re-read the deliverable against the child task's requirements; record the structural outcome. Non-authoritative.\",\n      \"why_necessary\": \"Verify primitive required for a Write-holding topology; the deterministic root verification governs.\"\n    },\n    {\n      \"id\": \"return-result\",\n      \"primitive\": \"return\",\n      \"tools\": [\"Read\", \"Write\"],\n      \"can_create\": false,\n      \"execution_mode\": \"in_session\",\n      \"instructions\": \"Write result.json (deliverable summary, files produced, model_calls_spent 0), finalize execution-ledger.jsonl with the return event and a terminal complete event.\",\n      \"why_necessary\": \"Mandated return locus; without it the evidence never re-enters the governed boundary.\"\n    }\n  ],\n  \"edges\": [\n    {\"source\": \"observe-inputs\", \"target\": \"produce-evidence\", \"relation\": \"observe\", \"requires_response\": false, \"response_changes_parent_state\": false, \"transfers_authority\": false},\n    {\"source\": \"produce-evidence\", \"target\": \"self-check\", \"relation\": \"verify\", \"requires_response\": true, \"response_changes_parent_state\": false, \"transfers_authority\": false},\n    {\"source\": \"self-check\", \"target\": \"return-result\", \"relation\": \"authorize\", \"requires_response\": false, \"response_changes_parent_state\": false, \"transfers_authority\": false}\n  ],\n  \"ledger_contract\": {\n    \"path\": \"execution-ledger.jsonl (child workspace root)\",\n    \"schema\": \"normalized formal event schema: one JSON object per line with event_id, label, actor, timestamp, artifact_refs, metadata; node executions carry metadata.completes_node\",\n    \"required_node_execution_events\": [\n      {\"label\": \"observe\", \"actor\": \"node:observe-inputs\", \"metadata\": {\"completes_node\": \"observe-inputs\"}},\n      {\"label\": 