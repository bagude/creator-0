{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QEzXWzEJJ6TgW6fiep5Mm4","type":"tool_result","content":"800\t+        self.tmp = tempfile.mkdtemp()\n801\t+        self.store = TT.TheoryStore(self.tmp)\n802\t+        self.pin = PINS[\"e6_evidence_source\"]\n803\t+\n804\t+    def test_source_pin_verifies(self):\n805\t+        r = TT.ingest.verify_source_pin(E6_SOURCE, self.pin)\n806\t+        self.assertEqual(r[\"status\"], \"PASS\", r)\n807\t+\n808\t+    def test_mutated_source_fails_pin(self):\n809\t+        # NC4\n810\t+        mutated = Path(self.tmp) / \"mutated.jsonl\"\n811\t+        text = E6_SOURCE.read_text(encoding=\"utf-8\")\n812\t+        mutated.write_text(text.replace(\"SUPPORT\", \"FALSIFY\", 1),\n813\t+                           encoding=\"utf-8\")\n814\t+        r = TT.ingest.verify_source_pin(mutated, self.pin)\n815\t+        self.assertEqual(r[\"status\"], \"FAIL\")\n816\t+        self.assertEqual(r[\"failure_code\"], \"EVIDENCE_SOURCE_MISMATCH\")\n817\t+\n818\t+    def test_enrichment_joins_context_and_preserves_provenance(self):\n819\t+        raw = TT.ingest.load_source_events(E6_SOURCE)\n820\t+        enriched = TT.ingest.enrich_e6_events(\n821\t+            raw, _labels(), source_commit=\"bd0cf91\", source_path=\"x\",\n822\t+            source_artifact_id=\"sha256:src\")\n823\t+        self.assertEqual(len(enriched), 264)\n824\t+        ok = [e for e in enriched\n825\t+              if e[\"context\"].get(\"context_status\") == \"OK\"]\n826\t+        self.assertEqual(len(ok), 264)\n827\t+        kinds = {e[\"context\"][\"admissibility_kind\"] for e in ok}\n828\t+        self.assertLessEqual(\n829\t+            kinds, {\"LOCAL\", \"CLEAN_ROOM_AUTHORSHIP\", \"NON_AUTHOR_SEARCH\",\n830\t+                    \"INDEPENDENT_DECOMPOSITION\",\n831\t+                    \"METHOD_DISJOINT_VERIFICATION\"})\n832\t+        for e in enriched[:10]:\n833\t+            self.assertTrue(e[\"trial_id\"])\n834\t+            self.assertIn(e[\"run\"], (\"primary\", \"shadow\"))\n835\t+\n836\t+    def test_idempotent_import_and_conflict(self):\n837\t+        raw = TT.ingest.load_source_events(E6_SOURCE)[:6]\n838\t+        enriched = TT.ingest.enrich_e6_events(\n839\t+            raw, _labels(), source_commit=\"c\", source_path=\"p\",\n840\t+            source_artifact_id=\"sha256:s\")\n841\t+        m1 = TT.ingest.ingest_evidence(self.store, enriched)\n842\t+        self.assertEqual(m1[\"imported\"], 6)\n843\t+        self.assertTrue(m1[\"append_only_intact\"])\n844\t+        m2 = TT.ingest.ingest_evidence(self.store, enriched)\n845\t+        self.assertEqual(m2[\"imported\"], 0)\n846\t+        self.assertEqual(m2[\"skipped_identical\"], 6)\n847\t+        # NC5: same id, different content\n848\t+        bad = dict(enriched[0])\n849\t+        bad[\"effect\"] = \"FALSIFY\" if bad[\"effect\"] != \"FALSIFY\" else \"SUPPORT\"\n850\t+        with self.assertRaises(TT.ingest.EvidenceImportError):\n851\t+            TT.ingest.ingest_evidence(self.store, [bad])\n852\t+        chain = self.store.verify_append_only()\n853\t+        self.assertTrue(chain[\"append_only_intact\"])\n854\t+        self.assertEqual(chain[\"log_length\"], 6)\n855\t+\n856\t+\n857\t+if __name__ == \"__main__\":\n858\t+    unittest.main()\n859\tdiff --git a/.creator-zero/tests/topology_theory/test_lineage.py b/.creator-zero/tests/topology_theory/test_lineage.py\n860\tnew file mode 100644\n861\tindex 0000000..dc6a4a1\n862\t--- /dev/null\n863\t+++ b/.creator-zero/tests/topology_theory/test_lineage.py\n864\t@@ -0,0 +1,155 @@\n865\t+\"\"\"Lineage subsystem: checkpoint create/verify/resume (spec §20.1).\"\"\"\n866\t+from __future__ import annotations\n867\t+import json\n868\t+import shutil\n869\t+import subprocess\n870\t+import tempfile\n871\t+import unittest\n872\t+from pathlib import Path\n873\t+\n874\t+import _bootstrap\n875\t+from _bootstrap import CZROOT, REPO\n876\t+\n877\t+import importlib.util\n878\t+import sys\n879\t+\n880\t+\n881\t+def _load_lineage():\n882\t+    if \"lineage\" in sys.modules:\n883\t+        return sys.modules[\"lineage\"]\n884\t+    spec = importlib.util.spec_from_file_location(\n885\t+        \"lineage\", CZROOT / \"lineage\" / \"__init__.py\",\n886\t+        submodule_search_locations=[str(CZROOT / \"lineage\")])\n887\t+    mod = importlib.util.module_from_spec(spec)\n888\t+    sys.modules[\"lineage\"] = mod\n889\t+    spec.loader.exec_module(mod)\n890\t+    return mod\n891\t+\n892\t+\n893\t+LIN = _load_lineage()\n894\t+BASE_CP = CZROOT / \"experiment-7\" / \"base-checkpoint.json\"\n895\t+\n896\t+\n897\t+def _rebuild(doc: dict, **edits) -> dict:\n898\t+    from lineage.model import checkpoint_id_for\n899\t+    d = {k: v for k, v in doc.items() if k != \"checkpoint_id\"}\n900\t+    d.update(edits)\n901\t+    d[\"checkpoint_id\"] = checkpoint_id_for(d)\n902\t+    return d\n903\t+\n904\t+\n905\t+class CheckpointModelTest(unittest.TestCase):\n906\t+    def setUp(self):\n907\t+        self.doc = json.loads(BASE_CP.read_text(encoding=\"utf-8\"))\n908\t+\n909\t+    def test_base_checkpoint_parses_and_id_is_content_bound(self):\n910\t+        cp = LIN.LineageCheckpoint.from_dict(self.doc)\n911\t+        self.assertEqual(cp.commit_sha,\n912\t+                         \"bd0cf91e455393d3d601070e5022c565d9ed9ed1\")\n913\t+        self.assertEqual(cp.theory_version, 1)\n914\t+\n915\t+    def test_edited_body_without_new_id_is_rejected(self):\n916\t+        bad = dict(self.doc)\n917\t+        bad[\"experiment_result\"] = \"SOMETHING_ELSE\"\n918\t+        with self.assertRaises(LIN.LineageError):\n919\t+            LIN.LineageCheckpoint.from_dict(bad)\n920\t+\n921\t+    def test_unknown_fields_rejected(self):\n922\t+        bad = _rebuild(self.doc)\n923\t+        bad[\"surprise\"] = 1\n924\t+        with self.assertRaises(LIN.LineageError):\n925\t+            LIN.LineageCheckpoint.from_dict(bad)\n926\t+\n927\t+    def test_deterministic_serialization(self):\n928\t+        cp = LIN.LineageCheckpoint.from_dict(self.doc)\n929\t+        self.assertEqual(cp.serialize(), cp.serialize())\n930\t+        again = LIN.LineageCheckpoint.from_dict(\n931\t+            json.loads(cp.serialize()))\n932\t+        self.assertEqual(again.checkpoint_id, cp.checkpoint_id)\n933\t+\n934\t+\n935\t+class VerifyCheckpointTest(unittest.TestCase):\n936\t+    def setUp(self):\n937\t+        self.doc = json.loads(BASE_CP.read_text(encoding=\"utf-8\"))\n938\t+\n939\t+    def test_exact_checkpoint_passes_and_is_idempotent(self):\n940\t+        r1 = LIN.verify_checkpoint(REPO, self.doc)\n941\t+        r2 = LIN.verify_checkpoint(REPO, self.doc)\n942\t+        self.assertEqual(r1.status, \"PASS\", r1.to_dict())\n943\t+        self.assertEqual(r1.to_dict(), r2.to_dict())\n944\t+\n945\t+    def test_commit_mismatch_fails(self):\n946\t+        bad = _rebuild(self.doc,\n947\t+                       commit_sha=\"0\" * 40)\n948\t+        r = LIN.verify_checkpoint(REPO, bad)\n949\t+        self.assertEqual(r.status, \"FAIL\")\n950\t+        self.assertIn(\"COMMIT_MISMATCH\", r.failure_codes)\n951\t+        self.assertEqual(r.result, \"LINEAGE_RESUME_FAIL\")\n952\t+\n953\t+    def test_tree_mismatch_fails(self):\n954\t+        bad = _rebuild(self.doc, tree_sha=\"f\" * 40)\n955\t+        r = LIN.verify_checkpoint(REPO, bad)\n956\t+        self.assertIn(\"TREE_MISMATCH\", r.failure_codes)\n957\t+\n958\t+    def test_theory_mismatch_fails(self):\n959\t+        bad = _rebuild(self.doc, theory_artifact_id=\"sha256:\" + \"0\" * 64)\n960\t+        r = LIN.verify_checkpoint(REPO, bad)\n961\t+        self.assertIn(\"THEORY_MISMATCH\", r.failure_codes)\n962\t+\n963\t+    def test_evidence_head_mismatch_fails(self):\n964\t+        bad = _rebuild(self.doc, evidence_length=7,\n965\t+                       evidence_head_hash=\"deadbeef\" * 8)\n966\t+        r = LIN.verify_checkpoint(REPO, bad)\n967\t+        self.assertIn(\"EVIDENCE_HEAD_MISMATCH\", r.failure_codes)\n968\t+\n969\t+    def test_experiment_state_mismatch_fails(self):\n970\t+        bad = _rebuild(self.doc, experiment_state_sha256=\"0\" * 64)\n971\t+        r = LIN.verify_checkpoint(REPO, bad)\n972\t+        self.assertIn(\"EXPERIMENT_STATE_MISMATCH\", r.failure_codes)\n973\t+\n974\t+    def test_root_contract_and_kernel_mismatch_fail(self):\n975\t+        bad = _rebuild(self.doc, root_contract_sha256=\"1\" * 64)\n976\t+        r = LIN.verify_checkpoint(REPO, bad)\n977\t+        self.assertIn(\"ROOT_CONTRACT_MISMATCH\", r.failure_codes)\n978\t+        bad = _rebuild(self.doc, formal_kernel_state_artifact_id=\"2\" * 64)\n979\t+        r = LIN.verify_checkpoint(REPO, bad)\n980\t+        self.assertIn(\"FORMAL_KERNEL_MISMATCH\", r.failure_codes)\n981\t+\n982\t+    def test_protected_manifest_mismatch_fails(self):\n983\t+        bad = _rebuild(self.doc, protected_manifest_sha256=\"3\" * 64)\n984\t+        r = LIN.verify_checkpoint(REPO, bad)\n985\t+        self.assertIn(\"PROTECTED_MANIFEST_MISMATCH\", r.failure_codes)\n986\t+\n987\t+\n988\t+class ResumeTest(unittest.TestCase):\n989\t+    def setUp(self):\n990\t+        self.doc = json.loads(BASE_CP.read_text(encoding=\"utf-8\"))\n991\t+        self.dest = Path(tempfile.mkdtemp()) / \"resume-wt\"\n992\t+\n993\t+    def tearDown(self):\n994\t+        subprocess.run([\"git\", \"worktree\", \"remove\", \"--force\",\n995\t+                        str(self.dest)], cwd=REPO, capture_output=True)\n996\t+        shutil.rmtree(self.dest.parent, ignore_errors=True)\n997\t+\n998\t+    def test_resume_lands_on_exact_commit_and_source_unmoved(self):\n999\t+        before = subprocess.run(\n1000\t+            [\"git\", \"rev-parse\", \"origin/claude/new-session-ltyh1o\"],\n1001\t+            cwd=REPO, capture_output=True, text=True).stdout.strip()\n1002\t+        rec = LIN.resume_from_checkpoint(REPO, self.doc, self.dest)\n1003\t+        self.assertEqual(rec[\"head\"], self.doc[\"commit_sha\"])\n1004\t+        self.assertEqual(rec[\"tree\"], self.doc[\"tree_sha\"])\n1005\t+        self.assertTrue(rec[\"source_branch_unmodified\"])\n1006\t+        after = subprocess.run(\n1007\t+            [\"git\", \"rev-parse\", \"origin/claude/new-session-ltyh1o\"],\n1008\t+            cwd=REPO, capture_output=True, text=True).stdout.strip()\n1009\t+        self.assertEqual(before, after)\n1010\t+\n1011\t+    def test_resume_refused_on_bad_checkpoint(self):\n1012\t+        bad = _rebuild(self.doc, tree_sha=\"a\" * 40)\n1013\t+        with self.assertRaises(LIN.LineageError):\n1014\t+            LIN.resume_from_checkpoint(REPO, bad, self.dest)\n1015\t+        self.assertFalse(self.dest.exists())\n1016\t+\n1017\t+\n1018\t+if __name__ == \"__main__\":\n1019\t+    unittest.main()\n1020\tdiff --git a/.creator-zero/tests/topology_theory/test_revision_governance_v2.py b/.creator-zero/tests/topology_theory/test_revision_governance_v2.py\n1021\tnew file mode 100644\n1022\tindex 0000000..6dd9c58\n1023\t--- /dev/null\n1024\t+++ b/.creator-zero/tests/topology_theory/test_revision_governance_v2.py\n1025\t@@ -0,0 +1,236 @@\n1026\t+\"\"\"Revision engine v2, governance taxonomy v2, two-stage gate\n1027\t+(spec §20.6-20.7, NC9-NC14, NC17).\"\"\"\n1028\t+from __future__ import annotations\n1029\t+import json\n1030\t+import tempfile\n1031\t+import unittest\n1032\t+\n1033\t+import _bootstrap\n1034\t+from _bootstrap import CZROOT, TT\n1035\t+\n1036\t+G = TT.governance\n1037\t+TG = TT.theory_gate\n1038\t+\n1039\t+\n1040\t+def _theory():\n1041\t+    return TT.build_seed_theory()\n1042\t+\n1043\t+\n1044\t+def _ev(pid, kind, effect, i, run=\"primary\"):\n1045\t+    ctx = ({\"context_status\": \"OK\", \"admissibility_kind\": kind,\n1046\t+            \"latent_class\": \"X\"} if kind else\n1047\t+           {\"context_status\": \"UNKNOWN\"})\n1048\t+    return {\"principle_id\": pid, \"topology_id\": f\"H-t{i}-x\",\n1049\t+            \"prediction_id\": f\"H-t{i}-x-pr01\", \"effect\": effect,\n1050\t+            \"event_id\": f\"ev-{pid}-{i}\", \"trial_id\": f\"t{i}\", \"run\": run,\n1051\t+            \"context\": ctx}\n1052\t+\n1053\t+\n1054\t+def _mixed_contextual_events():\n1055\t+    events = []\n1056\t+    i = 0\n1057\t+    for _ in range(6):\n1058\t+        i += 1\n1059\t+        events.append(_ev(\"P-INDEPENDENCE\", \"CLEAN_ROOM_AUTHORSHIP\",\n1060\t+                          \"SUPPORT\", i))\n1061\t+    for eff in (\"SUPPORT\", \"SUPPORT\", \"FALSIFY\", \"FALSIFY\", \"FALSIFY\"):\n1062\t+        i += 1\n1063\t+        events.append(_ev(\"P-INDEPENDENCE\", \"NON_AUTHOR_SEARCH\", eff, i))\n1064\t+    for eff in (\"SUPPORT\", \"FALSIFY\", \"FALSIFY\", \"FALSIFY\"):\n1065\t+        i += 1\n1066\t+        events.append(_ev(\"P-INDEPENDENCE\", \"METHOD_DISJOINT_VERIFICATION\",\n1067\t+                          eff, i))\n1068\t+    for eff in (\"SUPPORT\", \"SUPPORT\", \"FALSIFY\", \"FALSIFY\"):\n1069\t+        i += 1\n1070\t+        events.append(_ev(\"P-INDEPENDENCE\", \"INDEPENDENT_DECOMPOSITION\",\n1071\t+                          eff, i))\n1072\t+    return events\n1073\t+\n1074\t+\n1075\t+class RevisionV2Test(unittest.TestCase):\n1076\t+    def test_old_specialize_behavior_preserved(self):\n1077\t+        theory = _theory()\n1078\t+        events = [\n1079\t+            {\"principle_id\": \"P-LOCALITY\", \"topology_id\": \"H-a-local\",\n1080\t+             \"prediction_id\": \"p1\", \"effect\": \"SUPPORT\", \"event_id\": \"e1\"},\n1081\t+            {\"principle_id\": \"P-LOCALITY\", \"topology_id\": \"H-a-local\",\n1082\t+             \"prediction_id\": \"p2\", \"effect\": \"FALSIFY\", \"event_id\": \"e2\"},\n1083\t+        ]\n1084\t+        rev = TT.propose_revision(theory, events)\n1085\t+        self.assertEqual(rev.type, \"SPECIALIZE\")\n1086\t+        self.assertEqual(rev.parents, [\"P-LOCALITY\"])\n1087\t+\n1088\t+    def test_contextual_mixed_evidence_produces_split(self):\n1089\t+        theory = _theory()\n1090\t+        doc = TT.propose_revision_v2(theory, _mixed_contextual_events())\n1091\t+        self.assertTrue(doc[\"split_trigger\"][\"eligible\"],\n1092\t+                        doc[\"split_trigger\"])\n1093\t+        self.assertEqual(doc[\"selected\"], \"SPLIT\", doc[\"scores\"])\n1094\t+        rev = TT.Revision.from_dict(doc[\"candidates\"][\"SPLIT\"])\n1095\t+        self.assertEqual(rev.parents, [\"P-INDEPENDENCE\"])\n1096\t+        ids = {c[\"id\"] for c in rev.candidate_principles}\n1097\t+        self.assertEqual(ids, {\"P-AUTHORSHIP-INDEPENDENCE\",\n1098\t+                               \"P-NONAUTHOR-SEARCH\",\n1099\t+                               \"P-INDEPENDENT-DECOMPOSITION\",\n1100\t+                               \"P-METHOD-DISJOINT-VERIFICATION\"})\n1101\t+        for c in rev.candidate_principles:\n1102\t+            self.assertEqual(c[\"parent_principles\"], [\"P-INDEPENDENCE\"])\n1103\t+            self.assertTrue(c[\"supporting_evidence\"])\n1104\t+            self.assertTrue(str(c.get(\"falsifier\", \"\")).strip())\n1105\t+        self.assertEqual(rev.status, \"CANDIDATE\")\n1106\t+        self.assertTrue(rev.context_partition)\n1107\t+\n1108\t+    def test_no_split_without_context(self):\n1109\t+        theory = _theory()\n1110\t+        events = [_ev(\"P-INDEPENDENCE\", None, \"SUPPORT\", 1),\n1111\t+                  _ev(\"P-INDEPENDENCE\", None, \"FALSIFY\", 2)]\n1112\t+        doc = TT.propose_revision_v2(theory, events)\n1113\t+        self.assertFalse(doc[\"split_trigger\"][\"eligible\"])\n1114\t+        self.assertNotIn(\"SPLIT\", doc[\"scores\"])\n1115\t+\n1116\t+    def test_no_change_supported_when_all_support(self):\n1117\t+        theory = _theory()\n1118\t+        events = [_ev(\"P-INDEPENDENCE\", \"CLEAN_ROOM_AUTHORSHIP\",\n1119\t+                      \"SUPPORT\", i) for i in range(1, 9)]\n1120\t+        doc = TT.propose_revision_v2(theory, events)\n1121\t+        self.assertEqual(doc[\"selected\"], \"no-change\")\n1122\t+\n1123\t+    def test_apply_split_marks_parent_revised_and_keeps_it_active(self):\n1124\t+        theory = _theory()\n1125\t+        doc = TT.propose_revision_v2(theory, _mixed_contextual_events())\n1126\t+        rev = TT.Revision.from_dict(doc[\"candidates\"][\"SPLIT\"])\n1127\t+        succ = TT.revise.apply_revision(theory, rev, \"sha256:predecessor\")\n1128\t+        self.assertEqual(succ.version, theory.version + 1)\n1129\t+        self.assertEqual(succ.status, \"CANDIDATE\")\n1130\t+        parent = succ.principle(\"P-INDEPENDENCE\")\n1131\t+        self.assertEqual(parent.status, \"REVISED\")\n1132\t+        self.assertTrue(parent.active)\n1133\t+        self.assertIsNotNone(succ.principle(\"P-NONAUTHOR-SEARCH\"))\n1134\t+\n1135\t+    def test_candidate_cannot_promote_directly(self):\n1136\t+        # NC13: no direct promotion without a Gate-issued PASS\n1137\t+        theory = _theory()\n1138\t+        doc = TT.propose_revision_v2(theory, _mixed_contextual_events())\n1139\t+        rev = TT.Revision.from_dict(doc[\"candidates\"][\"SPLIT\"])\n1140\t+        succ = TT.revise.apply_revision(theory, rev, \"sha256:x\")\n1141\t+        store = TT.TheoryStore(tempfile.mkdtemp())\n1142\t+        with self.assertRaises(TT.PromotionError):\n1143\t+            store.promote(succ, rev.to_dict())\n1144\t+        with self.assertRaises(TT.PromotionError):\n1145\t+            store.promote(succ, {\"check\": \"verifier\", \"status\": \"PASS\",\n1146\t+                                 \"detail\": {\"issued_by\": \"verifier\"}})\n1147\t+\n1148\t+    def test_replay_rejects_deprecating_split(self):\n1149\t+        # a bad revision that RETIRES the parent contradicts frozen history\n1150\t+        theory = _theory()\n1151\t+        rev = TT.Revision(\n1152\t+            revision_id=\"rev-bad\", type=\"DEPRECATE\",\n1153\t+            parents=[\"P-INDEPENDENCE\"], motivating_evidence=[\"x\"])\n1154\t+        succ = TT.revise.apply_revision(theory, rev, \"sha256:x\")\n1155\t+        res = TT.replay(succ)\n1156\t+        self.assertGreater(res.contradicted, 0)\n1157\t+        self.assertFalse(res.acceptable)\n1158\t+\n1159\t+    def test_split_survives_replay_including_e6_cases(self):\n1160\t+        theory = _theory()\n1161\t+        doc = TT.propose_revision_v2(theory, _mixed_contextual_events())\n1162\t+        rev = TT.Revision.from_dict(doc[\"candidates\"][\"SPLIT\"])\n1163\t+        succ = TT.revise.apply_revision(theory, rev, \"sha256:x\")\n1164\t+        cases = TT.load_replay_corpus()\n1165\t+        cases += TT.load_replay_corpus(\n1166\t+            CZROOT / \"topology-theory\" / \"replay-corpus-e6.json\")\n1167\t+        res = TT.replay(succ, cases, repo_root=CZROOT)\n1168\t+        self.assertEqual(res.contradicted, 0, res.to_dict())\n1169\t+        self.assertEqual(res.indeterminate, 0, res.to_dict())\n1170\t+\n1171\t+\n1172\t+class GovernanceV2Test(unittest.TestCase):\n1173\t+    def test_unauthorized_capability_tool_is_fatal(self):\n1174\t+        evs = G.classify_session_audit(\n1175\t+            {\"disallowed_tool_uses\": [{\"tool\": \"Bash\", \"id\": \"x\"}]}, \"s1\")\n1176\t+        self.assertEqual(evs[0][\"category\"], \"capability_violation\")\n1177\t+        self.assertTrue(evs[0][\"fatal\"])\n1178\t+\n1179\t+    def test_meta_tool_observation_is_not_capability_violation(self):\n1180\t+        # NC9/NC10\n1181\t+        evs = G.classify_session_audit(\n1182\t+            {\"disallowed_tool_uses\": [{\"tool\": \"ToolSearch\", \"id\": \"x\"},\n1183\t+                                      {\"tool\": \"ToolSearch\", \"id\": \"y\"}]},\n1184\t+            \"s1\")\n1185\t+        self.assertTrue(all(e[\"category\"] == \"meta_tool_observation\"\n1186\t+                            for e in evs))\n1187\t+        s = G.summarize(evs)\n1188\t+        self.assertEqual(s[\"capability_violations\"], 0)\n1189\t+        self.assertEqual(s[\"fatal_events\"], 0)\n1190\t+        self.assertEqual(s[\"meta_tool_observations\"], 2)\n1191\t+        self.assertEqual(s[\"observed_governance_risk\"], 0.0)\n1192\t+\n1193\t+    def test_hidden_child_is_fatal(self):\n1194\t+        # NC11\n1195\t+        evs = G.classify_session_audit(\n1196\t+            {\"spawn_capable_tool_uses\": [{\"tool\": \"Agent\", \"id\": \"x\"}]},\n1197\t+            \"s1\")\n1198\t+        self.assertEqual(evs[0][\"code\"], \"HIDDEN_CHILD_RISK\")\n1199\t+        self.assertTrue(evs[0][\"fatal\"])\n1200\t+\n1201\t+    def test_invalid_ledger_label_is_instrumentation(self):\n1202\t+        evs = G.classify_ledger_labels([\"unknown label 'proposeX'\"], \"s1\")\n1203\t+        self.assertEqual(evs[0][\"category\"], \"instrumentation_violation\")\n1204\t+        self.assertFalse(evs[0][\"fatal\"])\n1205\t+        s = G.summarize(evs)\n1206\t+        self.assertEqual(s[\"observed_governance_risk\"], 0.1)\n1207\t+\n1208\t+    def test_e6_mutation_is_protected_law_failure(self):\n1209\t+        # NC14\n1210\t+        res = TT.self_modify.check_protected_laws(\n1211\t+            [\".creator-zero/experiment-6/report.md\"])\n1212\t+        self.assertEqual(res[\"status\"], \"FAIL\")\n1213\t+        res = TT.self_modify.check_protected_laws(\n1214\t+            [\".creator-zero/state/experiment-6.json\"])\n1215\t+        self.assertEqual(res[\"status\"], \"FAIL\")\n1216\t+        res = TT.self_modify.check_protected_laws(\n1217\t+            [\".creator-zero/experiment-7/report.md\"])\n1218\t+        self.assertEqual(res[\"status\"], \"PASS\")\n1219\t+\n1220\t+\n1221\t+class TwoStageGateTest(unittest.TestCase):\n1222\t+    def _eval_inputs(self, **over):\n1223\t+        base = {k: {\"status\": \"PASS\"} for k in TG.REQUIRED_EVAL_INPUTS}\n1224\t+        base.update(over)\n1225\t+        return base\n1226\t+\n1227\t+    def test_stage1_authorizes_but_cannot_promote(self):\n1228\t+        auth = TG.evaluation_authorization(self._eval_inputs())\n1229\t+        self.assertEqual(auth[\"status\"], \"PASS\")\n1230\t+        self.assertNotEqual(auth[\"check\"], \"gate\")\n1231\t+        store = TT.TheoryStore(tempfile.mkdtemp())\n1232\t+        succ = _theory()\n1233\t+        with self.assertRaises(TT.PromotionError):\n1234\t+            store.promote(succ, auth)          # NC17\n1235\t+\n1236\t+    def test_stage1_fails_on_missing_input(self):\n1237\t+        inputs = self._eval_inputs()\n1238\t+        del inputs[\"independent_verifier\"]\n1239\t+        auth = TG.evaluation_authorization(inputs)\n1240\t+        self.assertEqual(auth[\"status\"], \"FAIL\")\n1241\t+\n1242\t+    def test_theory_gate_requires_heldout_and_paired(self):\n1243\t+        inputs = self._eval_inputs()\n1244\t+        inputs[\"evaluation_authorization\"] = \\\n1245\t+            TG.evaluation_authorization(self._eval_inputs())\n1246\t+        gate = TG.theory_gate(inputs)          # missing held-out inputs\n1247\t+        self.assertEqual(gate[\"status\"], \"FAIL\")\n1248\t+        inputs.update({\n1249\t+            \"heldout_thresholds\": {\"status\": \"PASS\"},\n1250\t+            \"paired_improvement\": {\"status\": \"PASS\"},\n1251\t+            \"governance\": {\"status\": \"PASS\"},\n1252\t+            \"historical_immutability\": {\"status\": \"PASS\"},\n1253\t+        })\n1254\t+        gate = TG.theory_gate(inputs)\n1255\t+        self.assertEqual(gate[\"status\"], \"PASS\")\n1256\t+        self.assertEqual(gate[\"check\"], \"gate\")\n1257\t+        self.assertEqual(gate[\"detail\"][\"issued_by\"], \"gate\")\n1258\t+\n1259\t+\n1260\t+if __name__ == \"__main__\":\n1261\t+    unittest.main()\n1262\tdiff --git a/.creator-zero/topology-theory/__init__.py b/.creator-zero/topology-theory/__init__.py\n1263\tindex 17234b1..c4364a9 100644\n1264\t--- a/.creator-zero/topology-theory/__init__.py\n1265\t+++ b/.creator-zero/topology-theory/__init__.py\n1266\t@@ -39,6 +39,14 @@ from .falsify import falsify, principle_evidence_events\n1267\t from .revise import propose_revision\n1268\t from .replay import replay, load_replay_corpus\n1269\t from . import self_modify\n1270\t+from . import admissibility\n1271\t+from . import ingest\n1272\t+from . import governance\n1273\t+from . import theory_gate\n1274\t+from .generate2 import generate_candidates_v2, family_of_v2, FAMILIES_V2\n1275\t+from .predict2 import freeze_predictions_v2\n1276\t+from .revise2 import (propose_revision_v2, context_stats, split_trigger,\n1277\t+                      explanation_scores)\n1278\t \n1279\t __all__ = [\n1280\t     \"Principle\", \"PrincipleEvidence\", \"Prediction\", \"TopologyHypothesis\",\n1281\t@@ -53,6 +61,11 @@ __all__ = [\n1282\t     \"evaluate_topology\", \"PredictionIntegrityError\",\n1283\t     \"falsify\", \"principle_evidence_events\", \"propose_revision\",\n1284\t     \"replay\", \"load_replay_corpus\", \"self_modify\",\n1285\t+    \"admissibility\", \"ingest\", \"governance\", \"theory_gate\",\n1286\t+    \"generate_candidates_v2\", \"family_of_v2\", \"FAMILIES_V2\",\n1287\t+    \"freeze_predictions_v2\",\n1288\t+    \"propose_revision_v2\", \"context_stats\", \"split_trigger\",\n1289\t+    \"explanation_scores\",\n1290\t ]\n1291\t \n1292\t __version__ = \"0.1\"\n1293\tdiff --git a/.creator-zero/topology-theory/admissibility.py b/.creator-zero/topology-theory/admissibility.py\n1294\tnew file mode 100644\n1295\tindex 0000000..110e752\n1296\t--- /dev/null\n1297\t+++ b/.creator-zero/topology-theory/admissibility.py\n1298\t@@ -0,0 +1,305 @@\n1299\t+\"\"\"Typed evidence admissibility: independence vectors, roles, requirements.\n1300\t+\n1301\t+    I = (I_A, I_S, I_D, I_M) ∈ {0,1}^4\n1302\t+\n1303\t+    Adm(p, r) = VectorSatisfies(p,r) ∧ RoleCompatible(p,r)\n1304\t+                ∧ SourceCompatible(p,r) ∧ MethodCompatible(p,r)\n1305\t+\n1306\t+No coordinate entails another; canonical roles are epistemic relations, not\n1307\t+node placements, and are never aliases. Vector coverage is necessary but not\n1308\t+sufficient: a correct answer from the wrong role is inadmissible for the\n1309\t+targeted distinction (the Experiment 6 'right shape, wrong role' failure).\n1310\t+\n1311\t+Deterministic utility-v2 component computation lives here too: saturating\n1312\t+epistemic value (admissible coverage; extra isolation adds nothing),\n1313\t+marginal-coverage redundancy, and structural governance risk. The macro\n1314\t+utility form and its frozen weights are unchanged (utility.py).\n1315\t+\"\"\"\n1316\t+from __future__ import annotations\n1317\t+from dataclasses import dataclass, field, asdict\n1318\t+from typing import Any, Optional\n1319\t+\n1320\t+from .model import ModelValidationError\n1321\t+\n1322\t+# ---- kinds and roles -------------------------------------------------------\n1323\t+\n1324\t+KINDS = (\"LOCAL\", \"CLEAN_ROOM_AUTHORSHIP\", \"NON_AUTHOR_SEARCH\",\n1325\t+         \"INDEPENDENT_DECOMPOSITION\", \"METHOD_DISJOINT_VERIFICATION\")\n1326\t+\n1327\t+ROLES = (\"local_author\", \"clean_room_author\", \"non_author_examiner\",\n1328\t+         \"independent_decomposer\", \"method_disjoint_verifier\")\n1329\t+\n1330\t+# role -> provided independence vector (I_A, I_S, I_D, I_M); no entailment\n1331\t+ROLE_VECTOR = {\n1332\t+    \"local_author\": (0, 0, 0, 0),\n1333\t+    \"clean_room_author\": (1, 0, 0, 0),\n1334\t+    \"non_author_examiner\": (0, 1, 0, 0),\n1335\t+    \"independent_decomposer\": (0, 0, 1, 0),\n1336\t+    \"method_disjoint_verifier\": (0, 0, 0, 1),\n1337\t+}\n1338\t+\n1339\t+# kind -> (required vector, allowed roles)\n1340\t+KIND_REQUIREMENT = {\n1341\t+    \"LOCAL\": ((0, 0, 0, 0), (\"local_author\",)),\n1342\t+    \"CLEAN_ROOM_AUTHORSHIP\": ((1, 0, 0, 0), (\"clean_room_author\",)),\n1343\t+    \"NON_AUTHOR_SEARCH\": ((0, 1, 0, 0), (\"non_author_examiner\",)),\n1344\t+    \"INDEPENDENT_DECOMPOSITION\": ((0, 0, 1, 0), (\"independent_decomposer\",)),\n1345\t+    \"METHOD_DISJOINT_VERIFICATION\": ((0, 0, 0, 1),\n1346\t+                                     (\"method_disjoint_verifier\",)),\n1347\t+}\n1348\t+\n1349\t+# S1-inferred typed feature -> required admissibility kind\n1350\t+FEATURE_TO_KIND = {\n1351\t+    \"requires_clean_room_authorship\": \"CLEAN_ROOM_AUTHORSHIP\",\n1352\t+    \"requires_nonauthor_search\": \"NON_AUTHOR_SEARCH\",\n1353\t+    \"requires_independent_decomposition\": \"INDEPENDENT_DECOMPOSITION\",\n1354\t+    \"requires_method_disjoint_verification\": \"METHOD_DISJOINT_VERIFICATION\",\n1355\t+}\n1356\t+TYPED_FEATURES = tuple(sorted(FEATURE_TO_KIND))\n1357\t+\n1358\t+# frozen E6 vocabulary -> canonical roles (enrichment/scoring joins)\n1359\t+E6_ROLE_MAP = {\n1360\t+    \"clean_room_implementer\": \"clean_room_author\",\n1361\t+    \"adversarial_searcher\": \"non_author_examiner\",\n1362\t+    \"independent_decomposer\": \"independent_decomposer\",\n1363\t+    \"independent_verifier\": \"method_disjoint_verifier\",\n1364\t+    \"examiner_session\": \"non_author_examiner\",\n1365\t+    \"none\": \"local_author\",\n1366\t+}\n1367\t+\n1368\t+# frozen E6 latent class -> admissibility kind\n1369\t+E6_CLASS_TO_KIND = {\n1370\t+    \"LOCAL\": \"LOCAL\",\n1371\t+    \"ISOLATION\": \"CLEAN_ROOM_AUTHORSHIP\",\n1372\t+    \"COUNTEREXAMPLE\": \"NON_AUTHOR_SEARCH\",\n1373\t+    \"ALTERNATIVE_DECOMPOSITION\": \"INDEPENDENT_DECOMPOSITION\",\n1374\t+    \"SPECIALIZED_VERIFICATION\": \"METHOD_DISJOINT_VERIFICATION\",\n1375\t+}\n1376\t+\n1377\t+\n1378\t+@dataclass(frozen=True)\n1379\t+class IndependenceVector:\n1380\t+    i_a: int = 0\n1381\t+    i_s: int = 0\n1382\t+    i_d: int = 0\n1383\t+    i_m: int = 0\n1384\t+\n1385\t+    def __post_init__(self):\n1386\t+        for k in (\"i_a\", \"i_s\", \"i_d\", \"i_m\"):\n1387\t+            if getattr(self, k) not in (0, 1):\n1388\t+                raise ModelValidationError(\n1389\t+                    f\"independence coordinate {k} must be 0 or 1\")\n1390\t+\n1391\t+    def as_tuple(self) -> tuple[int, int, int, int]:\n1392\t+        return (self.i_a, self.i_s, self.i_d, self.i_m)\n1393\t+\n1394\t+    def dominates(self, other: \"IndependenceVector\") -> bool:\n1395\t+        \"\"\"∀k: self.I_k >= other.I_k (VectorSatisfies).\"\"\"\n1396\t+        return all(a >= b for a, b in zip(self.as_tuple(), other.as_tuple()))\n1397\t+\n1398\t+    @classmethod\n1399\t+    def of(cls, t) -> \"IndependenceVector\":\n1400\t+        if isinstance(t, IndependenceVector):\n1401\t+            return t\n1402\t+        return cls(*[int(x) for x in t])\n1403\t+\n1404\t+\n1405\t+@dataclass(frozen=True)\n1406\t+class EvidenceRequirement:\n1407\t+    requirement_id: str\n1408\t+    distinction_id: str\n1409\t+    kind: str\n1410\t+    independence: IndependenceVector\n1411\t+    allowed_roles: tuple[str, ...]\n1412\t+    prohibited_sources: tuple[str, ...] = ()\n1413\t+    primary_method_family: str = \"\"     # nonempty => method-disjointness bind\n1414\t+\n1415\t+    def __post_init__(self):\n1416\t+        if self.kind not in KINDS:\n1417\t+            raise ModelValidationError(f\"unknown admissibility kind \"\n1418\t+                                       f\"{self.kind!r}\")\n1419\t+        bad = [r for r in self.allowed_roles if r not in ROLES]\n1420\t+        if bad:\n1421\t+            raise ModelValidationError(f\"unknown roles {bad}\")\n1422\t+\n1423\t+    def to_dict(self) -> dict[str, Any]:\n1424\t+        d = asdict(self)\n1425\t+        d[\"independence\"] = list(self.independence.as_tuple())\n1426\t+        d[\"allowed_roles\"] = list(self.allowed_roles)\n1427\t+        d[\"prohibited_sources\"] = list(self.prohibited_sources)\n1428\t+        return d\n1429\t+\n1430\t+\n1431\t+@dataclass(frozen=True)\n1432\t+class EvidenceProvision:\n1433\t+    node_id: str\n1434\t+    role: str\n1435\t+    independence: IndependenceVector\n1436\t+    provenance_refs: tuple[str, ...] = ()\n1437\t+    method_family: str = \"\"\n1438\t+    source: str = \"\"                    # provenance source tag\n1439\t+\n1440\t+    def __post_init__(self):\n1441\t+        if self.role not in ROLES:\n1442\t+            raise ModelValidationError(f\"unknown canonical role \"\n1443\t+                                       f\"{self.role!r}\")\n1444\t+\n1445\t+    def to_dict(self) -> dict[str, Any]:\n1446\t+        d = asdict(self)\n1447\t+        d[\"independence\"] = list(self.independence.as_tuple())\n1448\t+        d[\"provenance_refs\"] = list(self.provenance_refs)\n1449\t+        return d\n1450\t+\n1451\t+\n1452\t+def provision_for_role(node_id: str, role: str, *, method_family: str = \"\",\n1453\t+                       source: str = \"\") -> EvidenceProvision:\n1454\t+    return EvidenceProvision(\n1455\t+        node_id=node_id, role=role,\n1456\t+        independence=IndependenceVector.of(ROLE_VECTOR[role]),\n1457\t+        method_family=method_family, source=source)\n1458\t+\n1459\t+\n1460\t+def requirement_for_distinction(d: dict[str, Any],\n1461\t+                                primary_method_family: str = \"\",\n1462\t+                                ) -> EvidenceRequirement:\n1463\t+    \"\"\"Deterministic requirement from a distinction's typed features.\n1464\t+\n1465\t+    Exactly one typed feature may be set; none => LOCAL. More than one is a\n1466\t+    typed-schema violation (bank tasks carry a single latent kind).\"\"\"\n1467\t+    feats = d.get(\"features\", {})\n1468\t+    kinds = sorted(FEATURE_TO_KIND[f] for f in TYPED_FEATURES\n1469\t+                   if bool(feats.get(f, False)))\n1470\t+    if len(kinds) > 1:\n1471\t+        raise ModelValidationError(\n1472\t+            f\"distinction {d.get('id')!r} sets multiple typed independence \"\n1473\t+            f\"features {kinds}; requirements are single-kind\")\n1474\t+    kind = kinds[0] if kinds else \"LOCAL\"\n1475\t+    vec, roles = KIND_REQUIREMENT[kind]\n1476\t+    return EvidenceRequirement(\n1477\t+        requirement_id=f\"req-{d['id']}\",\n1478\t+        distinction_id=d[\"id\"],\n1479\t+        kind=kind,\n1480\t+        independence=IndependenceVector.of(vec),\n1481\t+        allowed_roles=roles,\n1482\t+        primary_method_family=(primary_method_family\n1483\t+                               if kind == \"METHOD_DISJOINT_VERIFICATION\"\n1484\t+                               else \"\"),\n1485\t+    )\n1486\t+\n1487\t+\n1488\t+# ---- the admissibility equation -------------------------------------------\n1489\t+\n1490\t+def admissible(p: EvidenceProvision, r: EvidenceRequirement,\n1491\t+               ) -> tuple[bool, dict[str, bool]]:\n1492\t+    clauses = {\n1493\t+        \"vector_satisfies\": p.independence.dominates(r.independence),\n1494\t+        \"role_compatible\": p.role in r.allowed_roles,\n1495\t+        \"source_compatible\": (not p.source\n1496\t+                              or p.source not in r.prohibited_sources),\n1497\t+        \"method_compatible\": (not r.primary_method_family\n1498\t+                              or (bool(p.method_family)\n1499\t+                                  and p.method_family\n1500\t+                                  != r.primary_method_family)),\n1501\t+    }\n1502\t+    return all(clauses.values()), clauses\n1503\t+\n1504\t+\n1505\t+def topology_admissible(provisions: list[EvidenceProvision],\n1506\t+                        requirements: list[EvidenceRequirement],\n1507\t+                        ) -> dict[str, Any]:\n1508\t+    \"\"\"Valid_Adm(H,Q): every requirement has >=1 admissible provision.\"\"\"\n1509\t+    per_req: dict[str, Any] = {}\n1510\t+    ok_all = True\n1511\t+    for r in requirements:\n1512\t+        winners = []\n1513\t+        for p in provisions:\n1514\t+            ok, clauses = admissible(p, r)\n1515\t+            if ok:\n1516\t+                winners.append(p.node_id)\n1517\t+        per_req[r.requirement_id] = {\n1518\t+            \"kind\": r.kind, \"distinction_id\": r.distinction_id,\n1519\t+            \"admissible_provisions\": winners, \"admissible\": bool(winners)}\n1520\t+        ok_all &= bool(winners)\n1521\t+    return {\"admissible\": ok_all, \"per_requirement\": per_req}\n1522\t+\n1523\t+\n1524\t+def marginal_coverage(provisions: list[EvidenceProvision],\n1525\t+                      requirements: list[EvidenceRequirement],\n1526\t+                      ) -> dict[str, list[str]]:\n1527\t+    \"\"\"Requirements each provision covers beyond all earlier provisions\n1528\t+    (declared order). A provision with an empty list adds no admissible\n1529\t+    coverage: MarginalCoverage(p_k | p_1..p_{k-1}) = 0.\"\"\"\n1530\t+    covered: set[str] = set()\n1531\t+    out: dict[str, list[str]] = {}\n1532\t+    for p in provisions:\n1533\t+        adds = []\n1534\t+        for r in requirements:\n1535\t+            if r.requirement_id in covered:\n1536\t+                continue\n1537\t+            if admissible(p, r)[0]:\n1538\t+                adds.append(r.requirement_id)\n1539\t+        covered.update(adds)\n1540\t+        out[p.node_id] = sorted(adds)\n1541\t+    return out\n1542\t+\n1543\t+\n1544\t+# ---- deterministic utility-v2 components ----------------------------------\n1545\t+\n1546\t+def predicted_components(provisions: list[EvidenceProvision],\n1547\t+                         requirements: list[EvidenceRequirement],\n1548\t+                         value_by_distinction: dict[str, float],\n1549\t+                         *, model_sessions: int, child_sessions: int,\n1550\t+                         cost_denominator: int = 8) -> dict[str, float]:\n1551\t+    \"\"\"Saturating ΔE + marginal-coverage redundancy + structural governance.\n1552\t+\n1553\t+        ΔE_hat = Σ_q v_q·Adm(H,q) / Σ_q v_q          (0 if Σ v_q = 0)\n1554\t+        C      = (model_sessions + child_sessions) / 8\n1555\t+        R      = |provisions with zero marginal coverage| / |provisions|\n1556\t+        G      = min(1, 0.05·(model_sessions−1) + 0.10·child_sessions)\n1557\t+\n1558\t+    Once a requirement is admissibly covered its value saturates: a second,\n1559\t+    more isolated provider adds redundancy, never value (b(H,q)=0).\"\"\"\n1560\t+    adm = topology_admissible(provisions, requirements)\n1561\t+    tot = 0.0\n1562\t+    got = 0.0\n1563\t+    for r in requirements:\n1564\t+        v = float(value_by_distinction.get(r.distinction_id, 0.0))\n1565\t+        if not (0.0 <= v <= 1.0):\n1566\t+            raise ModelValidationError(\n1567\t+                f\"value estimate for {r.distinction_id} outside [0,1]: {v}\")\n1568\t+        tot += v\n1569\t+        if adm[\"per_requirement\"][r.requirement_id][\"admissible\"]:\n1570\t+            got += v\n1571\t+    delta_e = round(got / tot, 4) if tot > 0 else 0.0\n1572\t+    mc = marginal_coverage(provisions, requirements)\n1573\t+    n_prov = max(1, len(provisions))\n1574\t+    redundant = sum(1 for adds in mc.values() if not adds)\n1575\t+    redundancy = round(redundant / n_prov, 4)\n1576\t+    governance = round(min(1.0, 0.05 * max(0, model_sessions - 1)\n1577\t+                           + 0.10 * child_sessions), 4)\n1578\t+    cost = round((model_sessions + child_sessions) / cost_denominator, 4)\n1579\t+    return {\"delta_e\": delta_e, \"cost\": cost, \"redundancy\": redundancy,\n1580\t+            \"governance_risk\": governance}\n1581\t+\n1582\t+\n1583\t+# ---- serialization helpers for embedded specs -----------------------------\n1584\t+\n1585\t+def provisions_from_spec(spec: dict[str, Any]) -> list[EvidenceProvision]:\n1586\t+    out = []\n1587\t+    for p in spec.get(\"evidence_provisions\", []):\n1588\t+        out.append(EvidenceProvision(\n1589\t+            node_id=p[\"node_id\"], role=p[\"role\"],\n1590\t+            independence=IndependenceVector.of(p[\"independence\"]),\n1591\t+            provenance_refs=tuple(p.get(\"provenance_refs\", ())),\n1592\t+            method_family=p.get(\"method_family\", \"\"),\n1593\t+            source=p.get(\"source\", \"\")))\n1594\t+    return out\n1595\t+\n1596\t+\n1597\t+def canonical_role(e6_role: str, *, examiner: bool = False) -> str:\n1598\t+    \"\"\"Map frozen E6 role vocabulary to canonical roles.\"\"\"\n1599\t+    if examiner:\n1600\t+        return \"non_author_examiner\"\n1601\t+    if e6_role in ROLES:\n1602\t+        return e6_role\n1603\t+    return E6_ROLE_MAP.get(e6_role or \"none\", \"local_author\")\n1604\tdiff --git a/.creator-zero/topology-theory/generate2.py b/.creator-zero/topology-theory/generate2.py\n1605\tnew file mode 100644\n1606\tindex 0000000..a4176bc\n1607\t--- /dev/null\n1608\t+++ b/.creator-zero/topology-theory/generate2.py\n1609\t@@ -0,0 +1,217 @@\n1610\t+\"\"\"Topology grammar v2: typed-relation candidate generation.\n1611\t+\n1612\t+Extends the closed v1 template grammar just enough to express typed\n1613\t+epistemic relations. Families (closed, frozen):\n1614\t+\n1615\t+    local                            1 session   role local_author\n1616\t+    local-independent-examiner       2 sessions  + non_author_examiner\n1617\t+    local-method-disjoint-verifier   2 sessions  + method_disjoint_verifier\n1618\t+    isolated-clean-room-author       2 + child   + clean_room_author\n1619\t+    isolated-decomposer              2 + child   + independent_decomposer\n1620\t+    isolated-searcher                2 + child   + non_author_examiner\n1621\t+                                     (admissible for search; dominated on\n1622\t+                                      cost — exists so economics can prove\n1623\t+                                      the examiner wins)\n1624\t+    branching                        2 + child   deferred decision; child\n1625\t+                                     role bound to the required kind\n1626\t+\n1627\t+Every spec embeds `evidence_provisions` [(node, canonical role, vector)].\n1628\t+Admissibility filtering happens downstream (admissibility.topology_admissible)\n1629\t+before economics; predicted values here are fully deterministic\n1630\t+(admissibility-saturating ΔE, marginal-coverage redundancy, structural\n1631\t+governance risk, call-structure cost). There is no model path around the\n1632\t+grammar.\n1633\t+\"\"\"\n1634\t+from __future__ import annotations\n1635\t+from typing import Any\n1636\t+\n1637\t+from .admissibility import (FEATURE_TO_KIND, KIND_REQUIREMENT, TYPED_FEATURES,\n1638\t+                            provision_for_role, provisions_from_spec,\n1639\t+                            requirement_for_distinction, topology_admissible,\n1640\t+                            predicted_components)\n1641\t+from .generate import (_branching_spec, _child_spec, _local_iv_spec,\n1642\t+                       _local_spec, _contract_allows_create)\n1643\t+from .model import ApplicabilityResult, TopologyHypothesis\n1644\t+from .serialization import object_artifact_id\n1645\t+\n1646\t+FAMILIES_V2 = (\"local\", \"local-independent-examiner\",\n1647\t+               \"local-method-disjoint-verifier\", \"isolated-clean-room-author\",\n1648\t+               \"isolated-decomposer\", \"isolated-searcher\", \"branching\")\n1649\t+\n1650\t+FAMILY_CALLS_V2 = {\n1651\t+    \"local\": (1, 0),\n1652\t+    \"local-independent-examiner\": (2, 0),\n1653\t+    \"local-method-disjoint-verifier\": (2, 0),\n1654\t+    \"isolated-clean-room-author\": (2, 1),\n1655\t+    \"isolated-decomposer\": (2, 1),\n1656\t+    \"isolated-searcher\": (2, 1),\n1657\t+    \"branching\": (2, 1),\n1658\t+}\n1659\t+\n1660\t+# required kind -> (minimal family, alternative family, child role)\n1661\t+KIND_FAMILIES = {\n1662\t+    \"NON_AUTHOR_SEARCH\": (\"local-independent-examiner\", \"isolated-searcher\",\n1663\t+                          \"non_author_examiner\"),\n1664\t+    \"CLEAN_ROOM_AUTHORSHIP\": (\"isolated-clean-room-author\", \"branching\",\n1665\t+                              \"clean_room_author\"),\n1666\t+    \"INDEPENDENT_DECOMPOSITION\": (\"isolated-decomposer\", \"branching\",\n1667\t+                                  \"independent_decomposer\"),\n1668\t+    \"METHOD_DISJOINT_VERIFICATION\": (\"local-method-disjoint-verifier\",\n1669\t+                                     \"branching\",\n1670\t+                                     \"method_disjoint_verifier\"),\n1671\t+}\n1672\t+\n1673\t+\n1674\t+def family_of_v2(topology_id: str) -> str:\n1675\t+    for fam in (\"local-independent-examiner\", \"local-method-disjoint-verifier\",\n1676\t+                \"isolated-clean-room-author\", \"isolated-decomposer\",\n1677\t+                \"isolated-searcher\", \"branching\", \"local\"):\n1678\t+        if topology_id.endswith(fam):\n1679\t+            return fam\n1680\t+    raise ValueError(f\"cannot derive v2 family from {topology_id!r}\")\n1681\t+\n1682\t+\n1683\t+def _spec_for(family: str, task_id: str, contract: dict[str, Any],\n1684\t+              child_role: str) -> dict[str, Any]:\n1685\t+    if family == \"local\":\n1686\t+        spec = _local_spec(task_id, contract)\n1687\t+        provisions = [(\"resolve-local\", \"local_author\", \"\")]\n1688\t+    elif family == \"local-independent-examiner\":\n1689\t+        spec = _local_iv_spec(task_id, contract)\n1690\t+        spec[\"goal\"] = (f\"Local resolution of {task_id} plus an \"\n1691\t+                        \"information-only independent examiner pass\")\n1692\t+        provisions = [(\"resolve-local\", \"local_author\", \"\"),\n1693\t+                      (\"verify-independent\", \"non_author_examiner\", \"\")]\n1694\t+    elif family == \"local-method-disjoint-verifier\":\n1695\t+        spec = _local_iv_spec(task_id, contract)\n1696\t+        spec[\"goal\"] = (f\"Local resolution of {task_id} plus re-derivation \"\n1697\t+                        \"by a verifier bound to a disjoint method family\")\n1698\t+        for n in spec[\"nodes\"]:\n1699\t+            if n[\"id\"] == \"verify-independent\":"}]},"parent_tool_use_id":null,"session_id":"371b7f47-bc11-46c7-971a-b334740ebdc3","uuid":"39eeba33-c41a-4a44-856a-11bc8f32eea5","timestamp":"2026-08-09T19:43:49.027Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-0/-home-user-creator-0/87cd2a2d-a4f9-585b-836f-2648df7a6284/scratchpad/e7/verifier-infra-ws/candidate-patch.diff","content":"+        self.tmp = tempfile.mkdtemp()\n+        self.store = TT.TheoryStore(self.tmp)\n+        self.pin = PINS[\"e6_evidence_source\"]\n+\n+    def test_source_pin_verifies(self):\n+        r = TT.ingest.verify_source_pin(E6_SOURCE, self.pin)\n+        self.assertEqual(r[\"status\"], \"PASS\", r)\n+\n+    def test_mutated_source_fails_pin(self):\n+        # NC4\n+        mutated = Path(self.tmp) / \"mutated.jsonl\"\n+        text = E6_SOURCE.read_text(encoding=\"utf-8\")\n+        mutated.write_text(text.replace(\"SUPPORT\", \"FALSIFY\", 1),\n+                           encoding=\"utf-8\")\n+        r = TT.ingest.verify_source_pin(mutated, self.pin)\n+        self.assertEqual(r[\"status\"], \"FAIL\")\n+        self.assertEqual(r[\"failure_code\"], \"EVIDENCE_SOURCE_MISMATCH\")\n+\n+    def test_enrichment_joins_context_and_preserves_provenance(self):\n+        raw = TT.ingest.load_source_events(E6_SOURCE)\n+        enriched = TT.ingest.enrich_e6_events(\n+            raw, _labels(), source_commit=\"bd0cf91\", source_path=\"x\",\n+            source_artifact_id=\"sha256:src\")\n+        self.assertEqual(len(enriched), 264)\n+        ok = [e for e in enriched\n+              if e[\"context\"].get(\"context_status\") == \"OK\"]\n+        self.assertEqual(len(ok), 264)\n+        kinds = {e[\"context\"][\"admissibility_kind\"] for e in ok}\n+        self.assertLessEqual(\n+            kinds, {\"LOCAL\", \"CLEAN_ROOM_AUTHORSHIP\", \"NON_AUTHOR_SEARCH\",\n+                    \"INDEPENDENT_DECOMPOSITION\",\n+                    \"METHOD_DISJOINT_VERIFICATION\"})\n+        for e in enriched[:10]:\n+            self.assertTrue(e[\"trial_id\"])\n+            self.assertIn(e[\"run\"], (\"primary\", \"shadow\"))\n+\n+    def test_idempotent_import_and_conflict(self):\n+        raw = TT.ingest.load_source_events(E6_SOURCE)[:6]\n+        enriched = TT.ingest.enrich_e6_events(\n+            raw, _labels(), source_commit=\"c\", source_path=\"p\",\n+            source_artifact_id=\"sha256:s\")\n+        m1 = TT.ingest.ingest_evidence(self.store, enriched)\n+        self.assertEqual(m1[\"imported\"], 6)\n+        self.assertTrue(m1[\"append_only_intact\"])\n+        m2 = TT.ingest.ingest_evidence(self.store, enriched)\n+        self.assertEqual(m2[\"imported\"], 0)\n+        self.assertEqual(m2[\"skipped_identical\"], 6)\n+        # NC5: same id, different content\n+        bad = dict(enriched[0])\n+        bad[\"effect\"] = \"FALSIFY\" if bad[\"effect\"] != \"FALSIFY\" else \"SUPPORT\"\n+        with self.assertRaises(TT.ingest.EvidenceImportError):\n+            TT.ingest.ingest_evidence(self.store, [bad])\n+        chain = self.store.verify_append_only()\n+        self.assertTrue(chain[\"append_only_intact\"])\n+        self.assertEqual(chain[\"log_length\"], 6)\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()\ndiff --git a/.creator-zero/tests/topology_theory/test_lineage.py b/.creator-zero/tests/topology_theory/test_lineage.py\nnew file mode 100644\nindex 0000000..dc6a4a1\n--- /dev/null\n+++ b/.creator-zero/tests/topology_theory/test_lineage.py\n@@ -0,0 +1,155 @@\n+\"\"\"Lineage subsystem: checkpoint create/verify/resume (spec §20.1).\"\"\"\n+from __future__ import annotations\n+import json\n+import shutil\n+import subprocess\n+import tempfile\n+import unittest\n+from pathlib import Path\n+\n+import _bootstrap\n+from _bootstrap import CZROOT, REPO\n+\n+import importlib.util\n+import sys\n+\n+\n+def _load_lineage():\n+    if \"lineage\" in sys.modules:\n+        return sys.modules[\"lineage\"]\n+    spec = importlib.util.spec_from_file_location(\n+        \"lineage\", CZROOT / \"lineage\" / \"__init__.py\",\n+        submodule_search_locations=[str(CZROOT / \"lineage\")])\n+    mod = importlib.util.module_from_spec(spec)\n+    sys.modules[\"lineage\"] = mod\n+    spec.loader.exec_module(mod)\n+    return mod\n+\n+\n+LIN = _load_lineage()\n+BASE_CP = CZROOT / \"experiment-7\" / \"base-checkpoint.json\"\n+\n+\n+def _rebuild(doc: dict, **edits) -> dict:\n+    from lineage.model import checkpoint_id_for\n+    d = {k: v for k, v in doc.items() if k != \"checkpoint_id\"}\n+    d.update(edits)\n+    d[\"checkpoint_id\"] = checkpoint_id_for(d)\n+    return d\n+\n+\n+class CheckpointModelTest(unittest.TestCase):\n+    def setUp(self):\n+        self.doc = json.loads(BASE_CP.read_text(encoding=\"utf-8\"))\n+\n+    def test_base_checkpoint_parses_and_id_is_content_bound(self):\n+        cp = LIN.LineageCheckpoint.from_dict(self.doc)\n+        self.assertEqual(cp.commit_sha,\n+                         \"bd0cf91e455393d3d601070e5022c565d9ed9ed1\")\n+        self.assertEqual(cp.theory_version, 1)\n+\n+    def test_edited_body_without_new_id_is_rejected(self):\n+        bad = dict(self.doc)\n+        bad[\"experiment_result\"] = \"SOMETHING_ELSE\"\n+        with self.assertRaises(LIN.LineageError):\n+            LIN.LineageCheckpoint.from_dict(bad)\n+\n+    def test_unknown_fields_rejected(self):\n+        bad = _rebuild(self.doc)\n+        bad[\"surprise\"] = 1\n+        with self.assertRaises(LIN.LineageError):\n+            LIN.LineageCheckpoint.from_dict(bad)\n+\n+    def test_deterministic_serialization(self):\n+        cp = LIN.LineageCheckpoint.from_dict(self.doc)\n+        self.assertEqual(cp.serialize(), cp.serialize())\n+        again = LIN.LineageCheckpoint.from_dict(\n+            json.loads(cp.serialize()))\n+        self.assertEqual(again.checkpoint_id, cp.checkpoint_id)\n+\n+\n+class VerifyCheckpointTest(unittest.TestCase):\n+    def setUp(self):\n+        self.doc = json.loads(BASE_CP.read_text(encoding=\"utf-8\"))\n+\n+    def test_exact_checkpoint_passes_and_is_idempotent(self):\n+        r1 = LIN.verify_checkpoint(REPO, self.doc)\n+        r2 = LIN.verify_checkpoint(REPO, self.doc)\n+        self.assertEqual(r1.status, \"PASS\", r1.to_dict())\n+        self.assertEqual(r1.to_dict(), r2.to_dict())\n+\n+    def test_commit_mismatch_fails(self):\n+        bad = _rebuild(self.doc,\n+                       commit_sha=\"0\" * 40)\n+        r = LIN.verify_checkpoint(REPO, bad)\n+        self.assertEqual(r.status, \"FAIL\")\n+        self.assertIn(\"COMMIT_MISMATCH\", r.failure_codes)\n+        self.assertEqual(r.result, \"LINEAGE_RESUME_FAIL\")\n+\n+    def test_tree_mismatch_fails(self):\n+        bad = _rebuild(self.doc, tree_sha=\"f\" * 40)\n+        r = LIN.verify_checkpoint(REPO, bad)\n+        self.assertIn(\"TREE_MISMATCH\", r.failure_codes)\n+\n+    def test_theory_mismatch_fails(self):\n+        bad = _rebuild(self.doc, theory_artifact_id=\"sha256:\" + \"0\" * 64)\n+        r = LIN.verify_checkpoint(REPO, bad)\n+        self.assertIn(\"THEORY_MISMATCH\", r.failure_codes)\n+\n+    def test_evidence_head_mismatch_fails(self):\n+        bad = _rebuild(self.doc, evidence_length=7,\n+                       evidence_head_hash=\"deadbeef\" * 8)\n+        r = LIN.verify_checkpoint(REPO, bad)\n+        self.assertIn(\"EVIDENCE_HEAD_MISMATCH\", r.failure_codes)\n+\n+    def test_experiment_state_mismatch_fails(self):\n+        bad = _rebuild(self.doc, experiment_state_sha256=\"0\" * 64)\n+        r = LIN.verify_checkpoint(REPO, bad)\n+        self.assertIn(\"EXPERIMENT_STATE_MISMATCH\", r.failure_codes)\n+\n+    def test_root_contract_and_kernel_mismatch_fail(self):\n+        bad = _rebuild(self.doc, root_contract_sha256=\"1\" * 64)\n+        r = LIN.verify_checkpoint(REPO, bad)\n+        self.assertIn(\"ROOT_CONTRACT_MISMATCH\", r.failure_codes)\n+        bad = _rebuild(self.doc, formal_kernel_state_artifact_id=\"2\" * 64)\n+        r = LIN.verify_checkpoint(REPO, bad)\n+        self.assertIn(\"FORMAL_KERNEL_MISMATCH\", r.failure_codes)\n+\n+    def test_protected_manifest_mismatch_fails(self):\n+        bad = _rebuild(self.doc, protected_manifest_sha256=\"3\" * 64)\n+        r = LIN.verify_checkpoint(REPO, bad)\n+        self.assertIn(\"PROTECTED_MANIFEST_MISMATCH\", r.failure_codes)\n+\n+\n+class ResumeTest(unittest.TestCase):\n+    def setUp(self):\n+        self.doc = json.loads(BASE_CP.read_text(encoding=\"utf-8\"))\n+        self.dest = Path(tempfile.mkdtemp()) / \"resume-wt\"\n+\n+    def tearDown(self):\n+        subprocess.run([\"git\", \"worktree\", \"remove\", \"--force\",\n+                        str(self.dest)], cwd=REPO, capture_output=True)\n+        shutil.rmtree(self.dest.parent, ignore_errors=True)\n+\n+    def test_resume_lands_on_exact_commit_and_source_unmoved(self):\n+        before = subprocess.run(\n+            [\"git\", \"rev-parse\", \"origin/claude/new-session-ltyh1o\"],\n+            cwd=REPO, capture_output=True, text=True).stdout.strip()\n+        rec = LIN.resume_from_checkpoint(REPO, self.doc, self.dest)\n+        self.assertEqual(rec[\"head\"], self.doc[\"commit_sha\"])\n+        self.assertEqual(rec[\"tree\"], self.doc[\"tree_sha\"])\n+        self.assertTrue(rec[\"source_branch_unmodified\"])\n+        after = subprocess.run(\n+            [\"git\", \"rev-parse\", \"origin/claude/new-session-ltyh1o\"],\n+            cwd=REPO, capture_output=True, text=True).stdout.strip()\n+        self.assertEqual(before, after)\n+\n+    def test_resume_refused_on_bad_checkpoint(self):\n+        bad = _rebuild(self.doc, tree_sha=\"a\" * 40)\n+        with self.assertRaises(LIN.LineageError):\n+            LIN.resume_from_checkpoint(REPO, bad, self.dest)\n+        self.assertFalse(self.dest.exists())\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()\ndiff --git a/.creator-zero/tests/topology_theory/test_revision_governance_v2.py b/.creator-zero/tests/topology_theory/test_revision_governance_v2.py\nnew file mode 100644\nindex 0000000..6dd9c58\n--- /dev/null\n+++ b/.creator-zero/tests/topology_theory/test_revision_governance_v2.py\n@@ -0,0 +1,236 @@\n+\"\"\"Revision engine v2, governance taxonomy v2, two-stage gate\n+(spec §20.6-20.7, NC9-NC14, NC17).\"\"\"\n+from __future__ import annotations\n+import json\n+import tempfile\n+import unittest\n+\n+import _bootstrap\n+from _bootstrap import CZROOT, TT\n+\n+G = TT.governance\n+TG = TT.theory_gate\n+\n+\n+def _theory():\n+    return TT.build_seed_theory()\n+\n+\n+def _ev(pid, kind, effect, i, run=\"primary\"):\n+    ctx = ({\"context_status\": \"OK\", \"admissibility_kind\": kind,\n+            \"latent_class\": \"X\"} if kind else\n+           {\"context_status\": \"UNKNOWN\"})\n+    return {\"principle_id\": pid, \"topology_id\": f\"H-t{i}-x\",\n+            \"prediction_id\": f\"H-t{i}-x-pr01\", \"effect\": effect,\n+            \"event_id\": f\"ev-{pid}-{i}\", \"trial_id\": f\"t{i}\", \"run\": run,\n+            \"context\": ctx}\n+\n+\n+def _mixed_contextual_events():\n+    events = []\n+    i = 0\n+    for _ in range(6):\n+        i += 1\n+        events.append(_ev(\"P-INDEPENDENCE\", \"CLEAN_ROOM_AUTHORSHIP\",\n+                          \"SUPPORT\", i))\n+    for eff in (\"SUPPORT\", \"SUPPORT\", \"FALSIFY\", \"FALSIFY\", \"FALSIFY\"):\n+        i += 1\n+        events.append(_ev(\"P-INDEPENDENCE\", \"NON_AUTHOR_SEARCH\", eff, i))\n+    for eff in (\"SUPPORT\", \"FALSIFY\", \"FALSIFY\", \"FALSIFY\"):\n+        i += 1\n+        events.append(_ev(\"P-INDEPENDENCE\", \"METHOD_DISJOINT_VERIFICATION\",\n+                          eff, i))\n+    for eff in (\"SUPPORT\", \"SUPPORT\", \"FALSIFY\", \"FALSIFY\"):\n+        i += 1\n+        events.append(_ev(\"P-INDEPENDENCE\", \"INDEPENDENT_DECOMPOSITION\",\n+                          eff, i))\n+    return events\n+\n+\n+class RevisionV2Test(unittest.TestCase):\n+    def test_old_specialize_behavior_preserved(self):\n+        theory = _theory()\n+        events = [\n+            {\"principle_id\": \"P-LOCALITY\", \"topology_id\": \"H-a-local\",\n+             \"prediction_id\": \"p1\", \"effect\": \"SUPPORT\", \"event_id\": \"e1\"},\n+            {\"principle_id\": \"P-LOCALITY\", \"topology_id\": \"H-a-local\",\n+             \"prediction_id\": \"p2\", \"effect\": \"FALSIFY\", \"event_id\": \"e2\"},\n+        ]\n+        rev = TT.propose_revision(theory, events)\n+        self.assertEqual(rev.type, \"SPECIALIZE\")\n+        self.assertEqual(rev.parents, [\"P-LOCALITY\"])\n+\n+    def test_contextual_mixed_evidence_produces_split(self):\n+        theory = _theory()\n+        doc = TT.propose_revision_v2(theory, _mixed_contextual_events())\n+        self.assertTrue(doc[\"split_trigger\"][\"eligible\"],\n+                        doc[\"split_trigger\"])\n+        self.assertEqual(doc[\"selected\"], \"SPLIT\", doc[\"scores\"])\n+        rev = TT.Revision.from_dict(doc[\"candidates\"][\"SPLIT\"])\n+        self.assertEqual(rev.parents, [\"P-INDEPENDENCE\"])\n+        ids = {c[\"id\"] for c in rev.candidate_principles}\n+        self.assertEqual(ids, {\"P-AUTHORSHIP-INDEPENDENCE\",\n+                               \"P-NONAUTHOR-SEARCH\",\n+                               \"P-INDEPENDENT-DECOMPOSITION\",\n+                               \"P-METHOD-DISJOINT-VERIFICATION\"})\n+        for c in rev.candidate_principles:\n+            self.assertEqual(c[\"parent_principles\"], [\"P-INDEPENDENCE\"])\n+            self.assertTrue(c[\"supporting_evidence\"])\n+            self.assertTrue(str(c.get(\"falsifier\", \"\")).strip())\n+        self.assertEqual(rev.status, \"CANDIDATE\")\n+        self.assertTrue(rev.context_partition)\n+\n+    def test_no_split_without_context(self):\n+        theory = _theory()\n+        events = [_ev(\"P-INDEPENDENCE\", None, \"SUPPORT\", 1),\n+                  _ev(\"P-INDEPENDENCE\", None, \"FALSIFY\", 2)]\n+        doc = TT.propose_revision_v2(theory, events)\n+        self.assertFalse(doc[\"split_trigger\"][\"eligible\"])\n+        self.assertNotIn(\"SPLIT\", doc[\"scores\"])\n+\n+    def test_no_change_supported_when_all_support(self):\n+        theory = _theory()\n+        events = [_ev(\"P-INDEPENDENCE\", \"CLEAN_ROOM_AUTHORSHIP\",\n+                      \"SUPPORT\", i) for i in range(1, 9)]\n+        doc = TT.propose_revision_v2(theory, events)\n+        self.assertEqual(doc[\"selected\"], \"no-change\")\n+\n+    def test_apply_split_marks_parent_revised_and_keeps_it_active(self):\n+        theory = _theory()\n+        doc = TT.propose_revision_v2(theory, _mixed_contextual_events())\n+        rev = TT.Revision.from_dict(doc[\"candidates\"][\"SPLIT\"])\n+        succ = TT.revise.apply_revision(theory, rev, \"sha256:predecessor\")\n+        self.assertEqual(succ.version, theory.version + 1)\n+        self.assertEqual(succ.status, \"CANDIDATE\")\n+        parent = succ.principle(\"P-INDEPENDENCE\")\n+        self.assertEqual(parent.status, \"REVISED\")\n+        self.assertTrue(parent.active)\n+        self.assertIsNotNone(succ.principle(\"P-NONAUTHOR-SEARCH\"))\n+\n+    def test_candidate_cannot_promote_directly(self):\n+        # NC13: no direct promotion without a Gate-issued PASS\n+        theory = _theory()\n+        doc = TT.propose_revision_v2(theory, _mixed_contextual_events())\n+        rev = TT.Revision.from_dict(doc[\"candidates\"][\"SPLIT\"])\n+        succ = TT.revise.apply_revision(theory, rev, \"sha256:x\")\n+        store = TT.TheoryStore(tempfile.mkdtemp())\n+        with self.assertRaises(TT.PromotionError):\n+            store.promote(succ, rev.to_dict())\n+        with self.assertRaises(TT.PromotionError):\n+            store.promote(succ, {\"check\": \"verifier\", \"status\": \"PASS\",\n+                                 \"detail\": {\"issued_by\": \"verifier\"}})\n+\n+    def test_replay_rejects_deprecating_split(self):\n+        # a bad revision that RETIRES the parent contradicts frozen history\n+        theory = _theory()\n+        rev = TT.Revision(\n+            revision_id=\"rev-bad\", type=\"DEPRECATE\",\n+            parents=[\"P-INDEPENDENCE\"], motivating_evidence=[\"x\"])\n+        succ = TT.revise.apply_revision(theory, rev, \"sha256:x\")\n+        res = TT.replay(succ)\n+        self.assertGreater(res.contradicted, 0)\n+        self.assertFalse(res.acceptable)\n+\n+    def test_split_survives_replay_including_e6_cases(self):\n+        theory = _theory()\n+        doc = TT.propose_revision_v2(theory, _mixed_contextual_events())\n+        rev = TT.Revision.from_dict(doc[\"candidates\"][\"SPLIT\"])\n+        succ = TT.revise.apply_revision(theory, rev, \"sha256:x\")\n+        cases = TT.load_replay_corpus()\n+        cases += TT.load_replay_corpus(\n+            CZROOT / \"topology-theory\" / \"replay-corpus-e6.json\")\n+        res = TT.replay(succ, cases, repo_root=CZROOT)\n+        self.assertEqual(res.contradicted, 0, res.to_dict())\n+        self.assertEqual(res.indeterminate, 0, res.to_dict())\n+\n+\n+class GovernanceV2Test(unittest.TestCase):\n+    def test_unauthorized_capability_tool_is_fatal(self):\n+        evs = G.classify_session_audit(\n+            {\"disallowed_tool_uses\": [{\"tool\": \"Bash\", \"id\": \"x\"}]}, \"s1\")\n+        self.assertEqual(evs[0][\"category\"], \"capability_violation\")\n+        self.assertTrue(evs[0][\"fatal\"])\n+\n+    def test_meta_tool_observation_is_not_capability_violation(self):\n+        # NC9/NC10\n+        evs = G.classify_session_audit(\n+            {\"disallowed_tool_uses\": [{\"tool\": \"ToolSearch\", \"id\": \"x\"},\n+                                      {\"tool\": \"ToolSearch\", \"id\": \"y\"}]},\n+            \"s1\")\n+        self.assertTrue(all(e[\"category\"] == \"meta_tool_observation\"\n+                            for e in evs))\n+        s = G.summarize(evs)\n+        self.assertEqual(s[\"capability_violations\"], 0)\n+        self.assertEqual(s[\"fatal_events\"], 0)\n+        self.assertEqual(s[\"meta_tool_observations\"], 2)\n+        self.assertEqual(s[\"observed_governance_risk\"], 0.0)\n+\n+    def test_hidden_child_is_fatal(self):\n+        # NC11\n+        evs = G.classify_session_audit(\n+            {\"spawn_capable_tool_uses\": [{\"tool\": \"Agent\", \"id\": \"x\"}]},\n+            \"s1\")\n+        self.assertEqual(evs[0][\"code\"], \"HIDDEN_CHILD_RISK\")\n+        self.assertTrue(evs[0][\"fatal\"])\n+\n+    def test_invalid_ledger_label_is_instrumentation(self):\n+        evs = G.classify_ledger_labels([\"unknown label 'proposeX'\"], \"s1\")\n+        self.assertEqual(evs[0][\"category\"], \"instrumentation_violation\")\n+        self.assertFalse(evs[0][\"fatal\"])\n+        s = G.summarize(evs)\n+        self.assertEqual(s[\"observed_governance_risk\"], 0.1)\n+\n+    def test_e6_mutation_is_protected_law_failure(self):\n+        # NC14\n+        res = TT.self_modify.check_protected_laws(\n+            [\".creator-zero/experiment-6/report.md\"])\n+        self.assertEqual(res[\"status\"], \"FAIL\")\n+        res = TT.self_modify.check_protected_laws(\n+            [\".creator-zero/state/experiment-6.json\"])\n+        self.assertEqual(res[\"status\"], \"FAIL\")\n+        res = TT.self_modify.check_protected_laws(\n+            [\".creator-zero/experiment-7/report.md\"])\n+        self.assertEqual(res[\"status\"], \"PASS\")\n+\n+\n+class TwoStageGateTest(unittest.TestCase):\n+    def _eval_inputs(self, **over):\n+        base = {k: {\"status\": \"PASS\"} for k in TG.REQUIRED_EVAL_INPUTS}\n+        base.update(over)\n+        return base\n+\n+    def test_stage1_authorizes_but_cannot_promote(self):\n+        auth = TG.evaluation_authorization(self._eval_inputs())\n+        self.assertEqual(auth[\"status\"], \"PASS\")\n+        self.assertNotEqual(auth[\"check\"], \"gate\")\n+        store = TT.TheoryStore(tempfile.mkdtemp())\n+        succ = _theory()\n+        with self.assertRaises(TT.PromotionError):\n+            store.promote(succ, auth)          # NC17\n+\n+    def test_stage1_fails_on_missing_input(self):\n+        inputs = self._eval_inputs()\n+        del inputs[\"independent_verifier\"]\n+        auth = TG.evaluation_authorization(inputs)\n+        self.assertEqual(auth[\"status\"], \"FAIL\")\n+\n+    def test_theory_gate_requires_heldout_and_paired(self):\n+        inputs = self._eval_inputs()\n+        inputs[\"evaluation_authorization\"] = \\\n+            TG.evaluation_authorization(self._eval_inputs())\n+        gate = TG.theory_gate(inputs)          # missing held-out inputs\n+        self.assertEqual(gate[\"status\"], \"FAIL\")\n+        inputs.update({\n+            \"heldout_thresholds\": {\"status\": \"PASS\"},\n+            \"paired_improvement\": {\"status\": \"PASS\"},\n+            \"governance\": {\"status\": \"PASS\"},\n+            \"historical_immutability\": {\"status\": \"PASS\"},\n+        })\n+        gate = TG.theory_gate(inputs)\n+        self.assertEqual(gate[\"status\"], \"PASS\")\n+        self.assertEqual(gate[\"check\"], \"gate\")\n+        self.assertEqual(gate[\"detail\"][\"issued_by\"], \"gate\")\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()\ndiff --git a/.creator-zero/topology-theory/__init__.py b/.creator-zero/topology-theory/__init__.py\nindex 17234b1..c4364a9 100644\n--- a/.creator-zero/topology-theory/__init__.py\n+++ b/.creator-zero/topology-theory/__init__.py\n@@ -39,6 +39,14 @@ from .falsify import falsify, principle_evidence_events\n from .revise import propose_revision\n from .replay import replay, load_replay_corpus\n from . import self_modify\n+from . import admissibility\n+from . import ingest\n+from . import governance\n+from . import theory_gate\n+from .generate2 import generate_candidates_v2, family_of_v2, FAMILIES_V2\n+from .predict2 import freeze_predictions_v2\n+from .revise2 import (propose_revision_v2, context_stats, split_trigger,\n+                      explanation_scores)\n \n __all__ = [\n     \"Principle\", \"PrincipleEvidence\", \"Prediction\", \"TopologyHypothesis\",\n@@ -53,6 +61,11 @@ __all__ = [\n     \"evaluate_topology\", \"PredictionIntegrityError\",\n     \"falsify\", \"principle_evidence_events\", \"propose_revision\",\n     \"replay\", \"load_replay_corpus\", \"self_modify\",\n+    \"admissibility\", \"ingest\", \"governance\", \"theory_gate\",\n+    \"generate_candidates_v2\", \"family_of_v2\", \"FAMILIES_V2\",\n+    \"freeze_predictions_v2\",\n+    \"propose_revision_v2\", \"context_stats\", \"split_trigger\",\n+    \"explanation_scores\",\n ]\n \n __version__ = \"0.1\"\ndiff --git a/.creator-zero/topology-theory/admissibility.py b/.creator-zero/topology-theory/admissibility.py\nnew file mode 100644\nindex 0000000..110e752\n--- /dev/null\n+++ b/.creator-zero/topology-theory/admissibility.py\n@@ -0,0 +1,305 @@\n+\"\"\"Typed evidence admissibility: independence vectors, roles, requirements.\n+\n+    I = (I_A, I_S, I_D, I_M) ∈ {0,1}^4\n+\n+    Adm(p, r) = VectorSatisfies(p,r) ∧ RoleCompatible(p,r)\n+                ∧ SourceCompatible(p,r) ∧ MethodCompatible(p,r)\n+\n+No coordinate entails another; canonical roles are epistemic relations, not\n+node placements, and are never aliases. Vector coverage is necessary but not\n+sufficient: a correct answer from the wrong role is inadmissible for the\n+targeted distinction (the Experiment 6 'right shape, wrong role' failure).\n+\n+Deterministic utility-v2 component computation lives here too: saturating\n+epistemic value (admissible coverage; extra isolation adds nothing),\n+marginal-coverage redundancy, and structural governance risk. The macro\n+utility form and its frozen weights are unchanged (utility.py).\n+\"\"\"\n+from __future__ import annotations\n+from dataclasses import dataclass, field, asdict\n+from typing import Any, Optional\n+\n+from .model import ModelValidationError\n+\n+# ---- kinds and roles -------------------------------------------------------\n+\n+KINDS = (\"LOCAL\", \"CLEAN_ROOM_AUTHORSHIP\", \"NON_AUTHOR_SEARCH\",\n+         \"INDEPENDENT_DECOMPOSITION\", \"METHOD_DISJOINT_VERIFICATION\")\n+\n+ROLES = (\"local_author\", \"clean_room_author\", \"non_author_examiner\",\n+         \"independent_decomposer\", \"method_disjoint_verifier\")\n+\n+# role -> provided independence vector (I_A, I_S, I_D, I_M); no entailment\n+ROLE_VECTOR = {\n+    \"local_author\": (0, 0, 0, 0),\n+    \"clean_room_author\": (1, 0, 0, 0),\n+    \"non_author_examiner\": (0, 1, 0, 0),\n+    \"independent_decomposer\": (0, 0, 1, 0),\n+    \"method_disjoint_verifier\": (0, 0, 0, 1),\n+}\n+\n+# kind -> (required vector, allowed roles)\n+KIND_REQUIREMENT = {\n+    \"LOCAL\": ((0, 0, 0, 0), (\"local_author\",)),\n+    \"CLEAN_ROOM_AUTHORSHIP\": ((1, 0, 0, 0), (\"clean_room_author\",)),\n+    \"NON_AUTHOR_SEARCH\": ((0, 1, 0, 0), (\"non_author_examiner\",)),\n+    \"INDEPENDENT_DECOMPOSITION\": ((0, 0, 1, 0), (\"independent_decomposer\",)),\n+    \"METHOD_DISJOINT_VERIFICATION\": ((0, 0, 0, 1),\n+                                     (\"method_disjoint_verifier\",)),\n+}\n+\n+# S1-inferred typed feature -> required admissibility kind\n+FEATURE_TO_KIND = {\n+    \"requires_clean_room_authorship\": \"CLEAN_ROOM_AUTHORSHIP\",\n+    \"requires_nonauthor_search\": \"NON_AUTHOR_SEARCH\",\n+    \"requires_independent_decomposition\": \"INDEPENDENT_DECOMPOSITION\",\n+    \"requires_method_disjoint_verification\": \"METHOD_DISJOINT_VERIFICATION\",\n+}\n+TYPED_FEATURES = tuple(sorted(FEATURE_TO_KIND))\n+\n+# frozen E6 vocabulary -> canonical roles (enrichment/scoring joins)\n+E6_ROLE_MAP = {\n+    \"clean_room_implementer\": \"clean_room_author\",\n+    \"adversarial_searcher\": \"non_author_examiner\",\n+    \"independent_decomposer\": \"independent_decomposer\",\n+    \"independent_verifier\": \"method_disjoint_verifier\",\n+    \"examiner_session\": \"non_author_examiner\",\n+    \"none\": \"local_author\",\n+}\n+\n+# frozen E6 latent class -> admissibility kind\n+E6_CLASS_TO_KIND = {\n+    \"LOCAL\": \"LOCAL\",\n+    \"ISOLATION\": \"CLEAN_ROOM_AUTHORSHIP\",\n+    \"COUNTEREXAMPLE\": \"NON_AUTHOR_SEARCH\",\n+    \"ALTERNATIVE_DECOMPOSITION\": \"INDEPENDENT_DECOMPOSITION\",\n+    \"SPECIALIZED_VERIFICATION\": \"METHOD_DISJOINT_VERIFICATION\",\n+}\n+\n+\n+@dataclass(frozen=True)\n+class IndependenceVector:\n+    i_a: int = 0\n+    i_s: int = 0\n+    i_d: int = 0\n+    i_m: int = 0\n+\n+    def __post_init__(self):\n+        for k in (\"i_a\", \"i_s\", \"i_d\", \"i_m\"):\n+            if getattr(self, k) not in (0, 1):\n+                raise ModelValidationError(\n+                    f\"independence coordinate {k} must be 0 or 1\")\n+\n+    def as_tuple(self) -> tuple[int, int, int, int]:\n+        return (self.i_a, self.i_s, self.i_d, self.i_m)\n+\n+    def dominates(self, other: \"IndependenceVector\") -> bool:\n+        \"\"\"∀k: self.I_k >= other.I_k (VectorSatisfies).\"\"\"\n+        return all(a >= b for a, b in zip(self.as_tuple(), other.as_tuple()))\n+\n+    @classmethod\n+    def of(cls, t) -> \"IndependenceVector\":\n+        if isinstance(t, IndependenceVector):\n+            return t\n+        return cls(*[int(x) for x in t])\n+\n+\n+@dataclass(frozen=True)\n+class EvidenceRequirement:\n+    requirement_id: str\n+    distinction_id: str\n+    kind: str\n+    independence: IndependenceVector\n+    allowed_roles: tuple[str, ...]\n+    prohibited_sources: tuple[str, ...] = ()\n+    primary_method_family: str = \"\"     # nonempty => method-disjointness bind\n+\n+    def __post_init__(self):\n+        if self.kind not in KINDS:\n+            raise ModelValidationError(f\"unknown admissibility kind \"\n+                                       f\"{self.kind!r}\")\n+        bad = [r for r in self.allowed_roles if r not in ROLES]\n+        if bad:\n+            raise ModelValidationError(f\"unknown roles {bad}\")\n+\n+    def to_dict(self) -> dict[str, Any]:\n+        d = asdict(self)\n+        d[\"independence\"] = list(self.independence.as_tuple())\n+        d[\"allowed_roles\"] = list(self.allowed_roles)\n+        d[\"prohibited_sources\"] = list(self.prohibited_sources)\n+        return d\n+\n+\n+@dataclass(frozen=True)\n+class EvidenceProvision:\n+    node_id: str\n+    role: str\n+    independence: IndependenceVector\n+    provenance_refs: tuple[str, ...] = ()\n+    method_family: str = \"\"\n+    source: str = \"\"                    # provenance source tag\n+\n+    def __post_init__(self):\n+        if self.role not in ROLES:\n+            raise ModelValidationError(f\"unknown canonical role \"\n+                                       f\"{self.role!r}\")\n+\n+    def to_dict(self) -> dict[str, Any]:\n+        d = asdict(self)\n+        d[\"independence\"] = list(self.independence.as_tuple())\n+        d[\"provenance_refs\"] = list(self.provenance_refs)\n+        return d\n+\n+\n+def provision_for_role(node_id: str, role: str, *, method_family: str = \"\",\n+                       source: str = \"\") -> EvidenceProvision:\n+    return EvidenceProvision(\n+        node_id=node_id, role=role,\n+        independence=IndependenceVector.of(ROLE_VECTOR[role]),\n+        method_family=method_family, source=source)\n+\n+\n+def requirement_for_distinction(d: dict[str, Any],\n+                                primary_method_family: str = \"\",\n+                                ) -> EvidenceRequirement:\n+    \"\"\"Deterministic requirement from a distinction's typed features.\n+\n+    Exactly one typed feature may be set; none => LOCAL. More than one is a\n+    typed-schema violation (bank tasks carry a single latent kind).\"\"\"\n+    feats = d.get(\"features\", {})\n+    kinds = sorted(FEATURE_TO_KIND[f] for f in TYPED_FEATURES\n+                   if bool(feats.get(f, False)))\n+    if len(kinds) > 1:\n+        raise ModelValidationError(\n+            f\"distinction {d.get('id')!r} sets multiple typed independence \"\n+            f\"features {kinds}; requirements are single-kind\")\n+    kind = kinds[0] if kinds else \"LOCAL\"\n+    vec, roles = KIND_REQUIREMENT[kind]\n+    return EvidenceRequirement(\n+        requirement_id=f\"req-{d['id']}\",\n+        distinction_id=d[\"id\"],\n+        kind=kind,\n+        independence=IndependenceVector.of(vec),\n+        allowed_roles=roles,\n+        primary_method_family=(primary_method_family\n+                               if kind == \"METHOD_DISJOINT_VERIFICATION\"\n+                               else \"\"),\n+    )\n+\n+\n+# ---- the admissibility equation -------------------------------------------\n+\n+def admissible(p: EvidenceProvision, r: EvidenceRequirement,\n+               ) -> tuple[bool, dict[str, bool]]:\n+    clauses = {\n+        \"vector_satisfies\": p.independence.dominates(r.independence),\n+        \"role_compatible\": p.role in r.allowed_roles,\n+        \"source_compatible\": (not p.source\n+                              or p.source not in r.prohibited_sources),\n+        \"method_compatible\": (not r.primary_method_family\n+                              or (bool(p.method_family)\n+                                  and p.method_family\n+                                  != r.primary_method_family)),\n+    }\n+    return all(clauses.values()), clauses\n+\n+\n+def topology_admissible(provisions: list[EvidenceProvision],\n+                        requirements: list[EvidenceRequirement],\n+                        ) -> dict[str, Any]:\n+    \"\"\"Valid_Adm(H,Q): every requirement has >=1 admissible provision.\"\"\"\n+    per_req: dict[str, Any] = {}\n+    ok_all = True\n+    for r in requirements:\n+        winners = []\n+        for p in provisions:\n+            ok, clauses = admissible(p, r)\n+            if ok:\n+                winners.append(p.node_id)\n+        per_req[r.requirement_id] = {\n+            \"kind\": r.kind, \"distinction_id\": r.distinction_id,\n+            \"admissible_provisions\": winners, \"admissible\": bool(winners)}\n+        ok_all &= bool(winners)\n+    return {\"admissible\": ok_all, \"per_requirement\": per_req}\n+\n+\n+def marginal_coverage(provisions: list[EvidenceProvision],\n+                      requirements: list[EvidenceRequirement],\n+                      ) -> dict[str, list[str]]:\n+    \"\"\"Requirements each provision covers beyond all earlier provisions\n+    (declared order). A provision with an empty list adds no admissible\n+    coverage: MarginalCoverage(p_k | p_1..p_{k-1}) = 0.\"\"\"\n+    covered: set[str] = set()\n+    out: dict[str, list[str]] = {}\n+    for p in provisions:\n+        adds = []\n+        for r in requirements:\n+            if r.requirement_id in covered:\n+                continue\n+            if admissible(p, r)[0]:\n+                adds.append(r.requirement_id)\n+        covered.update(adds)\n+        out[p.node_id] = sorted(adds)\n+    return out\n+\n+\n+# ---- deterministic utility-v2 components ----------------------------------\n+\n+def predicted_components(provisions: list[EvidenceProvision],\n+                         requirements: list[EvidenceRequirement],\n+                         value_by_distinction: dict[str, float],\n+                         *, model_sessions: int, child_sessions: int,\n+                         cost_denominator: int = 8) -> dict[str, float]:\n+    \"\"\"Saturating ΔE + marginal-coverage redundancy + structural governance.\n+\n+        ΔE_hat = Σ_q v_q·Adm(H,q) / Σ_q v_q          (0 if Σ v_q = 0)\n+        C      = (model_sessions + child_sessions) / 8\n+        R      = |provisions with zero marginal coverage| / |provisions|\n+        G      = min(1, 0.05·(model_sessions−1) + 0.10·child_sessions)\n+\n+    Once a requirement is admissibly covered its value saturates: a second,\n+    more isolated provider adds redundancy, never value (b(H,q)=0).\"\"\"\n+    adm = topology_admissible(provisions, requirements)\n+    tot = 0.0\n+    got = 0.0\n+    for r in requirements:\n+        v = float(value_by_distinction.get(r.distinction_id, 0.0))\n+        if not (0.0 <= v <= 1.0):\n+            raise ModelValidationError(\n+                f\"value estimate for {r.distinction_id} outside [0,1]: {v}\")\n+        tot += v\n+        if adm[\"per_requirement\"][r.requirement_id][\"admissible\"]:\n+            got += v\n+    delta_e = round(got / tot, 4) if tot > 0 else 0.0\n+    mc = marginal_coverage(provisions, requirements)\n+    n_prov = max(1, len(provisions))\n+    redundant = sum(1 for adds in mc.values() if not adds)\n+    redundancy = round(redundant / n_prov, 4)\n+    governance = round(min(1.0, 0.05 * max(0, model_sessions - 1)\n+                           + 0.10 * child_sessions), 4)\n+    cost = round((model_sessions + child_sessions) / cost_denominator, 4)\n+    return {\"delta_e\": delta_e, \"cost\": cost, \"redundancy\": redundancy,\n+            \"governance_risk\": governance}\n+\n+\n+# ---- serialization helpers for embedded specs -----------------------------\n+\n+def provisions_from_spec(spec: dict[str, Any]) -> list[EvidenceProvision]:\n+    out = []\n+    for p in spec.get(\"evidence_provisions\", []):\n+        out.append(EvidenceProvision(\n+            node_id=p[\"node_id\"], role=p[\"role\"],\n+            independence=IndependenceVector.of(p[\"independence\"]),\n+            provenance_refs=tuple(p.get(\"provenance_refs\", ())),\n+            method_family=p.get(\"method_family\", \"\"),\n+            source=p.get(\"source\", \"\")))\n+    return out\n+\n+\n+def canonical_role(e6_role: str, *, examiner: bool = False) -> str:\n+    \"\"\"Map frozen E6 role vocabulary to canonical roles.\"\"\"\n+    if examiner:\n+        return \"non_author_examiner\"\n+    if e6_role in ROLES:\n+        return e6_role\n+    return E6_ROLE_MAP.get(e6_role or \"none\", \"local_author\")\ndiff --git a/.creator-zero/topology-theory/generate2.py b/.creator-zero/topology-theory/generate2.py\nnew file mode 100644\nindex 0000000..a4176bc\n--- /dev/null\n+++ b/.creator-zero/topology-theory/generate2.py\n@@ -0,0 +1,217 @@\n+\"\"\"Topology grammar v2: typed-relation candidate generation.\n+\n+Extends the closed v1 template grammar just enough to express typed\n+epistemic relations. Families (closed, frozen):\n+\n+    local                            1 session   role local_author\n+    local-independent-examiner       2 sessions  + non_author_examiner\n+    local-method-disjoint-verifier   2 sessions  + method_disjoint_verifier\n+    isolated-clean-room-author       2 + child   + clean_room_author\n+    isolated-decomposer              2 + child   + independent_decomposer\n+    isolated-searcher                2 + child   + non_author_examiner\n+                                     (admissible for search; dominated on\n+                                      cost — exists so economics can prove\n+                                      the examiner wins)\n+    branching                        2 + child   deferred decision; child\n+                                     role bound to the required kind\n+\n+Every spec embeds `evidence_provisions` [(node, canonical role, vector)].\n+Admissibility filtering happens downstream (admissibility.topology_admissible)\n+before economics; predicted values here are fully deterministic\n+(admissibility-saturating ΔE, marginal-coverage redundancy, structural\n+governance risk, call-structure cost). There is no model path around the\n+grammar.\n+\"\"\"\n+from __future__ import annotations\n+from typing import Any\n+\n+from .admissibility import (FEATURE_TO_KIND, KIND_REQUIREMENT, TYPED_FEATURES,\n+                            provision_for_role, provisions_from_spec,\n+                            requirement_for_distinction, topology_admissible,\n+                            predicted_components)\n+from .generate import (_branching_spec, _child_spec, _local_iv_spec,\n+                       _local_spec, _contract_allows_create)\n+from .model import ApplicabilityResult, TopologyHypothesis\n+from .serialization import object_artifact_id\n+\n+FAMILIES_V2 = (\"local\", \"local-independent-examiner\",\n+               \"local-method-disjoint-verifier\", \"isolated-clean-room-author\",\n+               \"isolated-decomposer\", \"isolated-searcher\", \"branching\")\n+\n+FAMILY_CALLS_V2 = {\n+    \"local\": (1, 0),\n+    \"local-independent-examiner\": (2, 0),\n+    \"local-method-disjoint-verifier\": (2, 0),\n+    \"isolated-clean-room-author\": (2, 1),\n+    \"isolated-decomposer\": (2, 1),\n+    \"isolated-searcher\": (2, 1),\n+    \"branching\": (2, 1),\n+}\n+\n+# required kind -> (minimal family, alternative family, child role)\n+KIND_FAMILIES = {\n+    \"NON_AUTHOR_SEARCH\": (\"local-independent-examiner\", \"isolated-searcher\",\n+                          \"non_author_examiner\"),\n+    \"CLEAN_ROOM_AUTHORSHIP\": (\"isolated-clean-room-author\", \"branching\",\n+                              \"clean_room_author\"),\n+    \"INDEPENDENT_DECOMPOSITION\": (\"isolated-decomposer\", \"branching\",\n+                                  \"independent_decomposer\"),\n+    \"METHOD_DISJOINT_VERIFICATION\": (\"local-method-disjoint-verifier\",\n+                                     \"branching\",\n+                                     \"method_disjoint_verifier\"),\n+}\n+\n+\n+def family_of_v2(topology_id: str) -> str:\n+    for fam in (\"local-independent-examiner\", \"local-method-disjoint-verifier\",\n+                \"isolated-clean-room-author\", \"isolated-decomposer\",\n+                \"isolated-searcher\", \"branching\", \"local\"):\n+        if topology_id.endswith(fam):\n+            return fam\n+    raise ValueError(f\"cannot derive v2 family from {topology_id!r}\")\n+\n+\n+def _spec_for(family: str, task_id: str, contract: dict[str, Any],\n+              child_role: str) -> dict[str, Any]:\n+    if family == \"local\":\n+        spec = _local_spec(task_id, contract)\n+        provisions = [(\"resolve-local\", \"local_author\", \"\")]\n+    elif family == \"local-independent-examiner\":\n+        spec = _local_iv_spec(task_id, contract)\n+        spec[\"goal\"] = (f\"Local resolution of {task_id} plus an \"\n+                        \"information-only independent examiner pass\")\n+        provisions = [(\"resolve-local\", \"local_author\", \"\"),\n+                      (\"verify-independent\", \"non_author_examiner\", \"\")]\n+    elif family == \"local-method-disjoint-verifier\":\n+        spec = _local_iv_spec(task_id, contract)\n+        spec[\"goal\"] = (f\"Local resolution of {task_id} plus re-derivation \"\n+                        \"by a verifier bound to a disjoint method family\")\n+        for n in spec[\"nodes\"]:\n+            if n[\"id\"] == \"verify-independent\":","numLines":900,"startLine":800,"totalLines":2852}}}
