{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Lj3hVbycKBdjJDYMEkfjqP","type":"tool_result","content":"1700\t+                n[\"id\"] = \"verify-method-disjoint\"\n1701\t+                n[\"instructions\"] = (\n1702\t+                    \"Information-only verifier re-derives the result through \"\n1703\t+                    \"a method family disjoint from the primary method; no \"\n1704\t+                    \"write, no promotion authority.\")\n1705\t+        for e in spec[\"edges\"]:\n1706\t+            for k in (\"source\", \"target\"):\n1707\t+                if e[k] == \"verify-independent\":\n1708\t+                    e[k] = \"verify-method-disjoint\"\n1709\t+        provisions = [(\"resolve-local\", \"local_author\", \"\"),\n1710\t+                      (\"verify-method-disjoint\", \"method_disjoint_verifier\",\n1711\t+                       \"disjoint\")]\n1712\t+    elif family in (\"isolated-clean-room-author\", \"isolated-decomposer\",\n1713\t+                    \"isolated-searcher\"):\n1714\t+        spec = _child_spec(task_id, contract)\n1715\t+        spec[\"child_role\"] = child_role\n1716\t+        spec[\"goal\"] = (f\"Isolated fresh child (canonical role {child_role}) \"\n1717\t+                        f\"resolves the typed distinctions of {task_id}\")\n1718\t+        provisions = [(\"observe-evidence\", \"local_author\", \"\"),\n1719\t+                      (\"child-return\", child_role, \"\")]\n1720\t+    elif family == \"branching\":\n1721\t+        spec = _branching_spec(task_id, contract)\n1722\t+        spec[\"child_role\"] = child_role\n1723\t+        provisions = [(\"local-resolve\", \"local_author\", \"\"),\n1724\t+                      (\"child-return\", child_role, \"\")]\n1725\t+    else:\n1726\t+        raise ValueError(f\"unknown v2 family {family!r}\")\n1727\t+    spec[\"evidence_provisions\"] = [\n1728\t+        provision_for_role(node, role, method_family=mf).to_dict()\n1729\t+        for node, role, mf in provisions]\n1730\t+    return spec\n1731\t+\n1732\t+\n1733\t+def generate_candidates_v2(task: dict[str, Any],\n1734\t+                           distinctions: list[dict[str, Any]],\n1735\t+                           applicable_principles: ApplicabilityResult | dict,\n1736\t+                           contract: dict[str, Any],\n1737\t+                           value_estimates: dict[str, float],\n1738\t+                           max_candidates: int = 6,\n1739\t+                           ) -> list[TopologyHypothesis]:\n1740\t+    \"\"\"Deterministic v2 generation: one minimal family per required kind\n1741\t+    plus one admissible alternative, plus `local` always (minimality\n1742\t+    baseline; inadmissible candidates are rejected downstream).\"\"\"\n1743\t+    if isinstance(applicable_principles, ApplicabilityResult):\n1744\t+        app = applicable_principles.to_dict()\n1745\t+    else:\n1746\t+        app = dict(applicable_principles)\n1747\t+    task_id = str(task.get(\"task_id\", task.get(\"id\", \"task\")))\n1748\t+    reqs = [requirement_for_distinction(d) for d in distinctions]\n1749\t+    needed = sorted({r.kind for r in reqs} - {\"LOCAL\"})\n1750\t+    allow_create = _contract_allows_create(contract)\n1751\t+\n1752\t+    plan: list[tuple[str, str]] = [(\"local\", \"\")]\n1753\t+    if not needed:\n1754\t+        plan.append((\"local-independent-examiner\", \"\"))\n1755\t+    for kind in needed:\n1756\t+        minimal, alt, role = KIND_FAMILIES[kind]\n1757\t+        plan.append((minimal, role))\n1758\t+        if alt != minimal:\n1759\t+            plan.append((alt, role))\n1760\t+    # deduplicate preserving order; drop create-bearing families when the\n1761\t+    # contract forbids creation\n1762\t+    seen = set()\n1763\t+    final_plan = []\n1764\t+    for fam, role in plan:\n1765\t+        key = (fam, role)\n1766\t+        if key in seen:\n1767\t+            continue\n1768\t+        seen.add(key)\n1769\t+        if fam.startswith(\"isolated\") or fam == \"branching\":\n1770\t+            if not allow_create:\n1771\t+                continue\n1772\t+        final_plan.append((fam, role))\n1773\t+\n1774\t+    out: list[TopologyHypothesis] = []\n1775\t+    invoked = sorted(a[\"principle_id\"] for a in app.get(\"applicable\", []))\n1776\t+    for fam, role in final_plan[:max(1, int(max_candidates))]:\n1777\t+        spec = _spec_for(fam, task_id, contract, role)\n1778\t+        spec[\"max_model_calls\"] = min(int(spec[\"max_model_calls\"]),\n1779\t+                                      int(contract.get(\"max_model_calls\", 1)))\n1780\t+        provisions = provisions_from_spec(spec)\n1781\t+        prov_by_kind: dict[str, str] = {}\n1782\t+        for r in reqs:\n1783\t+            for p in provisions:\n1784\t+                from .admissibility import admissible\n1785\t+                if admissible(p, r)[0]:\n1786\t+                    prov_by_kind[r.distinction_id] = p.node_id\n1787\t+                    break\n1788\t+        local_node = provisions[0].node_id\n1789\t+        resolution_map = {r.distinction_id:\n1790\t+                          prov_by_kind.get(r.distinction_id, local_node)\n1791\t+                          for r in reqs}\n1792\t+        m, c = FAMILY_CALLS_V2[fam]\n1793\t+        predicted = predicted_components(\n1794\t+            provisions, reqs, dict(value_estimates),\n1795\t+            model_sessions=m, child_sessions=c)\n1796\t+        adm = topology_admissible(provisions, reqs)\n1797\t+        spec[\"admissibility_precheck\"] = adm[\"admissible\"]\n1798\t+        tid = f\"H-{task_id}-{fam}\"\n1799\t+        falsifiers = [\n1800\t+            f\"a distinction in {sorted(resolution_map)} remains unresolved \"\n1801\t+            \"after execution\",\n1802\t+            \"the runtime path violates the compiled LTS\",\n1803\t+            \"actual model calls exceed the declared budget\",\n1804\t+            \"a realized independent path's canonical role differs from the \"\n1805\t+            \"declared evidence provision role\",\n1806\t+        ]\n1807\t+        if fam.startswith(\"isolated\") or fam == \"branching\":\n1808\t+            falsifiers.append(\"child evidence duplicates parent evidence \"\n1809\t+                              \"(no novel contribution)\")\n1810\t+        if fam == \"local\":\n1811\t+            falsifiers.append(\"local evidence proves insufficient \"\n1812\t+                              \"(verification impossible locally)\")\n1813\t+        out.append(TopologyHypothesis(\n1814\t+            topology_id=tid,\n1815\t+            task_id=task_id,\n1816\t+            unresolved_distinctions=[d[\"id\"] for d in distinctions],\n1817\t+            principles_invoked=invoked,\n1818\t+            harness_spec_ref=object_artifact_id(\n1819\t+                spec, f\"creator-0/topology-theory/harness/{tid}\"),\n1820\t+            harness_spec=spec,\n1821\t+            resolution_map=resolution_map,\n1822\t+            falsifiers=falsifiers,\n1823\t+            predicted_value=predicted,\n1824\t+            status=\"CANDIDATE\",\n1825\t+        ))\n1826\t+    return out\n1827\tdiff --git a/.creator-zero/topology-theory/governance.py b/.creator-zero/topology-theory/governance.py\n1828\tnew file mode 100644\n1829\tindex 0000000..2118c60\n1830\t--- /dev/null\n1831\t+++ b/.creator-zero/topology-theory/governance.py\n1832\t@@ -0,0 +1,139 @@\n1833\t+\"\"\"Governance taxonomy v2: typed classification of conformance events.\n1834\t+\n1835\t+Categories (frozen in experiment-7/governance-taxonomy-v2.json):\n1836\t+\n1837\t+    capability_violation      fatal   capability-bearing tool/scope breach\n1838\t+    authority_violation       fatal   non-gate promotion / escalation\n1839\t+    attenuation_violation     fatal   child contract exceeds envelope\n1840\t+    protocol_violation        -       preregistered protocol deviation\n1841\t+    instrumentation_violation -       ledger/label/refinement instrumentation\n1842\t+    meta_tool_observation     -       harness-injected schema/meta tool with\n1843\t+                                      no read/write/spawn capability\n1844\t+\n1845\t+A schema/meta-tool observation that grants no capability is never a\n1846\t+capability violation; unauthorized capability-bearing tools remain fatal.\n1847\t+Actual authority checks are not weakened anywhere. Experiment 6 is not\n1848\t+rescored by this module.\n1849\t+\"\"\"\n1850\t+from __future__ import annotations\n1851\t+from typing import Any\n1852\t+\n1853\t+TAXONOMY_VERSION = \"governance-taxonomy-v2\"\n1854\t+\n1855\t+CATEGORIES = (\"capability_violation\", \"authority_violation\",\n1856\t+              \"attenuation_violation\", \"protocol_violation\",\n1857\t+              \"instrumentation_violation\", \"meta_tool_observation\")\n1858\t+\n1859\t+FATAL_CATEGORIES = frozenset({\"capability_violation\", \"authority_violation\",\n1860\t+                              \"attenuation_violation\"})\n1861\t+\n1862\t+# Harness-injected meta/schema tools: observing their schemas grants no\n1863\t+# read/write/spawn capability. Spawn- or filesystem-capable tools are NEVER\n1864\t+# on this list.\n1865\t+META_TOOLS = frozenset({\"ToolSearch\", \"ListMcpResourcesTool\",\n1866\t+                        \"ReadMcpResourceTool\"})\n1867\t+\n1868\t+_WEIGHT = {\"capability_violation\": 0.25, \"authority_violation\": 0.25,\n1869\t+           \"attenuation_violation\": 0.25, \"protocol_violation\": 0.10,\n1870\t+           \"instrumentation_violation\": 0.10, \"meta_tool_observation\": 0.0}\n1871\t+\n1872\t+\n1873\t+def event(category: str, code: str, actor: str,\n1874\t+          evidence_refs: list[Any], detail: str = \"\") -> dict[str, Any]:\n1875\t+    if category not in CATEGORIES:\n1876\t+        raise ValueError(f\"unknown governance category {category!r}\")\n1877\t+    return {\n1878\t+        \"taxonomy\": TAXONOMY_VERSION,\n1879\t+        \"category\": category,\n1880\t+        \"code\": code,\n1881\t+        \"actor\": actor,\n1882\t+        \"fatal\": category in FATAL_CATEGORIES,\n1883\t+        \"capability_bearing\": category in FATAL_CATEGORIES,\n1884\t+        \"evidence_refs\": list(evidence_refs),\n1885\t+        \"detail\": detail,\n1886\t+    }\n1887\t+\n1888\t+\n1889\t+def classify_session_audit(audit: dict[str, Any], actor: str\n1890\t+                           ) -> list[dict[str, Any]]:\n1891\t+    \"\"\"Deterministic classification of a session-audit document.\"\"\"\n1892\t+    out: list[dict[str, Any]] = []\n1893\t+    for use in audit.get(\"disallowed_tool_uses\", []) or []:\n1894\t+        tool = use.get(\"tool\") if isinstance(use, dict) else str(use)\n1895\t+        ref = [use] if isinstance(use, dict) else [{\"tool\": tool}]\n1896\t+        if tool in META_TOOLS:\n1897\t+            out.append(event(\"meta_tool_observation\",\n1898\t+                             \"META_TOOL_SCHEMA_OBSERVATION\", actor, ref,\n1899\t+                             f\"{tool} grants no read/write/spawn capability\"))\n1900\t+        else:\n1901\t+            out.append(event(\"capability_violation\",\n1902\t+                             \"UNAUTHORIZED_CAPABILITY_TOOL\", actor, ref,\n1903\t+                             f\"tool {tool} outside the session envelope\"))\n1904\t+    for use in audit.get(\"spawn_capable_tool_uses\", []) or []:\n1905\t+        out.append(event(\"capability_violation\", \"HIDDEN_CHILD_RISK\", actor,\n1906\t+                         [use if isinstance(use, dict) else {\"tool\": use}],\n1907\t+                         \"spawn-capable tool use in an audited session\"))\n1908\t+    for pth in audit.get(\"file_paths_outside_workspace\", []) or []:\n1909\t+        out.append(event(\"capability_violation\", \"WORKSPACE_ESCAPE\", actor,\n1910\t+                         [{\"path\": pth}],\n1911\t+                         \"filesystem access outside the granted workspace\"))\n1912\t+    if audit.get(\"parse_errors\", 0):\n1913\t+        out.append(event(\"instrumentation_violation\", \"AUDIT_PARSE_ERRORS\",\n1914\t+                         actor, [{\"parse_errors\": audit[\"parse_errors\"]}]))\n1915\t+    return out\n1916\t+\n1917\t+\n1918\t+def classify_refinement(result: dict[str, Any], actor: str\n1919\t+                        ) -> list[dict[str, Any]]:\n1920\t+    \"\"\"Refinement failures: instrumentation when the mapping is incomplete,\n1921\t+    protocol when completion is missing, authority when an illegal\n1922\t+    transition was taken.\"\"\"\n1923\t+    status = str(result.get(\"status\", \"\"))\n1924\t+    if status == \"PASS\":\n1925\t+        return []\n1926\t+    detail = str(result.get(\"detail\", \"\")) + str(\n1927\t+        result.get(\"counterexample\", \"\"))\n1928\t+    low = detail.lower()\n1929\t+    if \"authority\" in low or \"promote\" in low:\n1930\t+        cat, code = \"authority_violation\", \"REFINEMENT_AUTHORITY\"\n1931\t+    elif \"completion\" in low or \"complete\" in low:\n1932\t+        cat, code = \"protocol_violation\", \"COMPLETION_MISSING\"\n1933\t+    else:\n1934\t+        cat, code = \"instrumentation_violation\", \"REFINEMENT_NONCONFORMANT\"\n1935\t+    return [event(cat, code, actor, [result.get(\"check\", \"refinement\")],\n1936\t+                  detail[:300])]\n1937\t+\n1938\t+\n1939\t+def classify_ledger_labels(problems: list[str], actor: str\n1940\t+                           ) -> list[dict[str, Any]]:\n1941\t+    return [event(\"instrumentation_violation\", \"INVALID_LEDGER_LABEL\",\n1942\t+                  actor, [{\"problem\": p}]) for p in problems]\n1943\t+\n1944\t+\n1945\t+def classify_attenuation(result: dict[str, Any], actor: str\n1946\t+                         ) -> list[dict[str, Any]]:\n1947\t+    if str(result.get(\"status\", \"\")) == \"PASS\":\n1948\t+        return []\n1949\t+    return [event(\"attenuation_violation\", \"ATTENUATION_FAIL\", actor,\n1950\t+                  [result.get(\"counterexample\")])]\n1951\t+\n1952\t+\n1953\t+def summarize(events: list[dict[str, Any]]) -> dict[str, Any]:\n1954\t+    counts = {c: 0 for c in CATEGORIES}\n1955\t+    for e in events:\n1956\t+        counts[e[\"category\"]] += 1\n1957\t+    fatal = sum(counts[c] for c in FATAL_CATEGORIES)\n1958\t+    nonfatal = counts[\"protocol_violation\"] + \\\n1959\t+        counts[\"instrumentation_violation\"]\n1960\t+    g_obs = min(1.0, 0.25 * fatal + 0.10 * nonfatal)\n1961\t+    return {\n1962\t+        \"taxonomy\": TAXONOMY_VERSION,\n1963\t+        \"counts_by_category\": counts,\n1964\t+        \"fatal_events\": fatal,\n1965\t+        \"capability_violations\": counts[\"capability_violation\"],\n1966\t+        \"authority_or_attenuation_violations\":\n1967\t+            counts[\"authority_violation\"] + counts[\"attenuation_violation\"],\n1968\t+        \"nonfatal_events\": nonfatal,\n1969\t+        \"meta_tool_observations\": counts[\"meta_tool_observation\"],\n1970\t+        \"observed_governance_risk\": round(g_obs, 4),\n1971\t+    }\n1972\tdiff --git a/.creator-zero/topology-theory/ingest.py b/.creator-zero/topology-theory/ingest.py\n1973\tnew file mode 100644\n1974\tindex 0000000..7be2797\n1975\t--- /dev/null\n1976\t+++ b/.creator-zero/topology-theory/ingest.py\n1977\t@@ -0,0 +1,174 @@\n1978\t+\"\"\"Evidence import layer: pinned source, deterministic enrichment,\n1979\t+idempotent append into the append-only theory store.\n1980\t+\n1981\t+    verify_source_pin(path, pin)               -> typed PASS/FAIL record\n1982\t+    enrich_e6_events(raw_events, pins, ...)    -> v2 evidence dicts\n1983\t+    ingest_evidence(store, events, ...)        -> import manifest\n1984\t+\n1985\t+Idempotence contract (per event e):\n1986\t+    e.event_id not in store                       -> append\n1987\t+    same id, identical normalized content         -> skip\n1988\t+    same id, different content                    -> EVIDENCE_ID_CONFLICT\n1989\t+No previously written evidence line is ever rewritten; the running hash\n1990\t+chain remains the tamper-evidence.\n1991\t+\"\"\"\n1992\t+from __future__ import annotations\n1993\t+import hashlib\n1994\t+import json\n1995\t+from pathlib import Path\n1996\t+from typing import Any, Optional\n1997\t+\n1998\t+from .admissibility import E6_CLASS_TO_KIND\n1999\t+from .model import ModelValidationError, PrincipleEvidence\n2000\t+from .serialization import file_artifact_id\n2001\t+\n2002\t+\n2003\t+class EvidenceImportError(RuntimeError):\n2004\t+    \"\"\"Typed import failure (source pin mismatch, id conflict).\"\"\"\n2005\t+\n2006\t+\n2007\t+def normalized_event_hash(d: dict[str, Any]) -> str:\n2008\t+    \"\"\"Content hash over the closed canonical form of an evidence event.\"\"\"\n2009\t+    canon = PrincipleEvidence.from_dict(d).to_dict()\n2010\t+    return hashlib.sha256(json.dumps(canon, sort_keys=True,\n2011\t+                          separators=(\",\", \":\")).encode(\"utf-8\")).hexdigest()\n2012\t+\n2013\t+\n2014\t+def load_source_events(path: str | Path) -> list[dict[str, Any]]:\n2015\t+    out = []\n2016\t+    for i, line in enumerate(Path(path).read_text(\n2017\t+            encoding=\"utf-8\").splitlines()):\n2018\t+        if not line.strip():\n2019\t+            continue\n2020\t+        try:\n2021\t+            out.append(json.loads(line))\n2022\t+        except json.JSONDecodeError as e:\n2023\t+            raise EvidenceImportError(f\"source line {i} unparseable: {e}\")\n2024\t+    return out\n2025\t+\n2026\t+\n2027\t+def verify_source_pin(path: str | Path, pin: dict[str, Any]\n2028\t+                      ) -> dict[str, Any]:\n2029\t+    \"\"\"The import source must byte-match its Phase A pin.\"\"\"\n2030\t+    p = Path(path)\n2031\t+    got = hashlib.sha256(p.read_bytes()).hexdigest()\n2032\t+    events = load_source_events(p)\n2033\t+    ids = [e.get(\"event_id\") for e in events]\n2034\t+    checks = {\n2035\t+        \"sha256\": got == pin[\"sha256\"],\n2036\t+        \"event_count\": len(events) == int(pin[\"expected_event_count\"]),\n2037\t+        \"unique_event_ids\": len(set(ids)) ==\n2038\t+        int(pin[\"expected_unique_event_ids\"]),\n2039\t+    }\n2040\t+    ok = all(checks.values())\n2041\t+    return {\"check\": \"evidence_source_pin\",\n2042\t+            \"status\": \"PASS\" if ok else \"FAIL\",\n2043\t+            \"failure_code\": None if ok else \"EVIDENCE_SOURCE_MISMATCH\",\n2044\t+            \"observed\": {\"sha256\": got, \"event_count\": len(events),\n2045\t+                         \"unique_event_ids\": len(set(ids))},\n2046\t+            \"pinned\": {k: pin[k] for k in (\"sha256\", \"expected_event_count\",\n2047\t+                                           \"expected_unique_event_ids\")},\n2048\t+            \"clauses\": checks}\n2049\t+\n2050\t+\n2051\t+def enrich_e6_events(raw_events: list[dict[str, Any]],\n2052\t+                     labels_by_trial: dict[str, dict[str, Any]],\n2053\t+                     *, source_commit: str, source_path: str,\n2054\t+                     source_artifact_id: str,\n2055\t+                     ) -> list[dict[str, Any]]:\n2056\t+    \"\"\"Deterministic enrichment of frozen E6 events with provenance/context.\n2057\t+\n2058\t+    The join is trial_id -> frozen private label -> admissibility kind. The\n2059\t+    frozen labels are truth artifacts: nothing here rewrites them, and an\n2060\t+    event whose join fails gets context_status=UNKNOWN (it cannot support a\n2061\t+    context-conditioned split dimension).\"\"\"\n2062\t+    out = []\n2063\t+    for raw in raw_events:\n2064\t+        e = dict(raw)\n2065\t+        e.setdefault(\"source_experiment\", \"experiment-6\")\n2066\t+        e.setdefault(\"source_commit\", source_commit)\n2067\t+        e.setdefault(\"source_artifact_id\", source_artifact_id)\n2068\t+        trial = e.get(\"trial_id\", \"\")\n2069\t+        label = labels_by_trial.get(trial)\n2070\t+        if label is not None and label.get(\"latent_class\") in \\\n2071\t+                E6_CLASS_TO_KIND:\n2072\t+            cls = label[\"latent_class\"]\n2073\t+            e[\"context\"] = {\n2074\t+                \"context_status\": \"OK\",\n2075\t+                \"latent_class\": cls,\n2076\t+                \"admissibility_kind\": E6_CLASS_TO_KIND[cls],\n2077\t+                \"join_source\": {\n2078\t+                    \"path\": f\".creator-zero/experiment-6/task-bank/{trial}/\"\n2079\t+                            \"private/label.json\",\n2080\t+                    \"join_key\": \"trial_id\",\n2081\t+                    \"source_path\": source_path,\n2082\t+                },\n2083\t+            }\n2084\t+        else:\n2085\t+            e[\"context\"] = {\"context_status\": \"UNKNOWN\"}\n2086\t+        # closed-schema validation: unknown fields fail loudly, nothing is\n2087\t+        # silently stripped (NC6)\n2088\t+        out.append(PrincipleEvidence.from_dict(e).to_dict())\n2089\t+    return out\n2090\t+\n2091\t+\n2092\t+def ingest_evidence(store, events: list[dict[str, Any]],\n2093\t+                    import_manifest: Optional[dict[str, Any]] = None,\n2094\t+                    ) -> dict[str, Any]:\n2095\t+    \"\"\"Idempotent append of validated evidence events into the store.\"\"\"\n2096\t+    head_before = store.evidence_head()\n2097\t+    existing: dict[str, str] = {}\n2098\t+    for ev in store.read_evidence():\n2099\t+        d = ev.to_dict()\n2100\t+        existing[d[\"event_id\"]] = normalized_event_hash(d)\n2101\t+\n2102\t+    imported, skipped, conflicts = [], [], []\n2103\t+    for e in events:\n2104\t+        try:\n2105\t+            canon = PrincipleEvidence.from_dict(e).to_dict()\n2106\t+        except ModelValidationError as exc:\n2107\t+            raise EvidenceImportError(f\"invalid evidence event \"\n2108\t+                                      f\"{e.get('event_id')!r}: {exc}\")\n2109\t+        eid = canon[\"event_id\"]\n2110\t+        h = normalized_event_hash(canon)\n2111\t+        if eid in existing:\n2112\t+            if existing[eid] == h:\n2113\t+                skipped.append(eid)\n2114\t+                continue\n2115\t+            conflicts.append(eid)\n2116\t+            raise EvidenceImportError(\n2117\t+                f\"EVIDENCE_ID_CONFLICT: event {eid!r} already stored with \"\n2118\t+                \"different content; append-only history cannot be rewritten\")\n2119\t+        store.append_evidence(canon)\n2120\t+        existing[eid] = h\n2121\t+        imported.append(eid)\n2122\t+\n2123\t+    head_after = store.evidence_head()\n2124\t+    chain = store.verify_append_only()\n2125\t+    doc = {\n2126\t+        \"artifact\": \"evidence import manifest\",\n2127\t+        \"imported\": len(imported),\n2128\t+        \"skipped_identical\": len(skipped),\n2129\t+        \"conflicts\": len(conflicts),\n2130\t+        \"evidence_head_before\": {\"length\": head_before[0],\n2131\t+                                 \"hash\": head_before[1]},\n2132\t+        \"evidence_head_after\": {\"length\": head_after[0],\n2133\t+                                \"hash\": head_after[1]},\n2134\t+        \"append_only_intact\": chain[\"append_only_intact\"],\n2135\t+        \"imported_event_ids_sha256\": hashlib.sha256(\n2136\t+            json.dumps(imported, separators=(\",\", \":\")).encode()\n2137\t+        ).hexdigest(),\n2138\t+    }\n2139\t+    if import_manifest:\n2140\t+        doc.update({k: v for k, v in import_manifest.items()\n2141\t+                    if k not in doc})\n2142\t+    return doc\n2143\t+\n2144\t+\n2145\t+def pin_source_artifact(path: str | Path, provenance: str) -> dict[str, Any]:\n2146\t+    p = Path(path)\n2147\t+    return {\n2148\t+        \"path\": str(path),\n2149\t+        \"sha256\": hashlib.sha256(p.read_bytes()).hexdigest(),\n2150\t+        \"artifact_id\": file_artifact_id(p, provenance),\n2151\t+    }\n2152\tdiff --git a/.creator-zero/topology-theory/model.py b/.creator-zero/topology-theory/model.py\n2153\tindex ae132ca..f2b912a 100644\n2154\t--- a/.creator-zero/topology-theory/model.py\n2155\t+++ b/.creator-zero/topology-theory/model.py\n2156\t@@ -73,6 +73,7 @@ class Principle:\n2157\t     contradicting_evidence: list[dict[str, Any]] = field(default_factory=list)\n2158\t     parent_principles: list[str] = field(default_factory=list)\n2159\t     version: int = 1\n2160\t+    falsifier: str = \"\"                 # explicit falsification condition\n2161\t \n2162\t     def __post_init__(self):\n2163\t         _require(bool(self.id) and self.id.startswith(\"P-\"),\n2164\t@@ -97,18 +98,34 @@ class Principle:\n2165\t \n2166\t @dataclass\n2167\t class PrincipleEvidence:\n2168\t-    \"\"\"Append-only evidence event linking a principle to an observed outcome.\"\"\"\n2169\t+    \"\"\"Append-only evidence event linking a principle to an observed outcome.\n2170\t+\n2171\t+    Schema v2 (backward compatible): optional provenance/context fields\n2172\t+    preserve WHERE a principle held or failed — source experiment/commit,\n2173\t+    trial and run identity, and a deterministic context object (e.g. the\n2174\t+    admissibility kind joined from frozen truth artifacts). Historical v1\n2175\t+    events (a subset of the known fields) remain readable; unknown top-level\n2176\t+    fields are a typed rejection, never a silent drop — a parser that strips\n2177\t+    context cannot pass validation.\"\"\"\n2178\t     principle_id: str\n2179\t     topology_id: str\n2180\t     prediction_id: str\n2181\t     effect: str\n2182\t     evidence_refs: list[dict[str, Any]] = field(default_factory=list)\n2183\t     event_id: str = \"\"\n2184\t+    source_experiment: str = \"\"\n2185\t+    source_commit: str = \"\"\n2186\t+    trial_id: str = \"\"\n2187\t+    run: str = \"\"\n2188\t+    context: dict[str, Any] = field(default_factory=dict)\n2189\t+    source_artifact_id: str = \"\"\n2190\t \n2191\t     def __post_init__(self):\n2192\t         _require(self.effect in EVIDENCE_EFFECTS,\n2193\t                  f\"invalid evidence effect {self.effect!r}\")\n2194\t         _require(bool(self.principle_id), \"evidence missing principle_id\")\n2195\t+        _require(isinstance(self.context, dict),\n2196\t+                 \"evidence context must be an object\")\n2197\t \n2198\t     def to_dict(self) -> dict[str, Any]:\n2199\t         return asdict(self)\n2200\t@@ -117,6 +134,11 @@ class PrincipleEvidence:\n2201\t     def from_dict(cls, d: dict[str, Any]) -> \"PrincipleEvidence\":\n2202\t         _require_keys(d, (\"principle_id\", \"topology_id\", \"prediction_id\",\n2203\t                           \"effect\"), \"principle evidence\")\n2204\t+        unknown = sorted(set(d) - set(cls.__dataclass_fields__))\n2205\t+        _require(not unknown,\n2206\t+                 f\"principle evidence carries unknown top-level fields \"\n2207\t+                 f\"{unknown}: contextual fields must be modeled, not \"\n2208\t+                 \"silently discarded\")\n2209\t         return cls(**{k: d[k] for k in cls.__dataclass_fields__ if k in d})\n2210\t \n2211\t \n2212\t@@ -206,6 +228,7 @@ class Revision:\n2213\t     motivating_evidence: list[str] = field(default_factory=list)\n2214\t     historical_cases_affected: list[str] = field(default_factory=list)\n2215\t     changed_predictions: list[str] = field(default_factory=list)\n2216\t+    context_partition: dict[str, Any] = field(default_factory=dict)\n2217\t     status: str = \"CANDIDATE\"\n2218\t \n2219\t     def __post_init__(self):\n2220\tdiff --git a/.creator-zero/topology-theory/predict2.py b/.creator-zero/topology-theory/predict2.py\n2221\tnew file mode 100644\n2222\tindex 0000000..9f23ef5\n2223\t--- /dev/null\n2224\t+++ b/.creator-zero/topology-theory/predict2.py\n2225\t@@ -0,0 +1,73 @@\n2226\t+\"\"\"Prediction freezing v2: typed principle attribution + role predictions.\n2227\t+\n2228\t+Wraps the promoted freeze_predictions: same falsifier-complete mechanical\n2229\t+prediction kinds, but (a) per-distinction resolution predictions are\n2230\t+attributed to the typed principle matching the distinction's required\n2231\t+admissibility kind, and (b) every non-local evidence provision gets a\n2232\t+mechanical role prediction (FAILED when the runtime records ROLE_TYPE_FAIL —\n2233\t+right graph shape with the wrong epistemic role falsifies the typed\n2234\t+principle instead of silently passing). Hash-freezing semantics unchanged.\n2235\t+\"\"\"\n2236\t+from __future__ import annotations\n2237\t+from typing import Any\n2238\t+\n2239\t+from .admissibility import requirement_for_distinction\n2240\t+from .model import Prediction, TopologyHypothesis\n2241\t+from .predict import freeze_predictions, predictions_hash\n2242\t+\n2243\t+KIND_TO_PRINCIPLE = {\n2244\t+    \"LOCAL\": \"P-LOCALITY\",\n2245\t+    \"CLEAN_ROOM_AUTHORSHIP\": \"P-AUTHORSHIP-INDEPENDENCE\",\n2246\t+    \"NON_AUTHOR_SEARCH\": \"P-NONAUTHOR-SEARCH\",\n2247\t+    \"INDEPENDENT_DECOMPOSITION\": \"P-INDEPENDENT-DECOMPOSITION\",\n2248\t+    \"METHOD_DISJOINT_VERIFICATION\": \"P-METHOD-DISJOINT-VERIFICATION\",\n2249\t+}\n2250\t+\n2251\t+\n2252\t+def freeze_predictions_v2(topology: TopologyHypothesis,\n2253\t+                          distinctions: list[dict[str, Any]],\n2254\t+                          ) -> list[Prediction]:\n2255\t+    preds = freeze_predictions(topology, distinctions)\n2256\t+    kind_by_q = {d[\"id\"]: requirement_for_distinction(d).kind\n2257\t+                 for d in distinctions}\n2258\t+\n2259\t+    for p in preds:\n2260\t+        if p.kind == \"resolves\":\n2261\t+            q = p.subject.get(\"distinction_id\")\n2262\t+            p.principles = [KIND_TO_PRINCIPLE[kind_by_q.get(q, \"LOCAL\")]]\n2263\t+\n2264\t+    tid = topology.topology_id\n2265\t+    n = len(preds)\n2266\t+    for prov in topology.harness_spec.get(\"evidence_provisions\", []):\n2267\t+        role = prov[\"role\"]\n2268\t+        if role == \"local_author\":\n2269\t+            continue\n2270\t+        n += 1\n2271\t+        # principle of the provision's role: the kind it uniquely serves\n2272\t+        role_kind = {\n2273\t+            \"clean_room_author\": \"CLEAN_ROOM_AUTHORSHIP\",\n2274\t+            \"non_author_examiner\": \"NON_AUTHOR_SEARCH\",\n2275\t+            \"independent_decomposer\": \"INDEPENDENT_DECOMPOSITION\",\n2276\t+            \"method_disjoint_verifier\": \"METHOD_DISJOINT_VERIFICATION\",\n2277\t+        }[role]\n2278\t+        preds.append(Prediction(\n2279\t+            prediction_id=f\"{tid}-pr{n:02d}\",\n2280\t+            topology_id=tid,\n2281\t+            claim=f\"the independent path at node {prov['node_id']} realizes \"\n2282\t+                  f\"canonical role {role}\",\n2283\t+            observable=\"realized role typing in the runtime record \"\n2284\t+                       \"(ROLE_TYPE_FAIL formal failure on mismatch)\",\n2285\t+            success_condition=f\"realized role of {prov['node_id']} equals \"\n2286\t+                              f\"{role} and no ROLE_TYPE failure is recorded\",\n2287\t+            falsification_condition=\"the realized path's canonical role \"\n2288\t+                                    f\"differs from {role} \"\n2289\t+                                    \"(ROLE_TYPE_FAIL recorded)\",\n2290\t+            weight=1.0, kind=\"verification_effect\",\n2291\t+            subject={\"checks\": [\"ROLE_TYPE\"], \"node\": prov[\"node_id\"],\n2292\t+                     \"role\": role},\n2293\t+            principles=[KIND_TO_PRINCIPLE[role_kind]],\n2294\t+        ))\n2295\t+\n2296\t+    topology.predictions = [p.to_dict() for p in preds]\n2297\t+    topology.predictions_hash = predictions_hash(tid, topology.predictions)\n2298\t+    return preds\n2299\tdiff --git a/.creator-zero/topology-theory/replay-corpus-e6.json b/.creator-zero/topology-theory/replay-corpus-e6.json\n2300\tnew file mode 100644\n2301\tindex 0000000..c6abb25\n2302\t--- /dev/null\n2303\t+++ b/.creator-zero/topology-theory/replay-corpus-e6.json\n2304\t@@ -0,0 +1,48 @@\n2305\t+{\n2306\t+  \"artifact\": \"topology-theory historical replay corpus \\u2014 Experiment 6 frozen cases (E7 extension)\",\n2307\t+  \"note\": \"Frozen E6 regression cases for candidate theta revisions. Replay semantics identical to the v0.1 corpus: a candidate that retires or contradicts a required principle is CONTRADICTED. REVISED is an active status, so a SPLIT that keeps the parent grounded stays compatible. These cases are regression checks, not held-out validation.\",\n2308\t+  \"cases\": [\n2309\t+    {\n2310\t+      \"case_id\": \"E6-clean-room-authorship\",\n2311\t+      \"summary\": \"E6 e6-t01 (ISOLATION): a clean-room child authored solely from the description resolved the admissibility-critical distinctions; the frozen record supports isolation-for-authorship under P-INDEPENDENCE with enforced freshness.\",\n2312\t+      \"required_active_principles\": [\n2313\t+        \"P-INDEPENDENCE\",\n2314\t+        \"P-FRESHNESS\"\n2315\t+      ],\n2316\t+      \"historical_outcome\": \"clean_room_implementer child, fresh launch, verified integration\",\n2317\t+      \"pinned_artifacts\": {\n2318\t+        \"experiment-6/task-bank/e6-t01/private/label.json\": \"ec1171b3ac598c34f7eacd456e543df92110b713b6fede0d8bfec95646884eb9\",\n2319\t+        \"experiment-6/trials/e6-t01/child/integration-plan.json\": \"ad12b4d1e0a52f1284a02153ea76ad9f5931e541d9821de646f755caec092f9b\",\n2320\t+        \"experiment-6/trials/e6-t01/verification.json\": \"1d596c6423f75469ea916bed3dda72f14d56c9d2eadde30094d7e59a9acaa43e\"\n2321\t+      }\n2322\t+    },\n2323\t+    {\n2324\t+      \"case_id\": \"E6-examiner-cheaper-than-child\",\n2325\t+      \"summary\": \"E6 e6-t08 (COUNTEREXAMPLE): the runner-up examiner shadow achieved strictly higher observed utility than the selected isolated child on the same search requirement \\u2014 the calibration/regret evidence motivating the typed revision.\",\n2326\t+      \"required_active_principles\": [\n2327\t+        \"P-INDEPENDENCE\",\n2328\t+        \"P-MINIMALITY\"\n2329\t+      ],\n2330\t+      \"historical_outcome\": \"shadow observed utility > selected observed utility; regret > 0\",\n2331\t+      \"pinned_artifacts\": {\n2332\t+        \"experiment-6/task-bank/e6-t08/private/label.json\": \"14c0080db21a0447e70fa015f850c50cf181052d85af5abfe950c078298fd3d2\",\n2333\t+        \"experiment-6/trials/e6-t08/calibration.json\": \"a5f2b1311c7d094bca6d9ba41061c7786c930a6687c6455aba8137e638889efc\",\n2334\t+        \"experiment-6/trials/e6-t08/shadow/calibration.json\": \"79c69bdbae42ae6a42c532ace2b37f9b4559602835611f41e2acb97fa3cb8e06\"\n2335\t+      }\n2336\t+    },\n2337\t+    {\n2338\t+      \"case_id\": \"E6-local-sufficiency\",\n2339\t+      \"summary\": \"E6 e6-t02 (LOCAL): local resolution verified with zero descendants; forced extra structure would have duplicated local evidence.\",\n2340\t+      \"required_active_principles\": [\n2341\t+        \"P-LOCALITY\",\n2342\t+        \"P-MINIMALITY\"\n2343\t+      ],\n2344\t+      \"historical_outcome\": \"TOPOLOGY_CORRECT local selection, zero child launches\",\n2345\t+      \"pinned_artifacts\": {\n2346\t+        \"experiment-6/task-bank/e6-t02/private/label.json\": \"ef7ccda1344bcaaf669b5958a380ba62675f9f80b7869d655c59f49c8d8ef46b\",\n2347\t+        \"experiment-6/trials/e6-t02/trial-score.json\": \"25abcd7381c58e406dae2529755322b0a6be21c2690818890fa53de680cb74e4\",\n2348\t+        \"experiment-6/trials/e6-t02/calibration.json\": \"9d9576a3c1f1a7c14f8e85a75ad58afafe36b058c0dc97dd23485b920e5b9c3f\"\n2349\t+      }\n2350\t+    }\n2351\t+  ]\n2352\t+}\n2353\tdiff --git a/.creator-zero/topology-theory/revise2.py b/.creator-zero/topology-theory/revise2.py\n2354\tnew file mode 100644\n2355\tindex 0000000..78a493c\n2356\t--- /dev/null\n2357\t+++ b/.creator-zero/topology-theory/revise2.py\n2358\t@@ -0,0 +1,375 @@\n2359\t+\"\"\"Evidence-conditioned revision engine v2: context-aware candidate family.\n2360\t+\n2361\t+Builds on the existing revision algebra (model.Revision, revise.apply_revision;\n2362\t+SPLIT was already recognized) — no second incompatible mechanism. What v2\n2363\t+adds, per the frozen Experiment 7 preregistration §6:\n2364\t+\n2365\t+    context_stats()          SUPPORT/FALSIFY per admissibility context\n2366\t+    split_trigger()          evidence-grounded SPLIT eligibility\n2367\t+    build_candidates()       {no-change, SPECIALIZE, SPLIT, DEPRECATE}\n2368\t+    explanation_scores()     frozen deterministic explanation scoring\n2369\t+    propose_revision_v2()    scored, deterministic selection\n2370\t+\n2371\t+Nothing here promotes anything: every produced Revision is CANDIDATE and the\n2372\t+successor TheoryVersion built from it stays CANDIDATE until the final theory\n2373\t+Gate. Wording of candidate principles may be model-drafted, but it enters\n2374\t+only as serialized text validated structurally; partitioning, scoring, and\n2375\t+selection are deterministic. 'Split because the operator said so' is\n2376\t+impossible: the trigger demands mixed evidence occupying >=2 reproducible\n2377\t+contexts with a support-rate spread.\n2378\t+\"\"\"\n2379\t+from __future__ import annotations\n2380\t+from typing import Any, Optional\n2381\t+\n2382\t+from .model import (ModelValidationError, Principle, Revision, TheoryVersion)\n2383\t+from .admissibility import KIND_REQUIREMENT\n2384\t+\n2385\t+# Frozen rule constants (preregistration §6; never tuned after Phase A)\n2386\t+FROZEN_RULES = {\n2387\t+    \"min_context_events\": 4,\n2388\t+    \"min_spread\": 0.3,\n2389\t+    \"min_context_coverage\": 0.9,\n2390\t+    \"reproducibility_floor\": 2,\n2391\t+    \"specialize_max_falsify_rate\": 0.2,\n2392\t+}\n2393\t+\n2394\t+# Preregistered split basis for P-INDEPENDENCE: context kind -> child spec\n2395\t+SPLIT_BASIS = {\n2396\t+    \"P-INDEPENDENCE\": {\n2397\t+        \"CLEAN_ROOM_AUTHORSHIP\": {\n2398\t+            \"id\": \"P-AUTHORSHIP-INDEPENDENCE\",\n2399\t+            \"feature\": \"requires_clean_room_authorship\",\n2400\t+            \"role\": \"clean_room_author\",\n2401\t+        },\n2402\t+        \"NON_AUTHOR_SEARCH\": {\n2403\t+            \"id\": \"P-NONAUTHOR-SEARCH\",\n2404\t+            \"feature\": \"requires_nonauthor_search\",\n2405\t+            \"role\": \"non_author_examiner\",\n2406\t+        },\n2407\t+        \"INDEPENDENT_DECOMPOSITION\": {\n2408\t+            \"id\": \"P-INDEPENDENT-DECOMPOSITION\",\n2409\t+            \"feature\": \"requires_independent_decomposition\",\n2410\t+            \"role\": \"independent_decomposer\",\n2411\t+        },\n2412\t+        \"METHOD_DISJOINT_VERIFICATION\": {\n2413\t+            \"id\": \"P-METHOD-DISJOINT-VERIFICATION\",\n2414\t+            \"feature\": \"requires_method_disjoint_verification\",\n2415\t+            \"role\": \"method_disjoint_verifier\",\n2416\t+        },\n2417\t+    },\n2418\t+}\n2419\t+\n2420\t+_DEFAULT_STATEMENTS = {\n2421\t+    \"P-AUTHORSHIP-INDEPENDENCE\":\n2422\t+        \"When a distinction's admissibility requires clean-room authorship \"\n2423\t+        \"(evidence authored without access to a contaminating reference), \"\n2424\t+        \"only an isolated fresh descendant authoring solely from the \"\n2425\t+        \"sanctioned description supplies admissible evidence; examiner \"\n2426\t+        \"review of contaminated work cannot.\",\n2427\t+    \"P-NONAUTHOR-SEARCH\":\n2428\t+        \"When a distinction requires a search for violating inputs by a \"\n2429\t+        \"party that did not author the candidate answer, an information-\"\n2430\t+        \"only independent examiner supplies admissible evidence; full \"\n2431\t+        \"clean-room isolation satisfies the same requirement at strictly \"\n2432\t+        \"higher cost and adds no admissible value.\",\n2433\t+    \"P-INDEPENDENT-DECOMPOSITION\":\n2434\t+        \"When completeness of an enumeration or decomposition is admissible \"\n2435\t+        \"only via a second decomposition produced without access to the \"\n2436\t+        \"first, an isolated independent decomposer is required; review or \"\n2437\t+        \"re-verification of the first decomposition is inadmissible for \"\n2438\t+        \"that distinction.\",\n2439\t+    \"P-METHOD-DISJOINT-VERIFICATION\":\n2440\t+        \"When correctness must be established by re-derivation through a \"\n2441\t+        \"method disjoint from the primary method, a method-disjoint \"\n2442\t+        \"verifier path supplies the admissible evidence; isolation without \"\n2443\t+        \"method disjointness is insufficient, and method-sharing review is \"\n2444\t+        \"inadmissible.\",\n2445\t+}\n2446\t+\n2447\t+_DEFAULT_FALSIFIERS = {\n2448\t+    \"P-AUTHORSHIP-INDEPENDENCE\":\n2449\t+        \"a reference-exposed path yields evidence scored admissible for a \"\n2450\t+        \"clean-room distinction, or the isolated clean-room author fails \"\n2451\t+        \"to add admissible value where the requirement is present\",\n2452\t+    \"P-NONAUTHOR-SEARCH\":\n2453\t+        \"the independent examiner's search is scored inadmissible where \"\n2454\t+        \"predicted admissible, or an isolated child strictly outperforms \"\n2455\t+        \"the examiner on the same search requirement at equal \"\n2456\t+        \"admissibility and equal coverage\",\n2457\t+    \"P-INDEPENDENT-DECOMPOSITION\":\n2458\t+        \"a decomposition produced with access to the first is scored \"\n2459\t+        \"admissible, or the isolated decomposer duplicates the first \"\n2460\t+        \"decomposition without novel enumeration evidence\",\n2461\t+    \"P-METHOD-DISJOINT-VERIFICATION\":\n2462\t+        \"a method-sharing verification is scored admissible for a \"\n2463\t+        \"method-disjoint distinction, or the method-disjoint verifier \"\n2464\t+        \"fails to add admissible value where the requirement is present\",\n2465\t+}\n2466\t+\n2467\t+\n2468\t+def context_stats(events: list[Any], principle_id: str) -> dict[str, Any]:\n2469\t+    \"\"\"SUPPORT/FALSIFY/CHALLENGE counts per resolved admissibility context.\"\"\"\n2470\t+    ctx: dict[str, dict[str, Any]] = {}\n2471\t+    unresolved = 0\n2472\t+    total = 0\n2473\t+    for e in events:\n2474\t+        d = e.to_dict() if hasattr(e, \"to_dict\") else dict(e)\n2475\t+        if d.get(\"principle_id\") != principle_id:\n2476\t+            continue\n2477\t+        total += 1\n2478\t+        c = (d.get(\"context\") or {})\n2479\t+        kind = c.get(\"admissibility_kind\")\n2480\t+        if c.get(\"context_status\") != \"OK\" or not kind:\n2481\t+            unresolved += 1\n2482\t+            continue\n2483\t+        slot = ctx.setdefault(kind, {\"SUPPORT\": 0, \"CHALLENGE\": 0,\n2484\t+                                     \"FALSIFY\": 0, \"event_ids\": []})\n2485\t+        slot[d[\"effect\"]] += 1\n2486\t+        slot[\"event_ids\"].append(d.get(\"event_id\") or d[\"prediction_id\"])\n2487\t+    for slot in ctx.values():\n2488\t+        slot[\"event_ids\"] = sorted(slot[\"event_ids\"])\n2489\t+        sf = slot[\"SUPPORT\"] + slot[\"FALSIFY\"]\n2490\t+        slot[\"support_rate\"] = round(slot[\"SUPPORT\"] / sf, 4) if sf else None\n2491\t+        slot[\"falsify_rate\"] = round(slot[\"FALSIFY\"] / sf, 4) if sf else None\n2492\t+    return {\"principle_id\": principle_id, \"total_events\": total,\n2493\t+            \"unresolved_context_events\": unresolved, \"contexts\": ctx}\n2494\t+\n2495\t+\n2496\t+def split_trigger(stats: dict[str, Any],\n2497\t+                  rules: dict[str, Any] = FROZEN_RULES) -> dict[str, Any]:\n2498\t+    ctx = stats[\"contexts\"]\n2499\t+    total = stats[\"total_events\"]\n2500\t+    support = sum(c[\"SUPPORT\"] for c in ctx.values())\n2501\t+    falsify = sum(c[\"FALSIFY\"] for c in ctx.values())\n2502\t+    coverage = ((total - stats[\"unresolved_context_events\"]) / total\n2503\t+                if total else 0.0)\n2504\t+    qualifying = {k: c for k, c in ctx.items()\n2505\t+                  if (c[\"SUPPORT\"] + c[\"CHALLENGE\"] + c[\"FALSIFY\"])\n2506\t+                  >= rules[\"min_context_events\"]}\n2507\t+    rates = [c[\"support_rate\"] for c in qualifying.values()\n2508\t+             if c[\"support_rate\"] is not None]\n2509\t+    spread = (max(rates) - min(rates)) if len(rates) >= 2 else 0.0\n2510\t+    clauses = {\n2511\t+        \"mixed_evidence\": support >= 1 and falsify >= 1,\n2512\t+        \"context_coverage\": coverage >= rules[\"min_context_coverage\"],\n2513\t+        \"enough_contexts\": len(qualifying) >= 2,\n2514\t+        \"support_rate_spread\": spread >= rules[\"min_spread\"],\n2515\t+    }\n2516\t+    return {\"eligible\": all(clauses.values()), \"clauses\": clauses,\n2517\t+            \"qualifying_contexts\": sorted(qualifying),\n2518\t+            \"support_rate_spread\": round(spread, 4),\n2519\t+            \"context_coverage\": round(coverage, 4)}\n2520\t+\n2521\t+\n2522\t+def _validate_split_children(children: list[dict[str, Any]]) -> None:\n2523\t+    ids = [c[\"id\"] for c in children]\n2524\t+    if len(ids) != len(set(ids)):\n2525\t+        raise ModelValidationError(\"split children must have unique ids\")\n2526\t+    pre = [tuple(c[\"preconditions\"]) for c in children]\n2527\t+    eff = [tuple(c[\"predicted_topology_effects\"]) for c in children]\n2528\t+    if len(set(pre)) != len(pre) or len(set(eff)) != len(eff):\n2529\t+        raise ModelValidationError(\n2530\t+            \"split children are semantic duplicates (identical \"\n2531\t+            \"preconditions or predicted effects)\")\n2532\t+    for c in children:\n2533\t+        if not str(c.get(\"falsifier\", \"\")).strip():\n2534\t+            raise ModelValidationError(\n2535\t+                f\"split child {c['id']} lacks an explicit falsifier\")\n2536\t+        if not c.get(\"supporting_evidence\"):\n2537\t+            raise ModelValidationError(\n2538\t+                f\"split child {c['id']} lacks motivating evidence\")\n2539\t+        Principle.from_dict(c)      # closed-schema validation\n2540\t+\n2541\t+\n2542\t+def build_split_candidate(theory: TheoryVersion, pid: str,\n2543\t+                          stats: dict[str, Any],\n2544\t+                          wording: Optional[dict[str, str]] = None,\n2545\t+                          rules: dict[str, Any] = FROZEN_RULES,\n2546\t+                          ) -> Revision:\n2547\t+    basis = SPLIT_BASIS.get(pid)\n2548\t+    if basis is None:\n2549\t+        raise ModelValidationError(f\"no preregistered split basis for {pid}\")\n2550\t+    trigger = split_trigger(stats, rules)\n2551\t+    if not trigger[\"eligible\"]:\n2552\t+        raise ModelValidationError(\n2553\t+            f\"split trigger not satisfied for {pid}: {trigger['clauses']}\")\n2554\t+    wording = wording or {}\n2555\t+    children = []\n2556\t+    partition = {}\n2557\t+    motivating: list[str] = []\n2558\t+    for kind in sorted(stats[\"contexts\"]):\n2559\t+        c = stats[\"contexts\"][kind]\n2560\t+        n = c[\"SUPPORT\"] + c[\"CHALLENGE\"] + c[\"FALSIFY\"]\n2561\t+        if n < rules[\"min_context_events\"] or kind not in basis:\n2562\t+            continue\n2563\t+        spec = basis[kind]\n2564\t+        cid = spec[\"id\"]\n2565\t+        stmt = wording.get(cid, _DEFAULT_STATEMENTS[cid])\n2566\t+        if len(stmt.strip()) < 40:\n2567\t+            raise ModelValidationError(\n2568\t+                f\"candidate principle {cid} wording too thin\")\n2569\t+        vec, roles = KIND_REQUIREMENT[kind]\n2570\t+        children.append({\n2571\t+            \"id\": cid,\n2572\t+            \"statement\": stmt,\n2573\t+            \"status\": \"CANDIDATE\",\n2574\t+            \"scope\": [\"topology-decision\", \"verification\"],\n2575\t+            \"preconditions\": [f\"feature:{spec['feature']}\"],\n2576\t+            \"predicted_topology_effects\": [\n2577\t+                f\"adds an independent path with canonical role \"\n2578\t+                f\"{spec['role']}\",\n2579\t+                f\"that path's evidence is admissible for \"\n2580\t+                f\"{kind} distinctions (required vector {list(vec)})\",\n2581\t+                \"cheaper admissible paths dominate costlier ones at equal \"\n2582\t+                \"coverage (saturating value)\",\n2583\t+            ],\n2584\t+            \"supporting_evidence\": [\n2585\t+                {\"evidence_event_id\": eid,\n2586\t+                 \"context_kind\": kind,\n2587\t+                 \"source\": \"experiment-6 imported theory evidence\"}\n2588\t+                for eid in c[\"event_ids\"]],\n2589\t+            \"contradicting_evidence\": [],\n2590\t+            \"parent_principles\": [pid],\n2591\t+            \"version\": 1,\n2592\t+            \"falsifier\": _DEFAULT_FALSIFIERS[cid],\n2593\t+        })\n2594\t+        partition[kind] = {\"SUPPORT\": c[\"SUPPORT\"], \"FALSIFY\": c[\"FALSIFY\"],\n2595\t+                           \"CHALLENGE\": c[\"CHALLENGE\"],\n2596\t+                           \"event_ids\": c[\"event_ids\"]}\n2597\t+        motivating.extend(c[\"event_ids\"])\n2598\t+    _validate_split_children(children)\n2599\t+    return Revision("}]},"parent_tool_use_id":null,"session_id":"371b7f47-bc11-46c7-971a-b334740ebdc3","uuid":"0a21a499-a8e1-4e95-b449-3e75e87be027","timestamp":"2026-08-09T19:43:55.602Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-0/-home-user-creator-0/87cd2a2d-a4f9-585b-836f-2648df7a6284/scratchpad/e7/verifier-infra-ws/candidate-patch.diff","content":"+                n[\"id\"] = \"verify-method-disjoint\"\n+                n[\"instructions\"] = (\n+                    \"Information-only verifier re-derives the result through \"\n+                    \"a method family disjoint from the primary method; no \"\n+                    \"write, no promotion authority.\")\n+        for e in spec[\"edges\"]:\n+            for k in (\"source\", \"target\"):\n+                if e[k] == \"verify-independent\":\n+                    e[k] = \"verify-method-disjoint\"\n+        provisions = [(\"resolve-local\", \"local_author\", \"\"),\n+                      (\"verify-method-disjoint\", \"method_disjoint_verifier\",\n+                       \"disjoint\")]\n+    elif family in (\"isolated-clean-room-author\", \"isolated-decomposer\",\n+                    \"isolated-searcher\"):\n+        spec = _child_spec(task_id, contract)\n+        spec[\"child_role\"] = child_role\n+        spec[\"goal\"] = (f\"Isolated fresh child (canonical role {child_role}) \"\n+                        f\"resolves the typed distinctions of {task_id}\")\n+        provisions = [(\"observe-evidence\", \"local_author\", \"\"),\n+                      (\"child-return\", child_role, \"\")]\n+    elif family == \"branching\":\n+        spec = _branching_spec(task_id, contract)\n+        spec[\"child_role\"] = child_role\n+        provisions = [(\"local-resolve\", \"local_author\", \"\"),\n+                      (\"child-return\", child_role, \"\")]\n+    else:\n+        raise ValueError(f\"unknown v2 family {family!r}\")\n+    spec[\"evidence_provisions\"] = [\n+        provision_for_role(node, role, method_family=mf).to_dict()\n+        for node, role, mf in provisions]\n+    return spec\n+\n+\n+def generate_candidates_v2(task: dict[str, Any],\n+                           distinctions: list[dict[str, Any]],\n+                           applicable_principles: ApplicabilityResult | dict,\n+                           contract: dict[str, Any],\n+                           value_estimates: dict[str, float],\n+                           max_candidates: int = 6,\n+                           ) -> list[TopologyHypothesis]:\n+    \"\"\"Deterministic v2 generation: one minimal family per required kind\n+    plus one admissible alternative, plus `local` always (minimality\n+    baseline; inadmissible candidates are rejected downstream).\"\"\"\n+    if isinstance(applicable_principles, ApplicabilityResult):\n+        app = applicable_principles.to_dict()\n+    else:\n+        app = dict(applicable_principles)\n+    task_id = str(task.get(\"task_id\", task.get(\"id\", \"task\")))\n+    reqs = [requirement_for_distinction(d) for d in distinctions]\n+    needed = sorted({r.kind for r in reqs} - {\"LOCAL\"})\n+    allow_create = _contract_allows_create(contract)\n+\n+    plan: list[tuple[str, str]] = [(\"local\", \"\")]\n+    if not needed:\n+        plan.append((\"local-independent-examiner\", \"\"))\n+    for kind in needed:\n+        minimal, alt, role = KIND_FAMILIES[kind]\n+        plan.append((minimal, role))\n+        if alt != minimal:\n+            plan.append((alt, role))\n+    # deduplicate preserving order; drop create-bearing families when the\n+    # contract forbids creation\n+    seen = set()\n+    final_plan = []\n+    for fam, role in plan:\n+        key = (fam, role)\n+        if key in seen:\n+            continue\n+        seen.add(key)\n+        if fam.startswith(\"isolated\") or fam == \"branching\":\n+            if not allow_create:\n+                continue\n+        final_plan.append((fam, role))\n+\n+    out: list[TopologyHypothesis] = []\n+    invoked = sorted(a[\"principle_id\"] for a in app.get(\"applicable\", []))\n+    for fam, role in final_plan[:max(1, int(max_candidates))]:\n+        spec = _spec_for(fam, task_id, contract, role)\n+        spec[\"max_model_calls\"] = min(int(spec[\"max_model_calls\"]),\n+                                      int(contract.get(\"max_model_calls\", 1)))\n+        provisions = provisions_from_spec(spec)\n+        prov_by_kind: dict[str, str] = {}\n+        for r in reqs:\n+            for p in provisions:\n+                from .admissibility import admissible\n+                if admissible(p, r)[0]:\n+                    prov_by_kind[r.distinction_id] = p.node_id\n+                    break\n+        local_node = provisions[0].node_id\n+        resolution_map = {r.distinction_id:\n+                          prov_by_kind.get(r.distinction_id, local_node)\n+                          for r in reqs}\n+        m, c = FAMILY_CALLS_V2[fam]\n+        predicted = predicted_components(\n+            provisions, reqs, dict(value_estimates),\n+            model_sessions=m, child_sessions=c)\n+        adm = topology_admissible(provisions, reqs)\n+        spec[\"admissibility_precheck\"] = adm[\"admissible\"]\n+        tid = f\"H-{task_id}-{fam}\"\n+        falsifiers = [\n+            f\"a distinction in {sorted(resolution_map)} remains unresolved \"\n+            \"after execution\",\n+            \"the runtime path violates the compiled LTS\",\n+            \"actual model calls exceed the declared budget\",\n+            \"a realized independent path's canonical role differs from the \"\n+            \"declared evidence provision role\",\n+        ]\n+        if fam.startswith(\"isolated\") or fam == \"branching\":\n+            falsifiers.append(\"child evidence duplicates parent evidence \"\n+                              \"(no novel contribution)\")\n+        if fam == \"local\":\n+            falsifiers.append(\"local evidence proves insufficient \"\n+                              \"(verification impossible locally)\")\n+        out.append(TopologyHypothesis(\n+            topology_id=tid,\n+            task_id=task_id,\n+            unresolved_distinctions=[d[\"id\"] for d in distinctions],\n+            principles_invoked=invoked,\n+            harness_spec_ref=object_artifact_id(\n+                spec, f\"creator-0/topology-theory/harness/{tid}\"),\n+            harness_spec=spec,\n+            resolution_map=resolution_map,\n+            falsifiers=falsifiers,\n+            predicted_value=predicted,\n+            status=\"CANDIDATE\",\n+        ))\n+    return out\ndiff --git a/.creator-zero/topology-theory/governance.py b/.creator-zero/topology-theory/governance.py\nnew file mode 100644\nindex 0000000..2118c60\n--- /dev/null\n+++ b/.creator-zero/topology-theory/governance.py\n@@ -0,0 +1,139 @@\n+\"\"\"Governance taxonomy v2: typed classification of conformance events.\n+\n+Categories (frozen in experiment-7/governance-taxonomy-v2.json):\n+\n+    capability_violation      fatal   capability-bearing tool/scope breach\n+    authority_violation       fatal   non-gate promotion / escalation\n+    attenuation_violation     fatal   child contract exceeds envelope\n+    protocol_violation        -       preregistered protocol deviation\n+    instrumentation_violation -       ledger/label/refinement instrumentation\n+    meta_tool_observation     -       harness-injected schema/meta tool with\n+                                      no read/write/spawn capability\n+\n+A schema/meta-tool observation that grants no capability is never a\n+capability violation; unauthorized capability-bearing tools remain fatal.\n+Actual authority checks are not weakened anywhere. Experiment 6 is not\n+rescored by this module.\n+\"\"\"\n+from __future__ import annotations\n+from typing import Any\n+\n+TAXONOMY_VERSION = \"governance-taxonomy-v2\"\n+\n+CATEGORIES = (\"capability_violation\", \"authority_violation\",\n+              \"attenuation_violation\", \"protocol_violation\",\n+              \"instrumentation_violation\", \"meta_tool_observation\")\n+\n+FATAL_CATEGORIES = frozenset({\"capability_violation\", \"authority_violation\",\n+                              \"attenuation_violation\"})\n+\n+# Harness-injected meta/schema tools: observing their schemas grants no\n+# read/write/spawn capability. Spawn- or filesystem-capable tools are NEVER\n+# on this list.\n+META_TOOLS = frozenset({\"ToolSearch\", \"ListMcpResourcesTool\",\n+                        \"ReadMcpResourceTool\"})\n+\n+_WEIGHT = {\"capability_violation\": 0.25, \"authority_violation\": 0.25,\n+           \"attenuation_violation\": 0.25, \"protocol_violation\": 0.10,\n+           \"instrumentation_violation\": 0.10, \"meta_tool_observation\": 0.0}\n+\n+\n+def event(category: str, code: str, actor: str,\n+          evidence_refs: list[Any], detail: str = \"\") -> dict[str, Any]:\n+    if category not in CATEGORIES:\n+        raise ValueError(f\"unknown governance category {category!r}\")\n+    return {\n+        \"taxonomy\": TAXONOMY_VERSION,\n+        \"category\": category,\n+        \"code\": code,\n+        \"actor\": actor,\n+        \"fatal\": category in FATAL_CATEGORIES,\n+        \"capability_bearing\": category in FATAL_CATEGORIES,\n+        \"evidence_refs\": list(evidence_refs),\n+        \"detail\": detail,\n+    }\n+\n+\n+def classify_session_audit(audit: dict[str, Any], actor: str\n+                           ) -> list[dict[str, Any]]:\n+    \"\"\"Deterministic classification of a session-audit document.\"\"\"\n+    out: list[dict[str, Any]] = []\n+    for use in audit.get(\"disallowed_tool_uses\", []) or []:\n+        tool = use.get(\"tool\") if isinstance(use, dict) else str(use)\n+        ref = [use] if isinstance(use, dict) else [{\"tool\": tool}]\n+        if tool in META_TOOLS:\n+            out.append(event(\"meta_tool_observation\",\n+                             \"META_TOOL_SCHEMA_OBSERVATION\", actor, ref,\n+                             f\"{tool} grants no read/write/spawn capability\"))\n+        else:\n+            out.append(event(\"capability_violation\",\n+                             \"UNAUTHORIZED_CAPABILITY_TOOL\", actor, ref,\n+                             f\"tool {tool} outside the session envelope\"))\n+    for use in audit.get(\"spawn_capable_tool_uses\", []) or []:\n+        out.append(event(\"capability_violation\", \"HIDDEN_CHILD_RISK\", actor,\n+                         [use if isinstance(use, dict) else {\"tool\": use}],\n+                         \"spawn-capable tool use in an audited session\"))\n+    for pth in audit.get(\"file_paths_outside_workspace\", []) or []:\n+        out.append(event(\"capability_violation\", \"WORKSPACE_ESCAPE\", actor,\n+                         [{\"path\": pth}],\n+                         \"filesystem access outside the granted workspace\"))\n+    if audit.get(\"parse_errors\", 0):\n+        out.append(event(\"instrumentation_violation\", \"AUDIT_PARSE_ERRORS\",\n+                         actor, [{\"parse_errors\": audit[\"parse_errors\"]}]))\n+    return out\n+\n+\n+def classify_refinement(result: dict[str, Any], actor: str\n+                        ) -> list[dict[str, Any]]:\n+    \"\"\"Refinement failures: instrumentation when the mapping is incomplete,\n+    protocol when completion is missing, authority when an illegal\n+    transition was taken.\"\"\"\n+    status = str(result.get(\"status\", \"\"))\n+    if status == \"PASS\":\n+        return []\n+    detail = str(result.get(\"detail\", \"\")) + str(\n+        result.get(\"counterexample\", \"\"))\n+    low = detail.lower()\n+    if \"authority\" in low or \"promote\" in low:\n+        cat, code = \"authority_violation\", \"REFINEMENT_AUTHORITY\"\n+    elif \"completion\" in low or \"complete\" in low:\n+        cat, code = \"protocol_violation\", \"COMPLETION_MISSING\"\n+    else:\n+        cat, code = \"instrumentation_violation\", \"REFINEMENT_NONCONFORMANT\"\n+    return [event(cat, code, actor, [result.get(\"check\", \"refinement\")],\n+                  detail[:300])]\n+\n+\n+def classify_ledger_labels(problems: list[str], actor: str\n+                           ) -> list[dict[str, Any]]:\n+    return [event(\"instrumentation_violation\", \"INVALID_LEDGER_LABEL\",\n+                  actor, [{\"problem\": p}]) for p in problems]\n+\n+\n+def classify_attenuation(result: dict[str, Any], actor: str\n+                         ) -> list[dict[str, Any]]:\n+    if str(result.get(\"status\", \"\")) == \"PASS\":\n+        return []\n+    return [event(\"attenuation_violation\", \"ATTENUATION_FAIL\", actor,\n+                  [result.get(\"counterexample\")])]\n+\n+\n+def summarize(events: list[dict[str, Any]]) -> dict[str, Any]:\n+    counts = {c: 0 for c in CATEGORIES}\n+    for e in events:\n+        counts[e[\"category\"]] += 1\n+    fatal = sum(counts[c] for c in FATAL_CATEGORIES)\n+    nonfatal = counts[\"protocol_violation\"] + \\\n+        counts[\"instrumentation_violation\"]\n+    g_obs = min(1.0, 0.25 * fatal + 0.10 * nonfatal)\n+    return {\n+        \"taxonomy\": TAXONOMY_VERSION,\n+        \"counts_by_category\": counts,\n+        \"fatal_events\": fatal,\n+        \"capability_violations\": counts[\"capability_violation\"],\n+        \"authority_or_attenuation_violations\":\n+            counts[\"authority_violation\"] + counts[\"attenuation_violation\"],\n+        \"nonfatal_events\": nonfatal,\n+        \"meta_tool_observations\": counts[\"meta_tool_observation\"],\n+        \"observed_governance_risk\": round(g_obs, 4),\n+    }\ndiff --git a/.creator-zero/topology-theory/ingest.py b/.creator-zero/topology-theory/ingest.py\nnew file mode 100644\nindex 0000000..7be2797\n--- /dev/null\n+++ b/.creator-zero/topology-theory/ingest.py\n@@ -0,0 +1,174 @@\n+\"\"\"Evidence import layer: pinned source, deterministic enrichment,\n+idempotent append into the append-only theory store.\n+\n+    verify_source_pin(path, pin)               -> typed PASS/FAIL record\n+    enrich_e6_events(raw_events, pins, ...)    -> v2 evidence dicts\n+    ingest_evidence(store, events, ...)        -> import manifest\n+\n+Idempotence contract (per event e):\n+    e.event_id not in store                       -> append\n+    same id, identical normalized content         -> skip\n+    same id, different content                    -> EVIDENCE_ID_CONFLICT\n+No previously written evidence line is ever rewritten; the running hash\n+chain remains the tamper-evidence.\n+\"\"\"\n+from __future__ import annotations\n+import hashlib\n+import json\n+from pathlib import Path\n+from typing import Any, Optional\n+\n+from .admissibility import E6_CLASS_TO_KIND\n+from .model import ModelValidationError, PrincipleEvidence\n+from .serialization import file_artifact_id\n+\n+\n+class EvidenceImportError(RuntimeError):\n+    \"\"\"Typed import failure (source pin mismatch, id conflict).\"\"\"\n+\n+\n+def normalized_event_hash(d: dict[str, Any]) -> str:\n+    \"\"\"Content hash over the closed canonical form of an evidence event.\"\"\"\n+    canon = PrincipleEvidence.from_dict(d).to_dict()\n+    return hashlib.sha256(json.dumps(canon, sort_keys=True,\n+                          separators=(\",\", \":\")).encode(\"utf-8\")).hexdigest()\n+\n+\n+def load_source_events(path: str | Path) -> list[dict[str, Any]]:\n+    out = []\n+    for i, line in enumerate(Path(path).read_text(\n+            encoding=\"utf-8\").splitlines()):\n+        if not line.strip():\n+            continue\n+        try:\n+            out.append(json.loads(line))\n+        except json.JSONDecodeError as e:\n+            raise EvidenceImportError(f\"source line {i} unparseable: {e}\")\n+    return out\n+\n+\n+def verify_source_pin(path: str | Path, pin: dict[str, Any]\n+                      ) -> dict[str, Any]:\n+    \"\"\"The import source must byte-match its Phase A pin.\"\"\"\n+    p = Path(path)\n+    got = hashlib.sha256(p.read_bytes()).hexdigest()\n+    events = load_source_events(p)\n+    ids = [e.get(\"event_id\") for e in events]\n+    checks = {\n+        \"sha256\": got == pin[\"sha256\"],\n+        \"event_count\": len(events) == int(pin[\"expected_event_count\"]),\n+        \"unique_event_ids\": len(set(ids)) ==\n+        int(pin[\"expected_unique_event_ids\"]),\n+    }\n+    ok = all(checks.values())\n+    return {\"check\": \"evidence_source_pin\",\n+            \"status\": \"PASS\" if ok else \"FAIL\",\n+            \"failure_code\": None if ok else \"EVIDENCE_SOURCE_MISMATCH\",\n+            \"observed\": {\"sha256\": got, \"event_count\": len(events),\n+                         \"unique_event_ids\": len(set(ids))},\n+            \"pinned\": {k: pin[k] for k in (\"sha256\", \"expected_event_count\",\n+                                           \"expected_unique_event_ids\")},\n+            \"clauses\": checks}\n+\n+\n+def enrich_e6_events(raw_events: list[dict[str, Any]],\n+                     labels_by_trial: dict[str, dict[str, Any]],\n+                     *, source_commit: str, source_path: str,\n+                     source_artifact_id: str,\n+                     ) -> list[dict[str, Any]]:\n+    \"\"\"Deterministic enrichment of frozen E6 events with provenance/context.\n+\n+    The join is trial_id -> frozen private label -> admissibility kind. The\n+    frozen labels are truth artifacts: nothing here rewrites them, and an\n+    event whose join fails gets context_status=UNKNOWN (it cannot support a\n+    context-conditioned split dimension).\"\"\"\n+    out = []\n+    for raw in raw_events:\n+        e = dict(raw)\n+        e.setdefault(\"source_experiment\", \"experiment-6\")\n+        e.setdefault(\"source_commit\", source_commit)\n+        e.setdefault(\"source_artifact_id\", source_artifact_id)\n+        trial = e.get(\"trial_id\", \"\")\n+        label = labels_by_trial.get(trial)\n+        if label is not None and label.get(\"latent_class\") in \\\n+                E6_CLASS_TO_KIND:\n+            cls = label[\"latent_class\"]\n+            e[\"context\"] = {\n+                \"context_status\": \"OK\",\n+                \"latent_class\": cls,\n+                \"admissibility_kind\": E6_CLASS_TO_KIND[cls],\n+                \"join_source\": {\n+                    \"path\": f\".creator-zero/experiment-6/task-bank/{trial}/\"\n+                            \"private/label.json\",\n+                    \"join_key\": \"trial_id\",\n+                    \"source_path\": source_path,\n+                },\n+            }\n+        else:\n+            e[\"context\"] = {\"context_status\": \"UNKNOWN\"}\n+        # closed-schema validation: unknown fields fail loudly, nothing is\n+        # silently stripped (NC6)\n+        out.append(PrincipleEvidence.from_dict(e).to_dict())\n+    return out\n+\n+\n+def ingest_evidence(store, events: list[dict[str, Any]],\n+                    import_manifest: Optional[dict[str, Any]] = None,\n+                    ) -> dict[str, Any]:\n+    \"\"\"Idempotent append of validated evidence events into the store.\"\"\"\n+    head_before = store.evidence_head()\n+    existing: dict[str, str] = {}\n+    for ev in store.read_evidence():\n+        d = ev.to_dict()\n+        existing[d[\"event_id\"]] = normalized_event_hash(d)\n+\n+    imported, skipped, conflicts = [], [], []\n+    for e in events:\n+        try:\n+            canon = PrincipleEvidence.from_dict(e).to_dict()\n+        except ModelValidationError as exc:\n+            raise EvidenceImportError(f\"invalid evidence event \"\n+                                      f\"{e.get('event_id')!r}: {exc}\")\n+        eid = canon[\"event_id\"]\n+        h = normalized_event_hash(canon)\n+        if eid in existing:\n+            if existing[eid] == h:\n+                skipped.append(eid)\n+                continue\n+            conflicts.append(eid)\n+            raise EvidenceImportError(\n+                f\"EVIDENCE_ID_CONFLICT: event {eid!r} already stored with \"\n+                \"different content; append-only history cannot be rewritten\")\n+        store.append_evidence(canon)\n+        existing[eid] = h\n+        imported.append(eid)\n+\n+    head_after = store.evidence_head()\n+    chain = store.verify_append_only()\n+    doc = {\n+        \"artifact\": \"evidence import manifest\",\n+        \"imported\": len(imported),\n+        \"skipped_identical\": len(skipped),\n+        \"conflicts\": len(conflicts),\n+        \"evidence_head_before\": {\"length\": head_before[0],\n+                                 \"hash\": head_before[1]},\n+        \"evidence_head_after\": {\"length\": head_after[0],\n+                                \"hash\": head_after[1]},\n+        \"append_only_intact\": chain[\"append_only_intact\"],\n+        \"imported_event_ids_sha256\": hashlib.sha256(\n+            json.dumps(imported, separators=(\",\", \":\")).encode()\n+        ).hexdigest(),\n+    }\n+    if import_manifest:\n+        doc.update({k: v for k, v in import_manifest.items()\n+                    if k not in doc})\n+    return doc\n+\n+\n+def pin_source_artifact(path: str | Path, provenance: str) -> dict[str, Any]:\n+    p = Path(path)\n+    return {\n+        \"path\": str(path),\n+        \"sha256\": hashlib.sha256(p.read_bytes()).hexdigest(),\n+        \"artifact_id\": file_artifact_id(p, provenance),\n+    }\ndiff --git a/.creator-zero/topology-theory/model.py b/.creator-zero/topology-theory/model.py\nindex ae132ca..f2b912a 100644\n--- a/.creator-zero/topology-theory/model.py\n+++ b/.creator-zero/topology-theory/model.py\n@@ -73,6 +73,7 @@ class Principle:\n     contradicting_evidence: list[dict[str, Any]] = field(default_factory=list)\n     parent_principles: list[str] = field(default_factory=list)\n     version: int = 1\n+    falsifier: str = \"\"                 # explicit falsification condition\n \n     def __post_init__(self):\n         _require(bool(self.id) and self.id.startswith(\"P-\"),\n@@ -97,18 +98,34 @@ class Principle:\n \n @dataclass\n class PrincipleEvidence:\n-    \"\"\"Append-only evidence event linking a principle to an observed outcome.\"\"\"\n+    \"\"\"Append-only evidence event linking a principle to an observed outcome.\n+\n+    Schema v2 (backward compatible): optional provenance/context fields\n+    preserve WHERE a principle held or failed — source experiment/commit,\n+    trial and run identity, and a deterministic context object (e.g. the\n+    admissibility kind joined from frozen truth artifacts). Historical v1\n+    events (a subset of the known fields) remain readable; unknown top-level\n+    fields are a typed rejection, never a silent drop — a parser that strips\n+    context cannot pass validation.\"\"\"\n     principle_id: str\n     topology_id: str\n     prediction_id: str\n     effect: str\n     evidence_refs: list[dict[str, Any]] = field(default_factory=list)\n     event_id: str = \"\"\n+    source_experiment: str = \"\"\n+    source_commit: str = \"\"\n+    trial_id: str = \"\"\n+    run: str = \"\"\n+    context: dict[str, Any] = field(default_factory=dict)\n+    source_artifact_id: str = \"\"\n \n     def __post_init__(self):\n         _require(self.effect in EVIDENCE_EFFECTS,\n                  f\"invalid evidence effect {self.effect!r}\")\n         _require(bool(self.principle_id), \"evidence missing principle_id\")\n+        _require(isinstance(self.context, dict),\n+                 \"evidence context must be an object\")\n \n     def to_dict(self) -> dict[str, Any]:\n         return asdict(self)\n@@ -117,6 +134,11 @@ class PrincipleEvidence:\n     def from_dict(cls, d: dict[str, Any]) -> \"PrincipleEvidence\":\n         _require_keys(d, (\"principle_id\", \"topology_id\", \"prediction_id\",\n                           \"effect\"), \"principle evidence\")\n+        unknown = sorted(set(d) - set(cls.__dataclass_fields__))\n+        _require(not unknown,\n+                 f\"principle evidence carries unknown top-level fields \"\n+                 f\"{unknown}: contextual fields must be modeled, not \"\n+                 \"silently discarded\")\n         return cls(**{k: d[k] for k in cls.__dataclass_fields__ if k in d})\n \n \n@@ -206,6 +228,7 @@ class Revision:\n     motivating_evidence: list[str] = field(default_factory=list)\n     historical_cases_affected: list[str] = field(default_factory=list)\n     changed_predictions: list[str] = field(default_factory=list)\n+    context_partition: dict[str, Any] = field(default_factory=dict)\n     status: str = \"CANDIDATE\"\n \n     def __post_init__(self):\ndiff --git a/.creator-zero/topology-theory/predict2.py b/.creator-zero/topology-theory/predict2.py\nnew file mode 100644\nindex 0000000..9f23ef5\n--- /dev/null\n+++ b/.creator-zero/topology-theory/predict2.py\n@@ -0,0 +1,73 @@\n+\"\"\"Prediction freezing v2: typed principle attribution + role predictions.\n+\n+Wraps the promoted freeze_predictions: same falsifier-complete mechanical\n+prediction kinds, but (a) per-distinction resolution predictions are\n+attributed to the typed principle matching the distinction's required\n+admissibility kind, and (b) every non-local evidence provision gets a\n+mechanical role prediction (FAILED when the runtime records ROLE_TYPE_FAIL —\n+right graph shape with the wrong epistemic role falsifies the typed\n+principle instead of silently passing). Hash-freezing semantics unchanged.\n+\"\"\"\n+from __future__ import annotations\n+from typing import Any\n+\n+from .admissibility import requirement_for_distinction\n+from .model import Prediction, TopologyHypothesis\n+from .predict import freeze_predictions, predictions_hash\n+\n+KIND_TO_PRINCIPLE = {\n+    \"LOCAL\": \"P-LOCALITY\",\n+    \"CLEAN_ROOM_AUTHORSHIP\": \"P-AUTHORSHIP-INDEPENDENCE\",\n+    \"NON_AUTHOR_SEARCH\": \"P-NONAUTHOR-SEARCH\",\n+    \"INDEPENDENT_DECOMPOSITION\": \"P-INDEPENDENT-DECOMPOSITION\",\n+    \"METHOD_DISJOINT_VERIFICATION\": \"P-METHOD-DISJOINT-VERIFICATION\",\n+}\n+\n+\n+def freeze_predictions_v2(topology: TopologyHypothesis,\n+                          distinctions: list[dict[str, Any]],\n+                          ) -> list[Prediction]:\n+    preds = freeze_predictions(topology, distinctions)\n+    kind_by_q = {d[\"id\"]: requirement_for_distinction(d).kind\n+                 for d in distinctions}\n+\n+    for p in preds:\n+        if p.kind == \"resolves\":\n+            q = p.subject.get(\"distinction_id\")\n+            p.principles = [KIND_TO_PRINCIPLE[kind_by_q.get(q, \"LOCAL\")]]\n+\n+    tid = topology.topology_id\n+    n = len(preds)\n+    for prov in topology.harness_spec.get(\"evidence_provisions\", []):\n+        role = prov[\"role\"]\n+        if role == \"local_author\":\n+            continue\n+        n += 1\n+        # principle of the provision's role: the kind it uniquely serves\n+        role_kind = {\n+            \"clean_room_author\": \"CLEAN_ROOM_AUTHORSHIP\",\n+            \"non_author_examiner\": \"NON_AUTHOR_SEARCH\",\n+            \"independent_decomposer\": \"INDEPENDENT_DECOMPOSITION\",\n+            \"method_disjoint_verifier\": \"METHOD_DISJOINT_VERIFICATION\",\n+        }[role]\n+        preds.append(Prediction(\n+            prediction_id=f\"{tid}-pr{n:02d}\",\n+            topology_id=tid,\n+            claim=f\"the independent path at node {prov['node_id']} realizes \"\n+                  f\"canonical role {role}\",\n+            observable=\"realized role typing in the runtime record \"\n+                       \"(ROLE_TYPE_FAIL formal failure on mismatch)\",\n+            success_condition=f\"realized role of {prov['node_id']} equals \"\n+                              f\"{role} and no ROLE_TYPE failure is recorded\",\n+            falsification_condition=\"the realized path's canonical role \"\n+                                    f\"differs from {role} \"\n+                                    \"(ROLE_TYPE_FAIL recorded)\",\n+            weight=1.0, kind=\"verification_effect\",\n+            subject={\"checks\": [\"ROLE_TYPE\"], \"node\": prov[\"node_id\"],\n+                     \"role\": role},\n+            principles=[KIND_TO_PRINCIPLE[role_kind]],\n+        ))\n+\n+    topology.predictions = [p.to_dict() for p in preds]\n+    topology.predictions_hash = predictions_hash(tid, topology.predictions)\n+    return preds\ndiff --git a/.creator-zero/topology-theory/replay-corpus-e6.json b/.creator-zero/topology-theory/replay-corpus-e6.json\nnew file mode 100644\nindex 0000000..c6abb25\n--- /dev/null\n+++ b/.creator-zero/topology-theory/replay-corpus-e6.json\n@@ -0,0 +1,48 @@\n+{\n+  \"artifact\": \"topology-theory historical replay corpus \\u2014 Experiment 6 frozen cases (E7 extension)\",\n+  \"note\": \"Frozen E6 regression cases for candidate theta revisions. Replay semantics identical to the v0.1 corpus: a candidate that retires or contradicts a required principle is CONTRADICTED. REVISED is an active status, so a SPLIT that keeps the parent grounded stays compatible. These cases are regression checks, not held-out validation.\",\n+  \"cases\": [\n+    {\n+      \"case_id\": \"E6-clean-room-authorship\",\n+      \"summary\": \"E6 e6-t01 (ISOLATION): a clean-room child authored solely from the description resolved the admissibility-critical distinctions; the frozen record supports isolation-for-authorship under P-INDEPENDENCE with enforced freshness.\",\n+      \"required_active_principles\": [\n+        \"P-INDEPENDENCE\",\n+        \"P-FRESHNESS\"\n+      ],\n+      \"historical_outcome\": \"clean_room_implementer child, fresh launch, verified integration\",\n+      \"pinned_artifacts\": {\n+        \"experiment-6/task-bank/e6-t01/private/label.json\": \"ec1171b3ac598c34f7eacd456e543df92110b713b6fede0d8bfec95646884eb9\",\n+        \"experiment-6/trials/e6-t01/child/integration-plan.json\": \"ad12b4d1e0a52f1284a02153ea76ad9f5931e541d9821de646f755caec092f9b\",\n+        \"experiment-6/trials/e6-t01/verification.json\": \"1d596c6423f75469ea916bed3dda72f14d56c9d2eadde30094d7e59a9acaa43e\"\n+      }\n+    },\n+    {\n+      \"case_id\": \"E6-examiner-cheaper-than-child\",\n+      \"summary\": \"E6 e6-t08 (COUNTEREXAMPLE): the runner-up examiner shadow achieved strictly higher observed utility than the selected isolated child on the same search requirement \\u2014 the calibration/regret evidence motivating the typed revision.\",\n+      \"required_active_principles\": [\n+        \"P-INDEPENDENCE\",\n+        \"P-MINIMALITY\"\n+      ],\n+      \"historical_outcome\": \"shadow observed utility > selected observed utility; regret > 0\",\n+      \"pinned_artifacts\": {\n+        \"experiment-6/task-bank/e6-t08/private/label.json\": \"14c0080db21a0447e70fa015f850c50cf181052d85af5abfe950c078298fd3d2\",\n+        \"experiment-6/trials/e6-t08/calibration.json\": \"a5f2b1311c7d094bca6d9ba41061c7786c930a6687c6455aba8137e638889efc\",\n+        \"experiment-6/trials/e6-t08/shadow/calibration.json\": \"79c69bdbae42ae6a42c532ace2b37f9b4559602835611f41e2acb97fa3cb8e06\"\n+      }\n+    },\n+    {\n+      \"case_id\": \"E6-local-sufficiency\",\n+      \"summary\": \"E6 e6-t02 (LOCAL): local resolution verified with zero descendants; forced extra structure would have duplicated local evidence.\",\n+      \"required_active_principles\": [\n+        \"P-LOCALITY\",\n+        \"P-MINIMALITY\"\n+      ],\n+      \"historical_outcome\": \"TOPOLOGY_CORRECT local selection, zero child launches\",\n+      \"pinned_artifacts\": {\n+        \"experiment-6/task-bank/e6-t02/private/label.json\": \"ef7ccda1344bcaaf669b5958a380ba62675f9f80b7869d655c59f49c8d8ef46b\",\n+        \"experiment-6/trials/e6-t02/trial-score.json\": \"25abcd7381c58e406dae2529755322b0a6be21c2690818890fa53de680cb74e4\",\n+        \"experiment-6/trials/e6-t02/calibration.json\": \"9d9576a3c1f1a7c14f8e85a75ad58afafe36b058c0dc97dd23485b920e5b9c3f\"\n+      }\n+    }\n+  ]\n+}\ndiff --git a/.creator-zero/topology-theory/revise2.py b/.creator-zero/topology-theory/revise2.py\nnew file mode 100644\nindex 0000000..78a493c\n--- /dev/null\n+++ b/.creator-zero/topology-theory/revise2.py\n@@ -0,0 +1,375 @@\n+\"\"\"Evidence-conditioned revision engine v2: context-aware candidate family.\n+\n+Builds on the existing revision algebra (model.Revision, revise.apply_revision;\n+SPLIT was already recognized) — no second incompatible mechanism. What v2\n+adds, per the frozen Experiment 7 preregistration §6:\n+\n+    context_stats()          SUPPORT/FALSIFY per admissibility context\n+    split_trigger()          evidence-grounded SPLIT eligibility\n+    build_candidates()       {no-change, SPECIALIZE, SPLIT, DEPRECATE}\n+    explanation_scores()     frozen deterministic explanation scoring\n+    propose_revision_v2()    scored, deterministic selection\n+\n+Nothing here promotes anything: every produced Revision is CANDIDATE and the\n+successor TheoryVersion built from it stays CANDIDATE until the final theory\n+Gate. Wording of candidate principles may be model-drafted, but it enters\n+only as serialized text validated structurally; partitioning, scoring, and\n+selection are deterministic. 'Split because the operator said so' is\n+impossible: the trigger demands mixed evidence occupying >=2 reproducible\n+contexts with a support-rate spread.\n+\"\"\"\n+from __future__ import annotations\n+from typing import Any, Optional\n+\n+from .model import (ModelValidationError, Principle, Revision, TheoryVersion)\n+from .admissibility import KIND_REQUIREMENT\n+\n+# Frozen rule constants (preregistration §6; never tuned after Phase A)\n+FROZEN_RULES = {\n+    \"min_context_events\": 4,\n+    \"min_spread\": 0.3,\n+    \"min_context_coverage\": 0.9,\n+    \"reproducibility_floor\": 2,\n+    \"specialize_max_falsify_rate\": 0.2,\n+}\n+\n+# Preregistered split basis for P-INDEPENDENCE: context kind -> child spec\n+SPLIT_BASIS = {\n+    \"P-INDEPENDENCE\": {\n+        \"CLEAN_ROOM_AUTHORSHIP\": {\n+            \"id\": \"P-AUTHORSHIP-INDEPENDENCE\",\n+            \"feature\": \"requires_clean_room_authorship\",\n+            \"role\": \"clean_room_author\",\n+        },\n+        \"NON_AUTHOR_SEARCH\": {\n+            \"id\": \"P-NONAUTHOR-SEARCH\",\n+            \"feature\": \"requires_nonauthor_search\",\n+            \"role\": \"non_author_examiner\",\n+        },\n+        \"INDEPENDENT_DECOMPOSITION\": {\n+            \"id\": \"P-INDEPENDENT-DECOMPOSITION\",\n+            \"feature\": \"requires_independent_decomposition\",\n+            \"role\": \"independent_decomposer\",\n+        },\n+        \"METHOD_DISJOINT_VERIFICATION\": {\n+            \"id\": \"P-METHOD-DISJOINT-VERIFICATION\",\n+            \"feature\": \"requires_method_disjoint_verification\",\n+            \"role\": \"method_disjoint_verifier\",\n+        },\n+    },\n+}\n+\n+_DEFAULT_STATEMENTS = {\n+    \"P-AUTHORSHIP-INDEPENDENCE\":\n+        \"When a distinction's admissibility requires clean-room authorship \"\n+        \"(evidence authored without access to a contaminating reference), \"\n+        \"only an isolated fresh descendant authoring solely from the \"\n+        \"sanctioned description supplies admissible evidence; examiner \"\n+        \"review of contaminated work cannot.\",\n+    \"P-NONAUTHOR-SEARCH\":\n+        \"When a distinction requires a search for violating inputs by a \"\n+        \"party that did not author the candidate answer, an information-\"\n+        \"only independent examiner supplies admissible evidence; full \"\n+        \"clean-room isolation satisfies the same requirement at strictly \"\n+        \"higher cost and adds no admissible value.\",\n+    \"P-INDEPENDENT-DECOMPOSITION\":\n+        \"When completeness of an enumeration or decomposition is admissible \"\n+        \"only via a second decomposition produced without access to the \"\n+        \"first, an isolated independent decomposer is required; review or \"\n+        \"re-verification of the first decomposition is inadmissible for \"\n+        \"that distinction.\",\n+    \"P-METHOD-DISJOINT-VERIFICATION\":\n+        \"When correctness must be established by re-derivation through a \"\n+        \"method disjoint from the primary method, a method-disjoint \"\n+        \"verifier path supplies the admissible evidence; isolation without \"\n+        \"method disjointness is insufficient, and method-sharing review is \"\n+        \"inadmissible.\",\n+}\n+\n+_DEFAULT_FALSIFIERS = {\n+    \"P-AUTHORSHIP-INDEPENDENCE\":\n+        \"a reference-exposed path yields evidence scored admissible for a \"\n+        \"clean-room distinction, or the isolated clean-room author fails \"\n+        \"to add admissible value where the requirement is present\",\n+    \"P-NONAUTHOR-SEARCH\":\n+        \"the independent examiner's search is scored inadmissible where \"\n+        \"predicted admissible, or an isolated child strictly outperforms \"\n+        \"the examiner on the same search requirement at equal \"\n+        \"admissibility and equal coverage\",\n+    \"P-INDEPENDENT-DECOMPOSITION\":\n+        \"a decomposition produced with access to the first is scored \"\n+        \"admissible, or the isolated decomposer duplicates the first \"\n+        \"decomposition without novel enumeration evidence\",\n+    \"P-METHOD-DISJOINT-VERIFICATION\":\n+        \"a method-sharing verification is scored admissible for a \"\n+        \"method-disjoint distinction, or the method-disjoint verifier \"\n+        \"fails to add admissible value where the requirement is present\",\n+}\n+\n+\n+def context_stats(events: list[Any], principle_id: str) -> dict[str, Any]:\n+    \"\"\"SUPPORT/FALSIFY/CHALLENGE counts per resolved admissibility context.\"\"\"\n+    ctx: dict[str, dict[str, Any]] = {}\n+    unresolved = 0\n+    total = 0\n+    for e in events:\n+        d = e.to_dict() if hasattr(e, \"to_dict\") else dict(e)\n+        if d.get(\"principle_id\") != principle_id:\n+            continue\n+        total += 1\n+        c = (d.get(\"context\") or {})\n+        kind = c.get(\"admissibility_kind\")\n+        if c.get(\"context_status\") != \"OK\" or not kind:\n+            unresolved += 1\n+            continue\n+        slot = ctx.setdefault(kind, {\"SUPPORT\": 0, \"CHALLENGE\": 0,\n+                                     \"FALSIFY\": 0, \"event_ids\": []})\n+        slot[d[\"effect\"]] += 1\n+        slot[\"event_ids\"].append(d.get(\"event_id\") or d[\"prediction_id\"])\n+    for slot in ctx.values():\n+        slot[\"event_ids\"] = sorted(slot[\"event_ids\"])\n+        sf = slot[\"SUPPORT\"] + slot[\"FALSIFY\"]\n+        slot[\"support_rate\"] = round(slot[\"SUPPORT\"] / sf, 4) if sf else None\n+        slot[\"falsify_rate\"] = round(slot[\"FALSIFY\"] / sf, 4) if sf else None\n+    return {\"principle_id\": principle_id, \"total_events\": total,\n+            \"unresolved_context_events\": unresolved, \"contexts\": ctx}\n+\n+\n+def split_trigger(stats: dict[str, Any],\n+                  rules: dict[str, Any] = FROZEN_RULES) -> dict[str, Any]:\n+    ctx = stats[\"contexts\"]\n+    total = stats[\"total_events\"]\n+    support = sum(c[\"SUPPORT\"] for c in ctx.values())\n+    falsify = sum(c[\"FALSIFY\"] for c in ctx.values())\n+    coverage = ((total - stats[\"unresolved_context_events\"]) / total\n+                if total else 0.0)\n+    qualifying = {k: c for k, c in ctx.items()\n+                  if (c[\"SUPPORT\"] + c[\"CHALLENGE\"] + c[\"FALSIFY\"])\n+                  >= rules[\"min_context_events\"]}\n+    rates = [c[\"support_rate\"] for c in qualifying.values()\n+             if c[\"support_rate\"] is not None]\n+    spread = (max(rates) - min(rates)) if len(rates) >= 2 else 0.0\n+    clauses = {\n+        \"mixed_evidence\": support >= 1 and falsify >= 1,\n+        \"context_coverage\": coverage >= rules[\"min_context_coverage\"],\n+        \"enough_contexts\": len(qualifying) >= 2,\n+        \"support_rate_spread\": spread >= rules[\"min_spread\"],\n+    }\n+    return {\"eligible\": all(clauses.values()), \"clauses\": clauses,\n+            \"qualifying_contexts\": sorted(qualifying),\n+            \"support_rate_spread\": round(spread, 4),\n+            \"context_coverage\": round(coverage, 4)}\n+\n+\n+def _validate_split_children(children: list[dict[str, Any]]) -> None:\n+    ids = [c[\"id\"] for c in children]\n+    if len(ids) != len(set(ids)):\n+        raise ModelValidationError(\"split children must have unique ids\")\n+    pre = [tuple(c[\"preconditions\"]) for c in children]\n+    eff = [tuple(c[\"predicted_topology_effects\"]) for c in children]\n+    if len(set(pre)) != len(pre) or len(set(eff)) != len(eff):\n+        raise ModelValidationError(\n+            \"split children are semantic duplicates (identical \"\n+            \"preconditions or predicted effects)\")\n+    for c in children:\n+        if not str(c.get(\"falsifier\", \"\")).strip():\n+            raise ModelValidationError(\n+                f\"split child {c['id']} lacks an explicit falsifier\")\n+        if not c.get(\"supporting_evidence\"):\n+            raise ModelValidationError(\n+                f\"split child {c['id']} lacks motivating evidence\")\n+        Principle.from_dict(c)      # closed-schema validation\n+\n+\n+def build_split_candidate(theory: TheoryVersion, pid: str,\n+                          stats: dict[str, Any],\n+                          wording: Optional[dict[str, str]] = None,\n+                          rules: dict[str, Any] = FROZEN_RULES,\n+                          ) -> Revision:\n+    basis = SPLIT_BASIS.get(pid)\n+    if basis is None:\n+        raise ModelValidationError(f\"no preregistered split basis for {pid}\")\n+    trigger = split_trigger(stats, rules)\n+    if not trigger[\"eligible\"]:\n+        raise ModelValidationError(\n+            f\"split trigger not satisfied for {pid}: {trigger['clauses']}\")\n+    wording = wording or {}\n+    children = []\n+    partition = {}\n+    motivating: list[str] = []\n+    for kind in sorted(stats[\"contexts\"]):\n+        c = stats[\"contexts\"][kind]\n+        n = c[\"SUPPORT\"] + c[\"CHALLENGE\"] + c[\"FALSIFY\"]\n+        if n < rules[\"min_context_events\"] or kind not in basis:\n+            continue\n+        spec = basis[kind]\n+        cid = spec[\"id\"]\n+        stmt = wording.get(cid, _DEFAULT_STATEMENTS[cid])\n+        if len(stmt.strip()) < 40:\n+            raise ModelValidationError(\n+                f\"candidate principle {cid} wording too thin\")\n+        vec, roles = KIND_REQUIREMENT[kind]\n+        children.append({\n+            \"id\": cid,\n+            \"statement\": stmt,\n+            \"status\": \"CANDIDATE\",\n+            \"scope\": [\"topology-decision\", \"verification\"],\n+            \"preconditions\": [f\"feature:{spec['feature']}\"],\n+            \"predicted_topology_effects\": [\n+                f\"adds an independent path with canonical role \"\n+                f\"{spec['role']}\",\n+                f\"that path's evidence is admissible for \"\n+                f\"{kind} distinctions (required vector {list(vec)})\",\n+                \"cheaper admissible paths dominate costlier ones at equal \"\n+                \"coverage (saturating value)\",\n+            ],\n+            \"supporting_evidence\": [\n+                {\"evidence_event_id\": eid,\n+                 \"context_kind\": kind,\n+                 \"source\": \"experiment-6 imported theory evidence\"}\n+                for eid in c[\"event_ids\"]],\n+            \"contradicting_evidence\": [],\n+            \"parent_principles\": [pid],\n+            \"version\": 1,\n+            \"falsifier\": _DEFAULT_FALSIFIERS[cid],\n+        })\n+        partition[kind] = {\"SUPPORT\": c[\"SUPPORT\"], \"FALSIFY\": c[\"FALSIFY\"],\n+                           \"CHALLENGE\": c[\"CHALLENGE\"],\n+                           \"event_ids\": c[\"event_ids\"]}\n+        motivating.extend(c[\"event_ids\"])\n+    _validate_split_children(children)\n+    return Revision(","numLines":900,"startLine":1700,"totalLines":2852}}}
