{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017mVTUok99GTB2Pz1CN2pqa","type":"tool_result","content":"2600\t+        revision_id=f\"rev-split-{pid.lower()}\",\n2601\t+        type=\"SPLIT\",\n2602\t+        parents=[pid],\n2603\t+        candidate_principles=children,\n2604\t+        motivating_evidence=sorted(motivating),\n2605\t+        historical_cases_affected=[],\n2606\t+        changed_predictions=[\n2607\t+            \"typed admissibility replaces coarse isolation preference in \"\n2608\t+            \"topology generation and ranking\",\n2609\t+            \"an examiner (not an isolated child) is predicted optimal for \"\n2610\t+            \"pure NON_AUTHOR_SEARCH requirements\",\n2611\t+            \"a method-disjoint verifier (not an isolated child) is \"\n2612\t+            \"predicted optimal for METHOD_DISJOINT_VERIFICATION\",\n2613\t+        ],\n2614\t+        context_partition=partition,\n2615\t+        status=\"CANDIDATE\")\n2616\t+\n2617\t+\n2618\t+def build_specialize_candidate(theory: TheoryVersion, pid: str,\n2619\t+                               stats: dict[str, Any],\n2620\t+                               rules: dict[str, Any] = FROZEN_RULES,\n2621\t+                               ) -> Revision:\n2622\t+    parent = theory.principle(pid)\n2623\t+    retained = sorted(\n2624\t+        k for k, c in stats[\"contexts\"].items()\n2625\t+        if c[\"falsify_rate\"] is not None\n2626\t+        and c[\"falsify_rate\"] < rules[\"specialize_max_falsify_rate\"])\n2627\t+    narrowed = dict(parent.to_dict()) if parent else {\"id\": pid}\n2628\t+    narrowed.update({\n2629\t+        \"id\": f\"{pid}-SPECIALIZED\",\n2630\t+        \"status\": \"CANDIDATE\",\n2631\t+        \"parent_principles\": [pid],\n2632\t+        \"version\": 1,\n2633\t+        \"statement\": (parent.statement if parent else \"\") +\n2634\t+        f\" [SPECIALIZED: preconditions narrowed to admissibility contexts \"\n2635\t+        f\"{retained} in which the principle's predictions held]\",\n2636\t+    })\n2637\t+    motivating = []\n2638\t+    for k, c in stats[\"contexts\"].items():\n2639\t+        if k not in retained:\n2640\t+            motivating.extend(c[\"event_ids\"])\n2641\t+    return Revision(\n2642\t+        revision_id=f\"rev-specialize-{pid.lower()}\",\n2643\t+        type=\"SPECIALIZE\",\n2644\t+        parents=[pid],\n2645\t+        candidate_principles=[narrowed],\n2646\t+        motivating_evidence=sorted(motivating),\n2647\t+        context_partition={\"retained_contexts\": retained},\n2648\t+        status=\"CANDIDATE\")\n2649\t+\n2650\t+\n2651\t+def build_deprecate_candidate(pid: str, stats: dict[str, Any]) -> Revision:\n2652\t+    falsify = sorted(eid for c in stats[\"contexts\"].values()\n2653\t+                     for eid in c[\"event_ids\"] if c[\"FALSIFY\"])\n2654\t+    return Revision(\n2655\t+        revision_id=f\"rev-deprecate-{pid.lower()}\",\n2656\t+        type=\"DEPRECATE\",\n2657\t+        parents=[pid],\n2658\t+        candidate_principles=[],\n2659\t+        motivating_evidence=falsify,\n2660\t+        status=\"CANDIDATE\")\n2661\t+\n2662\t+\n2663\t+def explanation_scores(stats: dict[str, Any],\n2664\t+                       rules: dict[str, Any] = FROZEN_RULES,\n2665\t+                       ) -> dict[str, float]:\n2666\t+    \"\"\"Frozen explanation scoring over the parent's evidence events.\"\"\"\n2667\t+    total = stats[\"total_events\"]\n2668\t+    if total == 0:\n2669\t+        return {\"no-change\": 0.0, \"SPECIALIZE\": 0.0, \"SPLIT\": 0.0,\n2670\t+                \"DEPRECATE\": 0.0}\n2671\t+    floor = rules[\"reproducibility_floor\"]\n2672\t+    retained = {k for k, c in stats[\"contexts\"].items()\n2673\t+                if c[\"falsify_rate\"] is not None\n2674\t+                and c[\"falsify_rate\"] < rules[\"specialize_max_falsify_rate\"]}\n2675\t+    nc = sp = sl = dp = 0\n2676\t+    for kind, c in stats[\"contexts\"].items():\n2677\t+        s, f = c[\"SUPPORT\"], c[\"FALSIFY\"]\n2678\t+        nc += s\n2679\t+        dp += f\n2680\t+        sp += s if kind in retained else f\n2681\t+        sl += (s if s >= floor else 0) + (f if f >= floor else 0)\n2682\t+    return {\"no-change\": round(nc / total, 4),\n2683\t+            \"SPECIALIZE\": round(sp / total, 4),\n2684\t+            \"SPLIT\": round(sl / total, 4),\n2685\t+            \"DEPRECATE\": round(dp / total, 4)}\n2686\t+\n2687\t+\n2688\t+_TIE_ORDER = (\"no-change\", \"SPECIALIZE\", \"SPLIT\", \"DEPRECATE\")\n2689\t+\n2690\t+\n2691\t+def propose_revision_v2(theory: TheoryVersion, events: list[Any],\n2692\t+                        target: str = \"P-INDEPENDENCE\",\n2693\t+                        wording: Optional[dict[str, str]] = None,\n2694\t+                        rules: dict[str, Any] = FROZEN_RULES,\n2695\t+                        ) -> dict[str, Any]:\n2696\t+    \"\"\"Generate the frozen candidate family, score, and select. Returns a\n2697\t+    serializable proposal document; the selected Revision (if any) is\n2698\t+    CANDIDATE and promotes nothing.\"\"\"\n2699\t+    stats = context_stats(events, target)\n2700\t+    trigger = split_trigger(stats, rules)\n2701\t+    candidates: dict[str, Optional[Revision]] = {\n2702\t+        \"no-change\": None,\n2703\t+        \"SPECIALIZE\": build_specialize_candidate(theory, target, stats,\n2704\t+                                                 rules),\n2705\t+        \"DEPRECATE\": build_deprecate_candidate(target, stats),\n2706\t+    }\n2707\t+    if trigger[\"eligible\"]:\n2708\t+        candidates[\"SPLIT\"] = build_split_candidate(theory, target, stats,\n2709\t+                                                    wording, rules)\n2710\t+    scores = explanation_scores(stats, rules)\n2711\t+    if \"SPLIT\" not in candidates:\n2712\t+        scores = {k: v for k, v in scores.items() if k != \"SPLIT\"}\n2713\t+\n2714\t+    def key(name: str):\n2715\t+        rev = candidates.get(name)\n2716\t+        n_new = len(rev.candidate_principles) if rev else 0\n2717\t+        return (-scores[name], n_new, _TIE_ORDER.index(name))\n2718\t+\n2719\t+    selected = sorted(scores, key=key)[0]\n2720\t+    return {\n2721\t+        \"artifact\": \"revision proposal v2\",\n2722\t+        \"target_principle\": target,\n2723\t+        \"context_stats\": stats,\n2724\t+        \"split_trigger\": trigger,\n2725\t+        \"scores\": scores,\n2726\t+        \"selection_rule\": \"max explanation score; ties -> fewer new \"\n2727\t+                          \"principles -> fixed order \"\n2728\t+                          \"[no-change, SPECIALIZE, SPLIT, DEPRECATE]\",\n2729\t+        \"selected\": selected,\n2730\t+        \"candidates\": {k: (v.to_dict() if v else None)\n2731\t+                       for k, v in candidates.items()},\n2732\t+        \"rules\": dict(rules),\n2733\t+    }\n2734\tdiff --git a/.creator-zero/topology-theory/self_modify.py b/.creator-zero/topology-theory/self_modify.py\n2735\tindex 8a1497a..77288b4 100644\n2736\t--- a/.creator-zero/topology-theory/self_modify.py\n2737\t+++ b/.creator-zero/topology-theory/self_modify.py\n2738\t@@ -39,6 +39,7 @@ PROTECTED_PREFIXES = (\n2739\t     \".creator-zero/experiment-4/\",\n2740\t     \".creator-zero/experiment-4c/\",\n2741\t     \".creator-zero/experiment-5/\",\n2742\t+    \".creator-zero/experiment-6/\",\n2743\t )\n2744\t PROTECTED_FILES = (\n2745\t     \".creator-zero/state/experiment-2.json\",\n2746\t@@ -46,6 +47,7 @@ PROTECTED_FILES = (\n2747\t     \".creator-zero/state/experiment-4.json\",\n2748\t     \".creator-zero/state/experiment-4c.json\",\n2749\t     \".creator-zero/state/experiment-5.json\",\n2750\t+    \".creator-zero/state/experiment-6.json\",\n2751\t     \".creator-zero/state/formal-semantics-v0.1.json\",\n2752\t     \".creator-zero/contracts/root_contract.json\",\n2753\t )\n2754\tdiff --git a/.creator-zero/topology-theory/theory_gate.py b/.creator-zero/topology-theory/theory_gate.py\n2755\tnew file mode 100644\n2756\tindex 0000000..87fcb61\n2757\t--- /dev/null\n2758\t+++ b/.creator-zero/topology-theory/theory_gate.py\n2759\t@@ -0,0 +1,80 @@\n2760\t+\"\"\"Two-stage theory promotion gating (Experiment 7 semantics).\n2761\t+\n2762\t+Stage 1 — evaluation_authorization(): deterministic conjunction that\n2763\t+authorizes a CANDIDATE theory to enter held-out validation. Its result is\n2764\t+deliberately NOT gate-shaped (check='evaluation_authorization',\n2765\t+issued_by='evaluation_authorization'): TheoryStore.promote refuses it, so\n2766\t+authorization can never promote (NC17).\n2767\t+\n2768\t+Stage 2 — theory_gate(): the final deterministic theory Gate. It is the\n2769\t+only producer of the {\"check\":\"gate\",\"status\":\"PASS\",\"detail\":\n2770\t+{\"issued_by\":\"gate\"}} shape the store demands, and it requires every\n2771\t+stage-1 input PLUS held-out thresholds, paired improvement, governance,\n2772\t+and historical immutability. There is no second promotion API: promotion\n2773\t+still flows only through TheoryStore.promote(candidate, gate_result).\n2774\t+\"\"\"\n2775\t+from __future__ import annotations\n2776\t+from typing import Any\n2777\t+\n2778\t+from .self_modify import PASS, FAIL, _input_status\n2779\t+\n2780\t+REQUIRED_EVAL_INPUTS = (\n2781\t+    \"candidate_schema\", \"evidence_provenance\", \"historical_replay\",\n2782\t+    \"protected_laws\", \"tests_existing\", \"tests_new\", \"independent_verifier\",\n2783\t+)\n2784\t+\n2785\t+REQUIRED_THEORY_GATE_INPUTS = REQUIRED_EVAL_INPUTS + (\n2786\t+    \"evaluation_authorization\", \"heldout_thresholds\", \"paired_improvement\",\n2787\t+    \"governance\", \"historical_immutability\",\n2788\t+)\n2789\t+\n2790\t+\n2791\t+def _conjunction(required: tuple[str, ...], inputs: dict[str, Any]\n2792\t+                 ) -> tuple[str, dict[str, str], list[str]]:\n2793\t+    clauses: dict[str, str] = {}\n2794\t+    for k in required:\n2795\t+        clauses[k] = \"MISSING\" if k not in inputs else _input_status(\n2796\t+            inputs[k])\n2797\t+    failed = sorted(k for k, v in clauses.items() if v != PASS)\n2798\t+    return (PASS if not failed else FAIL), clauses, failed\n2799\t+\n2800\t+\n2801\t+def evaluation_authorization(inputs: dict[str, Any]) -> dict[str, Any]:\n2802\t+    status, clauses, failed = _conjunction(REQUIRED_EVAL_INPUTS, inputs)\n2803\t+    return {\n2804\t+        \"check\": \"evaluation_authorization\",\n2805\t+        \"status\": status,\n2806\t+        \"formal_relation\": \"conjunction over stage-1 verification inputs; \"\n2807\t+                           \"authorizes held-out evaluation only — this \"\n2808\t+                           \"result cannot promote a theory\",\n2809\t+        \"counterexample\": ({\"violation\": \"EVALUATION_AUTHORIZATION_FAIL\",\n2810\t+                            \"failed_or_missing_inputs\": failed}\n2811\t+                           if failed else None),\n2812\t+        \"evidence\": [f\"{k}: {v}\" for k, v in sorted(clauses.items())],\n2813\t+        \"detail\": {\"issued_by\": \"evaluation_authorization\",\n2814\t+                   \"clauses\": clauses},\n2815\t+    }\n2816\t+\n2817\t+\n2818\t+def theory_gate(inputs: dict[str, Any]) -> dict[str, Any]:\n2819\t+    \"\"\"Final deterministic theory Gate. Pure conjunction; no model input.\"\"\"\n2820\t+    status, clauses, failed = _conjunction(REQUIRED_THEORY_GATE_INPUTS,\n2821\t+                                           inputs)\n2822\t+    return {\n2823\t+        \"check\": \"gate\",\n2824\t+        \"status\": status,\n2825\t+        \"formal_relation\": \"conjunction of stage-1 inputs + held-out \"\n2826\t+                           \"thresholds + paired improvement + governance + \"\n2827\t+                           \"historical immutability\",\n2828\t+        \"counterexample\": ({\"violation\": \"THEORY_GATE_FAIL\",\n2829\t+                            \"failed_or_missing_inputs\": failed}\n2830\t+                           if failed else None),\n2831\t+        \"evidence\": [f\"{k}: {v}\" for k, v in sorted(clauses.items())],\n2832\t+        \"assumptions\": [\n2833\t+            \"The gate decides only over the serialized verification inputs \"\n2834\t+            \"listed; it re-checks nothing and re-runs nothing.\",\n2835\t+            \"Held-out threshold and paired-improvement inputs were computed \"\n2836\t+            \"by the preregistered deterministic scorers.\",\n2837\t+        ],\n2838\t+        \"detail\": {\"issued_by\": \"gate\", \"clauses\": clauses},\n2839\t+    }\n2840\tdiff --git a/.creator-zero/topology-theory/validate.py b/.creator-zero/topology-theory/validate.py\n2841\tindex 3e3ba65..f241bd4 100644\n2842\t--- a/.creator-zero/topology-theory/validate.py\n2843\t+++ b/.creator-zero/topology-theory/validate.py\n2844\t@@ -47,6 +47,7 @@ RELATION = \"Candidate admissible under deterministic pre-execution checks\"\n2845\t \n2846\t PROTECTED_PATH_PREFIXES = (\n2847\t     \"experiment-3\", \"experiment-4\", \"experiment-4c\", \"experiment-5\",\n2848\t+    \"experiment-6\",\n2849\t     \"state/experiment-\", \"state/formal-semantics-\", \"contracts/root_contract\",\n2850\t )\n2851\t \n2852\t"}]},"parent_tool_use_id":null,"session_id":"371b7f47-bc11-46c7-971a-b334740ebdc3","uuid":"e767dc0e-1884-4659-9f1f-d6de69824d50","timestamp":"2026-08-09T19:44:11.677Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-0/-home-user-creator-0/87cd2a2d-a4f9-585b-836f-2648df7a6284/scratchpad/e7/verifier-infra-ws/candidate-patch.diff","content":"+        revision_id=f\"rev-split-{pid.lower()}\",\n+        type=\"SPLIT\",\n+        parents=[pid],\n+        candidate_principles=children,\n+        motivating_evidence=sorted(motivating),\n+        historical_cases_affected=[],\n+        changed_predictions=[\n+            \"typed admissibility replaces coarse isolation preference in \"\n+            \"topology generation and ranking\",\n+            \"an examiner (not an isolated child) is predicted optimal for \"\n+            \"pure NON_AUTHOR_SEARCH requirements\",\n+            \"a method-disjoint verifier (not an isolated child) is \"\n+            \"predicted optimal for METHOD_DISJOINT_VERIFICATION\",\n+        ],\n+        context_partition=partition,\n+        status=\"CANDIDATE\")\n+\n+\n+def build_specialize_candidate(theory: TheoryVersion, pid: str,\n+                               stats: dict[str, Any],\n+                               rules: dict[str, Any] = FROZEN_RULES,\n+                               ) -> Revision:\n+    parent = theory.principle(pid)\n+    retained = sorted(\n+        k for k, c in stats[\"contexts\"].items()\n+        if c[\"falsify_rate\"] is not None\n+        and c[\"falsify_rate\"] < rules[\"specialize_max_falsify_rate\"])\n+    narrowed = dict(parent.to_dict()) if parent else {\"id\": pid}\n+    narrowed.update({\n+        \"id\": f\"{pid}-SPECIALIZED\",\n+        \"status\": \"CANDIDATE\",\n+        \"parent_principles\": [pid],\n+        \"version\": 1,\n+        \"statement\": (parent.statement if parent else \"\") +\n+        f\" [SPECIALIZED: preconditions narrowed to admissibility contexts \"\n+        f\"{retained} in which the principle's predictions held]\",\n+    })\n+    motivating = []\n+    for k, c in stats[\"contexts\"].items():\n+        if k not in retained:\n+            motivating.extend(c[\"event_ids\"])\n+    return Revision(\n+        revision_id=f\"rev-specialize-{pid.lower()}\",\n+        type=\"SPECIALIZE\",\n+        parents=[pid],\n+        candidate_principles=[narrowed],\n+        motivating_evidence=sorted(motivating),\n+        context_partition={\"retained_contexts\": retained},\n+        status=\"CANDIDATE\")\n+\n+\n+def build_deprecate_candidate(pid: str, stats: dict[str, Any]) -> Revision:\n+    falsify = sorted(eid for c in stats[\"contexts\"].values()\n+                     for eid in c[\"event_ids\"] if c[\"FALSIFY\"])\n+    return Revision(\n+        revision_id=f\"rev-deprecate-{pid.lower()}\",\n+        type=\"DEPRECATE\",\n+        parents=[pid],\n+        candidate_principles=[],\n+        motivating_evidence=falsify,\n+        status=\"CANDIDATE\")\n+\n+\n+def explanation_scores(stats: dict[str, Any],\n+                       rules: dict[str, Any] = FROZEN_RULES,\n+                       ) -> dict[str, float]:\n+    \"\"\"Frozen explanation scoring over the parent's evidence events.\"\"\"\n+    total = stats[\"total_events\"]\n+    if total == 0:\n+        return {\"no-change\": 0.0, \"SPECIALIZE\": 0.0, \"SPLIT\": 0.0,\n+                \"DEPRECATE\": 0.0}\n+    floor = rules[\"reproducibility_floor\"]\n+    retained = {k for k, c in stats[\"contexts\"].items()\n+                if c[\"falsify_rate\"] is not None\n+                and c[\"falsify_rate\"] < rules[\"specialize_max_falsify_rate\"]}\n+    nc = sp = sl = dp = 0\n+    for kind, c in stats[\"contexts\"].items():\n+        s, f = c[\"SUPPORT\"], c[\"FALSIFY\"]\n+        nc += s\n+        dp += f\n+        sp += s if kind in retained else f\n+        sl += (s if s >= floor else 0) + (f if f >= floor else 0)\n+    return {\"no-change\": round(nc / total, 4),\n+            \"SPECIALIZE\": round(sp / total, 4),\n+            \"SPLIT\": round(sl / total, 4),\n+            \"DEPRECATE\": round(dp / total, 4)}\n+\n+\n+_TIE_ORDER = (\"no-change\", \"SPECIALIZE\", \"SPLIT\", \"DEPRECATE\")\n+\n+\n+def propose_revision_v2(theory: TheoryVersion, events: list[Any],\n+                        target: str = \"P-INDEPENDENCE\",\n+                        wording: Optional[dict[str, str]] = None,\n+                        rules: dict[str, Any] = FROZEN_RULES,\n+                        ) -> dict[str, Any]:\n+    \"\"\"Generate the frozen candidate family, score, and select. Returns a\n+    serializable proposal document; the selected Revision (if any) is\n+    CANDIDATE and promotes nothing.\"\"\"\n+    stats = context_stats(events, target)\n+    trigger = split_trigger(stats, rules)\n+    candidates: dict[str, Optional[Revision]] = {\n+        \"no-change\": None,\n+        \"SPECIALIZE\": build_specialize_candidate(theory, target, stats,\n+                                                 rules),\n+        \"DEPRECATE\": build_deprecate_candidate(target, stats),\n+    }\n+    if trigger[\"eligible\"]:\n+        candidates[\"SPLIT\"] = build_split_candidate(theory, target, stats,\n+                                                    wording, rules)\n+    scores = explanation_scores(stats, rules)\n+    if \"SPLIT\" not in candidates:\n+        scores = {k: v for k, v in scores.items() if k != \"SPLIT\"}\n+\n+    def key(name: str):\n+        rev = candidates.get(name)\n+        n_new = len(rev.candidate_principles) if rev else 0\n+        return (-scores[name], n_new, _TIE_ORDER.index(name))\n+\n+    selected = sorted(scores, key=key)[0]\n+    return {\n+        \"artifact\": \"revision proposal v2\",\n+        \"target_principle\": target,\n+        \"context_stats\": stats,\n+        \"split_trigger\": trigger,\n+        \"scores\": scores,\n+        \"selection_rule\": \"max explanation score; ties -> fewer new \"\n+                          \"principles -> fixed order \"\n+                          \"[no-change, SPECIALIZE, SPLIT, DEPRECATE]\",\n+        \"selected\": selected,\n+        \"candidates\": {k: (v.to_dict() if v else None)\n+                       for k, v in candidates.items()},\n+        \"rules\": dict(rules),\n+    }\ndiff --git a/.creator-zero/topology-theory/self_modify.py b/.creator-zero/topology-theory/self_modify.py\nindex 8a1497a..77288b4 100644\n--- a/.creator-zero/topology-theory/self_modify.py\n+++ b/.creator-zero/topology-theory/self_modify.py\n@@ -39,6 +39,7 @@ PROTECTED_PREFIXES = (\n     \".creator-zero/experiment-4/\",\n     \".creator-zero/experiment-4c/\",\n     \".creator-zero/experiment-5/\",\n+    \".creator-zero/experiment-6/\",\n )\n PROTECTED_FILES = (\n     \".creator-zero/state/experiment-2.json\",\n@@ -46,6 +47,7 @@ PROTECTED_FILES = (\n     \".creator-zero/state/experiment-4.json\",\n     \".creator-zero/state/experiment-4c.json\",\n     \".creator-zero/state/experiment-5.json\",\n+    \".creator-zero/state/experiment-6.json\",\n     \".creator-zero/state/formal-semantics-v0.1.json\",\n     \".creator-zero/contracts/root_contract.json\",\n )\ndiff --git a/.creator-zero/topology-theory/theory_gate.py b/.creator-zero/topology-theory/theory_gate.py\nnew file mode 100644\nindex 0000000..87fcb61\n--- /dev/null\n+++ b/.creator-zero/topology-theory/theory_gate.py\n@@ -0,0 +1,80 @@\n+\"\"\"Two-stage theory promotion gating (Experiment 7 semantics).\n+\n+Stage 1 — evaluation_authorization(): deterministic conjunction that\n+authorizes a CANDIDATE theory to enter held-out validation. Its result is\n+deliberately NOT gate-shaped (check='evaluation_authorization',\n+issued_by='evaluation_authorization'): TheoryStore.promote refuses it, so\n+authorization can never promote (NC17).\n+\n+Stage 2 — theory_gate(): the final deterministic theory Gate. It is the\n+only producer of the {\"check\":\"gate\",\"status\":\"PASS\",\"detail\":\n+{\"issued_by\":\"gate\"}} shape the store demands, and it requires every\n+stage-1 input PLUS held-out thresholds, paired improvement, governance,\n+and historical immutability. There is no second promotion API: promotion\n+still flows only through TheoryStore.promote(candidate, gate_result).\n+\"\"\"\n+from __future__ import annotations\n+from typing import Any\n+\n+from .self_modify import PASS, FAIL, _input_status\n+\n+REQUIRED_EVAL_INPUTS = (\n+    \"candidate_schema\", \"evidence_provenance\", \"historical_replay\",\n+    \"protected_laws\", \"tests_existing\", \"tests_new\", \"independent_verifier\",\n+)\n+\n+REQUIRED_THEORY_GATE_INPUTS = REQUIRED_EVAL_INPUTS + (\n+    \"evaluation_authorization\", \"heldout_thresholds\", \"paired_improvement\",\n+    \"governance\", \"historical_immutability\",\n+)\n+\n+\n+def _conjunction(required: tuple[str, ...], inputs: dict[str, Any]\n+                 ) -> tuple[str, dict[str, str], list[str]]:\n+    clauses: dict[str, str] = {}\n+    for k in required:\n+        clauses[k] = \"MISSING\" if k not in inputs else _input_status(\n+            inputs[k])\n+    failed = sorted(k for k, v in clauses.items() if v != PASS)\n+    return (PASS if not failed else FAIL), clauses, failed\n+\n+\n+def evaluation_authorization(inputs: dict[str, Any]) -> dict[str, Any]:\n+    status, clauses, failed = _conjunction(REQUIRED_EVAL_INPUTS, inputs)\n+    return {\n+        \"check\": \"evaluation_authorization\",\n+        \"status\": status,\n+        \"formal_relation\": \"conjunction over stage-1 verification inputs; \"\n+                           \"authorizes held-out evaluation only — this \"\n+                           \"result cannot promote a theory\",\n+        \"counterexample\": ({\"violation\": \"EVALUATION_AUTHORIZATION_FAIL\",\n+                            \"failed_or_missing_inputs\": failed}\n+                           if failed else None),\n+        \"evidence\": [f\"{k}: {v}\" for k, v in sorted(clauses.items())],\n+        \"detail\": {\"issued_by\": \"evaluation_authorization\",\n+                   \"clauses\": clauses},\n+    }\n+\n+\n+def theory_gate(inputs: dict[str, Any]) -> dict[str, Any]:\n+    \"\"\"Final deterministic theory Gate. Pure conjunction; no model input.\"\"\"\n+    status, clauses, failed = _conjunction(REQUIRED_THEORY_GATE_INPUTS,\n+                                           inputs)\n+    return {\n+        \"check\": \"gate\",\n+        \"status\": status,\n+        \"formal_relation\": \"conjunction of stage-1 inputs + held-out \"\n+                           \"thresholds + paired improvement + governance + \"\n+                           \"historical immutability\",\n+        \"counterexample\": ({\"violation\": \"THEORY_GATE_FAIL\",\n+                            \"failed_or_missing_inputs\": failed}\n+                           if failed else None),\n+        \"evidence\": [f\"{k}: {v}\" for k, v in sorted(clauses.items())],\n+        \"assumptions\": [\n+            \"The gate decides only over the serialized verification inputs \"\n+            \"listed; it re-checks nothing and re-runs nothing.\",\n+            \"Held-out threshold and paired-improvement inputs were computed \"\n+            \"by the preregistered deterministic scorers.\",\n+        ],\n+        \"detail\": {\"issued_by\": \"gate\", \"clauses\": clauses},\n+    }\ndiff --git a/.creator-zero/topology-theory/validate.py b/.creator-zero/topology-theory/validate.py\nindex 3e3ba65..f241bd4 100644\n--- a/.creator-zero/topology-theory/validate.py\n+++ b/.creator-zero/topology-theory/validate.py\n@@ -47,6 +47,7 @@ RELATION = \"Candidate admissible under deterministic pre-execution checks\"\n \n PROTECTED_PATH_PREFIXES = (\n     \"experiment-3\", \"experiment-4\", \"experiment-4c\", \"experiment-5\",\n+    \"experiment-6\",\n     \"state/experiment-\", \"state/formal-semantics-\", \"contracts/root_contract\",\n )\n \n","numLines":253,"startLine":2600,"totalLines":2852}}}
