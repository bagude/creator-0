{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WR16xzJkYGS7E5txHHcxgD","type":"tool_result","content":"1\tdiff --git a/.creator-zero/lineage/__init__.py b/.creator-zero/lineage/__init__.py\n2\tnew file mode 100644\n3\tindex 0000000..f18515a\n4\t--- /dev/null\n5\t+++ b/.creator-zero/lineage/__init__.py\n6\t@@ -0,0 +1,24 @@\n7\t+\"\"\"Creator-0 lineage subsystem: externally reconstructible checkpoints.\n8\t+\n9\t+A LineageCheckpoint is evidence about inherited state, not hidden-state\n10\t+continuity: the successor session reconstructs governed state from pinned\n11\t+artifacts (X_{n+1,0} ~=_Lambda_O X_{n,checkpoint}), never from process\n12\t+memory (Z_{n+1} != Z_n is expected and irrelevant).\n13\t+\n14\t+    create_checkpoint(repo_root, ...)       -> LineageCheckpoint\n15\t+    verify_checkpoint(repo_root, cp)        -> CheckpointResult (idempotent)\n16\t+    resume_from_checkpoint(repo_root, cp, destination) -> resume record\n17\t+\n18\t+Verification is a deterministic conjunction with typed failure codes; any\n19\t+critical mismatch maps to LINEAGE_RESUME_FAIL in the caller. No model input\n20\t+reaches any check. The package directory is importable directly (no hyphen).\n21\t+\"\"\"\n22\t+from .model import (LineageCheckpoint, CheckpointResult, LineageError,\n23\t+                    FAILURE_CODES)\n24\t+from .checkpoint import create_checkpoint\n25\t+from .verify import verify_checkpoint\n26\t+from .resume import resume_from_checkpoint\n27\t+\n28\t+__all__ = [\"LineageCheckpoint\", \"CheckpointResult\", \"LineageError\",\n29\t+           \"FAILURE_CODES\", \"create_checkpoint\", \"verify_checkpoint\",\n30\t+           \"resume_from_checkpoint\"]\n31\tdiff --git a/.creator-zero/lineage/_common.py b/.creator-zero/lineage/_common.py\n32\tnew file mode 100644\n33\tindex 0000000..b0dcc02\n34\t--- /dev/null\n35\t+++ b/.creator-zero/lineage/_common.py\n36\t@@ -0,0 +1,44 @@\n37\t+\"\"\"Shared deterministic helpers for the lineage subsystem.\"\"\"\n38\t+from __future__ import annotations\n39\t+import hashlib\n40\t+import importlib\n41\t+import importlib.util\n42\t+import json\n43\t+import subprocess\n44\t+import sys\n45\t+from pathlib import Path\n46\t+from typing import Any\n47\t+\n48\t+CZROOT = Path(__file__).resolve().parents[1]\n49\t+\n50\t+\n51\t+def sha256_file(p: Path | str) -> str:\n52\t+    return hashlib.sha256(Path(p).read_bytes()).hexdigest()\n53\t+\n54\t+\n55\t+def git(repo_root: Path | str, *args: str) -> str:\n56\t+    return subprocess.run([\"git\", *args], cwd=repo_root, capture_output=True,\n57\t+                          text=True, check=True).stdout.strip()\n58\t+\n59\t+\n60\t+def git_ok(repo_root: Path | str, *args: str) -> bool:\n61\t+    return subprocess.run([\"git\", *args], cwd=repo_root,\n62\t+                          capture_output=True).returncode == 0\n63\t+\n64\t+\n65\t+def tt_mod(name: str):\n66\t+    \"\"\"Load a topology-theory submodule through the package machinery.\"\"\"\n67\t+    pkg_dir = CZROOT / \"topology-theory\"\n68\t+    if \"cz_topology_theory\" not in sys.modules:\n69\t+        spec = importlib.util.spec_from_file_location(\n70\t+            \"cz_topology_theory\", pkg_dir / \"__init__.py\",\n71\t+            submodule_search_locations=[str(pkg_dir)])\n72\t+        pkg = importlib.util.module_from_spec(spec)\n73\t+        sys.modules[\"cz_topology_theory\"] = pkg\n74\t+        spec.loader.exec_module(pkg)\n75\t+    return importlib.import_module(f\"cz_topology_theory.{name}\")\n76\t+\n77\t+\n78\t+def protected_manifest_sha256(manifest: dict[str, Any]) -> str:\n79\t+    return hashlib.sha256(json.dumps(manifest, sort_keys=True,\n80\t+                          separators=(\",\", \":\")).encode(\"utf-8\")).hexdigest()\n81\tdiff --git a/.creator-zero/lineage/checkpoint.py b/.creator-zero/lineage/checkpoint.py\n82\tnew file mode 100644\n83\tindex 0000000..bea2620\n84\t--- /dev/null\n85\t+++ b/.creator-zero/lineage/checkpoint.py\n86\t@@ -0,0 +1,92 @@\n87\t+\"\"\"Checkpoint creation: pin every governed identity of the current state.\"\"\"\n88\t+from __future__ import annotations\n89\t+import json\n90\t+from pathlib import Path\n91\t+from typing import Any, Optional\n92\t+\n93\t+from ._common import (CZROOT, git, protected_manifest_sha256, sha256_file,\n94\t+                      tt_mod)\n95\t+from .model import (LineageCheckpoint, LineageError, SCHEMA_VERSION,\n96\t+                    checkpoint_id_for)\n97\t+\n98\t+\n99\t+def create_checkpoint(repo_root: str | Path, *,\n100\t+                      commit_sha: str,\n101\t+                      source_branch: str,\n102\t+                      experiment_id: str,\n103\t+                      experiment_state_path: str,\n104\t+                      experiment_result: str,\n105\t+                      protected_manifest: dict[str, Any],\n106\t+                      theory_version: Optional[int] = None,\n107\t+                      parent_checkpoint_id: Optional[str] = None,\n108\t+                      provenance: Optional[dict[str, Any]] = None,\n109\t+                      artifact_label: str = \"lineage checkpoint\",\n110\t+                      ) -> LineageCheckpoint:\n111\t+    \"\"\"Build an immutable checkpoint of the repo's governed state.\n112\t+\n113\t+    Every identity is computed from the repository, never accepted from a\n114\t+    caller-supplied claim (the caller names WHAT to pin; the values are\n115\t+    measured).\"\"\"\n116\t+    root = Path(repo_root)\n117\t+    czroot = root / \".creator-zero\"\n118\t+    if not czroot.is_dir():\n119\t+        raise LineageError(f\"{root} is not a Creator-0 repository root\")\n120\t+\n121\t+    tree_sha = git(root, \"rev-parse\", f\"{commit_sha}^{{tree}}\")\n122\t+\n123\t+    store_mod = tt_mod(\"theory_store\")\n124\t+    store = store_mod.TheoryStore(czroot / \"state\" / \"topology-theory\")\n125\t+    versions = store.versions()\n126\t+    if not versions:\n127\t+        raise LineageError(\"no theory versions to checkpoint\")\n128\t+    tv = versions[-1] if theory_version is None else int(theory_version)\n129\t+    theory = store.load(tv)\n130\t+    length, head = store.evidence_head()\n131\t+    chain = store.verify_append_only()\n132\t+    if not chain[\"append_only_intact\"]:\n133\t+        raise LineageError(\"refusing to checkpoint a store whose evidence \"\n134\t+                           \"chain is not intact\")\n135\t+\n136\t+    body: dict[str, Any] = {\n137\t+        \"artifact\": artifact_label,\n138\t+        \"schema_version\": SCHEMA_VERSION,\n139\t+        \"commit_sha\": commit_sha,\n140\t+        \"tree_sha\": tree_sha,\n141\t+        \"source_branch\": source_branch,\n142\t+        \"theory_version\": theory.version,\n143\t+        \"theory_artifact_id\": store.version_hash(theory.version),\n144\t+        \"theory_status\": theory.status,\n145\t+        \"evidence_length\": length,\n146\t+        \"evidence_head_hash\": head,\n147\t+        \"root_contract_sha256\": sha256_file(\n148\t+            czroot / \"contracts\" / \"root_contract.json\"),\n149\t+        \"formal_kernel_state_artifact_id\": sha256_file(\n150\t+            czroot / \"state\" / \"formal-semantics-v0.1.json\"),\n151\t+        \"protected_manifest_sha256\": protected_manifest_sha256(\n152\t+            protected_manifest),\n153\t+        \"protected_manifest\": dict(protected_manifest),\n154\t+        \"experiment_id\": experiment_id,\n155\t+        \"experiment_state_path\": experiment_state_path,\n156\t+        \"experiment_state_sha256\": sha256_file(root / experiment_state_path),\n157\t+        \"experiment_result\": experiment_result,\n158\t+        \"parent_checkpoint_id\": parent_checkpoint_id,\n159\t+        \"provenance\": dict(provenance or {}),\n160\t+    }\n161\t+    body[\"checkpoint_id\"] = checkpoint_id_for(body)\n162\t+    return LineageCheckpoint.from_dict(body)\n163\t+\n164\t+\n165\t+def write_checkpoint(cp: LineageCheckpoint, path: str | Path) -> Path:\n166\t+    \"\"\"Write-once persistence: an existing checkpoint file is never\n167\t+    overwritten (checkpoints are immutable).\"\"\"\n168\t+    p = Path(path)\n169\t+    if p.exists():\n170\t+        raise LineageError(f\"refusing to overwrite existing checkpoint {p}\")\n171\t+    p.parent.mkdir(parents=True, exist_ok=True)\n172\t+    p.write_text(cp.serialize(), encoding=\"utf-8\")\n173\t+    return p\n174\t+\n175\t+\n176\t+def load_checkpoint(path: str | Path) -> LineageCheckpoint:\n177\t+    return LineageCheckpoint.from_dict(\n178\t+        json.loads(Path(path).read_text(encoding=\"utf-8\")))\n179\tdiff --git a/.creator-zero/lineage/model.py b/.creator-zero/lineage/model.py\n180\tnew file mode 100644\n181\tindex 0000000..1a97393\n182\t--- /dev/null\n183\t+++ b/.creator-zero/lineage/model.py\n184\t@@ -0,0 +1,106 @@\n185\t+\"\"\"Typed lineage objects: immutable checkpoint + verification result.\"\"\"\n186\t+from __future__ import annotations\n187\t+import hashlib\n188\t+import json\n189\t+from dataclasses import dataclass, field, asdict\n190\t+from typing import Any, Optional\n191\t+\n192\t+SCHEMA_VERSION = \"lineage-checkpoint-v1\"\n193\t+\n194\t+FAILURE_CODES = (\n195\t+    \"COMMIT_MISMATCH\", \"TREE_MISMATCH\", \"THEORY_MISMATCH\",\n196\t+    \"EVIDENCE_HEAD_MISMATCH\", \"ROOT_CONTRACT_MISMATCH\",\n197\t+    \"FORMAL_KERNEL_MISMATCH\", \"EXPERIMENT_STATE_MISMATCH\",\n198\t+    \"PROTECTED_MANIFEST_MISMATCH\", \"EVIDENCE_SOURCE_MISMATCH\",\n199\t+)\n200\t+\n201\t+\n202\t+class LineageError(RuntimeError):\n203\t+    \"\"\"Lineage invariant violation (malformed checkpoint, refused resume).\"\"\"\n204\t+\n205\t+\n206\t+def canonical_dumps(obj: Any) -> str:\n207\t+    return json.dumps(obj, indent=2, sort_keys=True, ensure_ascii=False) + \"\\n\"\n208\t+\n209\t+\n210\t+def checkpoint_id_for(body: dict[str, Any]) -> str:\n211\t+    \"\"\"Deterministic checkpoint identity over the body without its own id.\"\"\"\n212\t+    d = {k: v for k, v in body.items() if k != \"checkpoint_id\"}\n213\t+    return \"sha256:\" + hashlib.sha256(\n214\t+        (json.dumps(d, sort_keys=True, separators=(\",\", \":\"))\n215\t+         + \"\\x00creator-0/lineage/checkpoint\").encode(\"utf-8\")).hexdigest()\n216\t+\n217\t+\n218\t+@dataclass(frozen=True)\n219\t+class LineageCheckpoint:\n220\t+    schema_version: str\n221\t+    checkpoint_id: str\n222\t+\n223\t+    commit_sha: str\n224\t+    tree_sha: str\n225\t+    source_branch: str\n226\t+\n227\t+    theory_version: int\n228\t+    theory_artifact_id: str\n229\t+    theory_status: str\n230\t+\n231\t+    evidence_length: int\n232\t+    evidence_head_hash: str\n233\t+\n234\t+    root_contract_sha256: str\n235\t+    formal_kernel_state_artifact_id: str\n236\t+    protected_manifest_sha256: str\n237\t+    protected_manifest: dict[str, Any] = field(default_factory=dict)\n238\t+\n239\t+    experiment_id: str = \"\"\n240\t+    experiment_state_path: str = \"\"\n241\t+    experiment_state_sha256: str = \"\"\n242\t+    experiment_result: str = \"\"\n243\t+\n244\t+    parent_checkpoint_id: Optional[str] = None\n245\t+    provenance: dict[str, Any] = field(default_factory=dict)\n246\t+    artifact: str = \"\"\n247\t+\n248\t+    def __post_init__(self):\n249\t+        if self.schema_version != SCHEMA_VERSION:\n250\t+            raise LineageError(\n251\t+                f\"unsupported checkpoint schema {self.schema_version!r}\")\n252\t+        for name in (\"commit_sha\", \"tree_sha\", \"source_branch\",\n253\t+                     \"theory_artifact_id\"):\n254\t+            if not getattr(self, name):\n255\t+                raise LineageError(f\"checkpoint missing {name}\")\n256\t+        expected = checkpoint_id_for(self.to_dict())\n257\t+        if self.checkpoint_id != expected:\n258\t+            raise LineageError(\n259\t+                f\"checkpoint_id does not match content: {self.checkpoint_id} \"\n260\t+                f\"!= {expected} (checkpoints are immutable; a drifted id \"\n261\t+                \"means the body was edited after creation)\")\n262\t+\n263\t+    def to_dict(self) -> dict[str, Any]:\n264\t+        return asdict(self)\n265\t+\n266\t+    @classmethod\n267\t+    def from_dict(cls, d: dict[str, Any]) -> \"LineageCheckpoint\":\n268\t+        known = {k: d[k] for k in cls.__dataclass_fields__ if k in d}\n269\t+        unknown = set(d) - set(cls.__dataclass_fields__)\n270\t+        if unknown:\n271\t+            raise LineageError(\n272\t+                f\"checkpoint document carries unknown fields {sorted(unknown)}\"\n273\t+                \" (closed schema; nothing is silently dropped)\")\n274\t+        return cls(**known)\n275\t+\n276\t+    def serialize(self) -> str:\n277\t+        return canonical_dumps(self.to_dict())\n278\t+\n279\t+\n280\t+@dataclass\n281\t+class CheckpointResult:\n282\t+    checkpoint_id: str\n283\t+    status: str                      # PASS | FAIL\n284\t+    checks: dict[str, dict[str, Any]] = field(default_factory=dict)\n285\t+    failed: list[str] = field(default_factory=list)\n286\t+    failure_codes: list[str] = field(default_factory=list)\n287\t+    result: Optional[str] = None     # LINEAGE_RESUME_FAIL on failure\n288\t+\n289\t+    def to_dict(self) -> dict[str, Any]:\n290\t+        return asdict(self)\n291\tdiff --git a/.creator-zero/lineage/resume.py b/.creator-zero/lineage/resume.py\n292\tnew file mode 100644\n293\tindex 0000000..25e0932\n294\t--- /dev/null\n295\t+++ b/.creator-zero/lineage/resume.py\n296\t@@ -0,0 +1,64 @@\n297\t+\"\"\"Resume: realize a new causal trajectory from a verified checkpoint.\n298\t+\n299\t+    resume_from_checkpoint(repo_root, cp, destination, branch_name=None)\n300\t+\n301\t+Creates a git worktree rooted at exactly the checkpoint commit. The source\n302\t+branch is never moved, and resume refuses to run at all unless\n303\t+verify_checkpoint passes first (Resume(L,X)=⊥ on any mismatch). A resumed\n304\t+worktree is Branch(X_n, Δ_{n+1}): a descendant trajectory, not a restart\n305\t+and not hidden-state continuity.\n306\t+\"\"\"\n307\t+from __future__ import annotations\n308\t+from pathlib import Path\n309\t+from typing import Any, Optional\n310\t+\n311\t+from ._common import git\n312\t+from .model import LineageCheckpoint, LineageError\n313\t+from .verify import verify_checkpoint\n314\t+\n315\t+\n316\t+def resume_from_checkpoint(repo_root: str | Path,\n317\t+                           cp: LineageCheckpoint | dict[str, Any],\n318\t+                           destination: str | Path,\n319\t+                           branch_name: Optional[str] = None,\n320\t+                           ) -> dict[str, Any]:\n321\t+    if isinstance(cp, dict):\n322\t+        cp = LineageCheckpoint.from_dict(cp)\n323\t+    root = Path(repo_root)\n324\t+    dest = Path(destination)\n325\t+    if dest.exists():\n326\t+        raise LineageError(f\"resume destination already exists: {dest}\")\n327\t+\n328\t+    verification = verify_checkpoint(root, cp)\n329\t+    if verification.status != \"PASS\":\n330\t+        raise LineageError(\n331\t+            \"LINEAGE_RESUME_FAIL: checkpoint verification failed \"\n332\t+            f\"({verification.failure_codes}); resume refused\")\n333\t+\n334\t+    source_tip_before = git(root, \"rev-parse\", cp.commit_sha)\n335\t+    args = [\"worktree\", \"add\"]\n336\t+    if branch_name:\n337\t+        args += [\"-b\", branch_name]\n338\t+    args += [str(dest), cp.commit_sha]\n339\t+    git(root, *args)\n340\t+\n341\t+    head = git(dest, \"rev-parse\", \"HEAD\")\n342\t+    tree = git(dest, \"rev-parse\", \"HEAD^{tree}\")\n343\t+    if head != cp.commit_sha or tree != cp.tree_sha:\n344\t+        raise LineageError(\n345\t+            f\"resumed worktree does not sit at the checkpoint: head={head} \"\n346\t+            f\"tree={tree}\")\n347\t+    source_tip_after = git(root, \"rev-parse\", cp.commit_sha)\n348\t+    if source_tip_before != source_tip_after:\n349\t+        raise LineageError(\"source commit moved during resume\")\n350\t+\n351\t+    return {\n352\t+        \"artifact\": \"lineage resume record\",\n353\t+        \"checkpoint_id\": cp.checkpoint_id,\n354\t+        \"destination\": str(dest),\n355\t+        \"branch\": branch_name or \"(detached)\",\n356\t+        \"head\": head,\n357\t+        \"tree\": tree,\n358\t+        \"verification\": verification.to_dict(),\n359\t+        \"source_branch_unmodified\": True,\n360\t+    }\n361\tdiff --git a/.creator-zero/lineage/verify.py b/.creator-zero/lineage/verify.py\n362\tnew file mode 100644\n363\tindex 0000000..ac49913\n364\t--- /dev/null\n365\t+++ b/.creator-zero/lineage/verify.py\n366\t@@ -0,0 +1,144 @@\n367\t+\"\"\"Deterministic checkpoint verification.\n368\t+\n369\t+    Verify(L,X) = v_C ∧ v_T ∧ v_Θ ∧ v_E ∧ v_K ∧ v_G ∧ v_S\n370\t+\n371\t+Idempotent: verification reads state and writes nothing. Every clause\n372\t+reports a typed failure code from FAILURE_CODES; any failure maps the whole\n373\t+result to LINEAGE_RESUME_FAIL. Model output cannot override any clause.\n374\t+\"\"\"\n375\t+from __future__ import annotations\n376\t+import json\n377\t+import subprocess\n378\t+from pathlib import Path\n379\t+from typing import Any\n380\t+\n381\t+from ._common import git, git_ok, protected_manifest_sha256, sha256_file, \\\n382\t+    tt_mod\n383\t+from .model import CheckpointResult, LineageCheckpoint\n384\t+\n385\t+\n386\t+def verify_checkpoint(repo_root: str | Path,\n387\t+                      cp: LineageCheckpoint | dict[str, Any],\n388\t+                      ) -> CheckpointResult:\n389\t+    if isinstance(cp, dict):\n390\t+        cp = LineageCheckpoint.from_dict(cp)\n391\t+    root = Path(repo_root)\n392\t+    czroot = root / \".creator-zero\"\n393\t+    checks: dict[str, dict[str, Any]] = {}\n394\t+\n395\t+    def rec(name: str, code: str, ok: bool, why: str) -> None:\n396\t+        checks[name] = {\"status\": \"PASS\" if ok else \"FAIL\",\n397\t+                        \"failure_code\": None if ok else code, \"detail\": why}\n398\t+\n399\t+    # v_C — the pinned commit exists and is an ancestor of the current HEAD\n400\t+    commit_ok = False\n401\t+    try:\n402\t+        commit_ok = git(root, \"cat-file\", \"-t\", cp.commit_sha) == \"commit\"\n403\t+    except subprocess.CalledProcessError:\n404\t+        pass\n405\t+    ancestry = git_ok(root, \"merge-base\", \"--is-ancestor\", cp.commit_sha,\n406\t+                      \"HEAD\")\n407\t+    rec(\"commit\", \"COMMIT_MISMATCH\", commit_ok and ancestry,\n408\t+        f\"commit present={commit_ok}; ancestor_of_HEAD={ancestry}\")\n409\t+\n410\t+    # v_T — the pinned commit's tree matches the pinned tree\n411\t+    tree = \"\"\n412\t+    if commit_ok:\n413\t+        tree = git(root, \"rev-parse\", f\"{cp.commit_sha}^{{tree}}\")\n414\t+    rec(\"tree\", \"TREE_MISMATCH\", tree == cp.tree_sha,\n415\t+        f\"tree={tree[:12]} vs pinned {cp.tree_sha[:12]}\")\n416\t+\n417\t+    # v_Θ — theory version identity and status\n418\t+    store_mod = tt_mod(\"theory_store\")\n419\t+    store = store_mod.TheoryStore(czroot / \"state\" / \"topology-theory\")\n420\t+    try:\n421\t+        theory = store.load(cp.theory_version)\n422\t+        th_hash = store.version_hash(cp.theory_version)\n423\t+        rec(\"theory\", \"THEORY_MISMATCH\",\n424\t+            theory.status == cp.theory_status\n425\t+            and th_hash == cp.theory_artifact_id,\n426\t+            f\"theta-v{cp.theory_version} status={theory.status} \"\n427\t+            f\"hash={th_hash[:24]}…\")\n428\t+    except Exception as e:                       # store/schema failures\n429\t+        rec(\"theory\", \"THEORY_MISMATCH\", False, str(e))\n430\t+\n431\t+    # v_E — the pinned evidence head must be a valid prefix of the current\n432\t+    # append-only chain (the store legitimately grows after resume; what can\n433\t+    # never happen is a rewrite of the pinned prefix), and the chain intact.\n434\t+    length, head = store.evidence_head()\n435\t+    chain = store.verify_append_only()\n436\t+    if cp.evidence_length == 0 and not cp.evidence_head_hash:\n437\t+        prefix_ok = True\n438\t+        prefix_why = \"pinned empty head; any intact chain extends it\"\n439\t+    else:\n440\t+        prefix_ok = False\n441\t+        if store.heads_path.exists():\n442\t+            for line in store.heads_path.read_text(\n443\t+                    encoding=\"utf-8\").splitlines():\n444\t+                if not line.strip():\n445\t+                    continue\n446\t+                h = json.loads(line)\n447\t+                if int(h[\"length\"]) == cp.evidence_length and \\\n448\t+                        str(h[\"hash\"]) == cp.evidence_head_hash:\n449\t+                    prefix_ok = True\n450\t+                    break\n451\t+        prefix_why = (f\"pinned head ({cp.evidence_length},\"\n452\t+                      f\"{cp.evidence_head_hash[:16]}…) \"\n453\t+                      + (\"found in\" if prefix_ok else \"absent from\")\n454\t+                      + \" the head chain\")\n455\t+    rec(\"evidence_head\", \"EVIDENCE_HEAD_MISMATCH\",\n456\t+        prefix_ok and chain[\"append_only_intact\"],\n457\t+        f\"current head=({length},{head[:16]!r}); {prefix_why}; \"\n458\t+        f\"chain_intact={chain['append_only_intact']}\")\n459\t+\n460\t+    # v_G — root contract identity\n461\t+    rc = sha256_file(czroot / \"contracts\" / \"root_contract.json\")\n462\t+    rec(\"root_contract\", \"ROOT_CONTRACT_MISMATCH\",\n463\t+        rc == cp.root_contract_sha256, f\"sha256={rc[:16]}…\")\n464\t+\n465\t+    # v_K — formal kernel state identity\n466\t+    fk = sha256_file(czroot / \"state\" / \"formal-semantics-v0.1.json\")\n467\t+    rec(\"formal_kernel\", \"FORMAL_KERNEL_MISMATCH\",\n468\t+        fk == cp.formal_kernel_state_artifact_id, f\"sha256={fk[:16]}…\")\n469\t+\n470\t+    # v_S — experiment state identity and result\n471\t+    ok_s, why_s = False, \"experiment state not pinned\"\n472\t+    if cp.experiment_state_path:\n473\t+        p = root / cp.experiment_state_path\n474\t+        if p.exists():\n475\t+            es = sha256_file(p)\n476\t+            res = json.loads(p.read_text(encoding=\"utf-8\")).get(\"result\")\n477\t+            ok_s = (es == cp.experiment_state_sha256\n478\t+                    and res == cp.experiment_result)\n479\t+            why_s = f\"sha256={es[:16]}…; result={res!r}\"\n480\t+        else:\n481\t+            why_s = f\"missing {cp.experiment_state_path}\"\n482\t+    rec(\"experiment_state\", \"EXPERIMENT_STATE_MISMATCH\", ok_s, why_s)\n483\t+\n484\t+    # protected manifest + protected-history immutability vs pinned commit\n485\t+    pm_ok = protected_manifest_sha256(cp.protected_manifest) == \\\n486\t+        cp.protected_manifest_sha256\n487\t+    mutations: list[str] = []\n488\t+    if commit_ok:\n489\t+        targets = [p.rstrip(\"/\") for p in\n490\t+                   cp.protected_manifest.get(\"protected_prefixes\", [])]\n491\t+        targets += cp.protected_manifest.get(\"protected_files\", [])\n492\t+        for t in targets:\n493\t+            out = git(root, \"diff\", \"--diff-filter=MD\", \"--name-only\",\n494\t+                      cp.commit_sha, \"HEAD\", \"--\", t)\n495\t+            mutations.extend(out.splitlines())\n496\t+    rec(\"protected_manifest\", \"PROTECTED_MANIFEST_MISMATCH\",\n497\t+        pm_ok and not mutations,\n498\t+        f\"manifest_hash_ok={pm_ok}; historical_mutations={mutations}\")\n499\t+\n500\t+    failed = sorted(k for k, v in checks.items() if v[\"status\"] != \"PASS\")\n501\t+    codes = sorted({checks[k][\"failure_code\"] for k in failed\n502\t+                    if checks[k][\"failure_code\"]})\n503\t+    return CheckpointResult(\n504\t+        checkpoint_id=cp.checkpoint_id,\n505\t+        status=\"PASS\" if not failed else \"FAIL\",\n506\t+        checks=checks,\n507\t+        failed=failed,\n508\t+        failure_codes=codes,\n509\t+        result=None if not failed else \"LINEAGE_RESUME_FAIL\",\n510\t+    )\n511\tdiff --git a/.creator-zero/tests/topology_theory/test_admissibility_grammar_v2.py b/.creator-zero/tests/topology_theory/test_admissibility_grammar_v2.py\n512\tnew file mode 100644\n513\tindex 0000000..90505c1\n514\t--- /dev/null\n515\t+++ b/.creator-zero/tests/topology_theory/test_admissibility_grammar_v2.py\n516\t@@ -0,0 +1,209 @@\n517\t+\"\"\"Typed admissibility + grammar v2 + utility v2 (spec §20.3-20.5).\"\"\"\n518\t+from __future__ import annotations\n519\t+import json\n520\t+import unittest\n521\t+\n522\t+import _bootstrap\n523\t+from _bootstrap import CZROOT, TT\n524\t+\n525\t+A = TT.admissibility\n526\t+\n527\t+CONTRACT = json.loads((CZROOT / \"experiment-6\" / \"contracts\" /\n528\t+                       \"trial-contract.json\").read_text(encoding=\"utf-8\"))\n529\t+\n530\t+\n531\t+def req(kind, qid=\"Q1\", method=\"\"):\n532\t+    vec, roles = A.KIND_REQUIREMENT[kind]\n533\t+    return A.EvidenceRequirement(\n534\t+        requirement_id=f\"req-{qid}\", distinction_id=qid, kind=kind,\n535\t+        independence=A.IndependenceVector.of(vec), allowed_roles=roles,\n536\t+        primary_method_family=method)\n537\t+\n538\t+\n539\t+def prov(role, node=\"n1\", method=\"\"):\n540\t+    return A.provision_for_role(node, role, method_family=method)\n541\t+\n542\t+\n543\t+class AdmissibilityMatrixTest(unittest.TestCase):\n544\t+    def test_local_satisfies_local_requirement(self):\n545\t+        ok, _ = A.admissible(prov(\"local_author\"), req(\"LOCAL\"))\n546\t+        self.assertTrue(ok)\n547\t+\n548\t+    def test_clean_room_author_satisfies_authorship(self):\n549\t+        ok, _ = A.admissible(prov(\"clean_room_author\"),\n550\t+                             req(\"CLEAN_ROOM_AUTHORSHIP\"))\n551\t+        self.assertTrue(ok)\n552\t+\n553\t+    def test_clean_room_author_does_not_imply_decomposition(self):\n554\t+        ok, cl = A.admissible(prov(\"clean_room_author\"),\n555\t+                              req(\"INDEPENDENT_DECOMPOSITION\"))\n556\t+        self.assertFalse(ok)\n557\t+        self.assertFalse(cl[\"vector_satisfies\"])\n558\t+\n559\t+    def test_examiner_satisfies_search(self):\n560\t+        ok, _ = A.admissible(prov(\"non_author_examiner\"),\n561\t+                             req(\"NON_AUTHOR_SEARCH\"))\n562\t+        self.assertTrue(ok)\n563\t+\n564\t+    def test_verifier_does_not_imply_decomposition_or_search(self):\n565\t+        self.assertFalse(A.admissible(prov(\"method_disjoint_verifier\",\n566\t+                                           method=\"alt\"),\n567\t+                                      req(\"INDEPENDENT_DECOMPOSITION\"))[0])\n568\t+        self.assertFalse(A.admissible(prov(\"method_disjoint_verifier\",\n569\t+                                           method=\"alt\"),\n570\t+                                      req(\"NON_AUTHOR_SEARCH\"))[0])\n571\t+\n572\t+    def test_decomposer_does_not_imply_method_disjoint(self):\n573\t+        self.assertFalse(A.admissible(prov(\"independent_decomposer\"),\n574\t+                                      req(\"METHOD_DISJOINT_VERIFICATION\"))[0])\n575\t+\n576\t+    def test_right_graph_wrong_role_fails(self):\n577\t+        # NC7: an isolated clean-room child (correct shape for isolation)\n578\t+        # is inadmissible for a search requirement — wrong epistemic role\n579\t+        ok, cl = A.admissible(prov(\"clean_room_author\", node=\"child-return\"),\n580\t+                              req(\"NON_AUTHOR_SEARCH\"))\n581\t+        self.assertFalse(ok)\n582\t+\n583\t+    def test_right_role_prohibited_source_fails(self):\n584\t+        p = A.EvidenceProvision(\n585\t+            node_id=\"n\", role=\"non_author_examiner\",\n586\t+            independence=A.IndependenceVector.of((0, 1, 0, 0)),\n587\t+            source=\"contaminated\")\n588\t+        r = A.EvidenceRequirement(\n589\t+            requirement_id=\"r\", distinction_id=\"Q1\",\n590\t+            kind=\"NON_AUTHOR_SEARCH\",\n591\t+            independence=A.IndependenceVector.of((0, 1, 0, 0)),\n592\t+            allowed_roles=(\"non_author_examiner\",),\n593\t+            prohibited_sources=(\"contaminated\",))\n594\t+        self.assertFalse(A.admissible(p, r)[0])\n595\t+\n596\t+    def test_method_disjointness_enforced(self):\n597\t+        r = req(\"METHOD_DISJOINT_VERIFICATION\", method=\"primary\")\n598\t+        self.assertFalse(A.admissible(\n599\t+            prov(\"method_disjoint_verifier\", method=\"primary\"), r)[0])\n600\t+        self.assertTrue(A.admissible(\n601\t+            prov(\"method_disjoint_verifier\", method=\"secondary\"), r)[0])\n602\t+\n603\t+    def test_vector_coverage_without_role_is_insufficient(self):\n604\t+        p = A.EvidenceProvision(\n605\t+            node_id=\"n\", role=\"clean_room_author\",\n606\t+            independence=A.IndependenceVector.of((1, 1, 1, 1)))\n607\t+        self.assertFalse(A.admissible(p, req(\"NON_AUTHOR_SEARCH\"))[0])\n608\t+\n609\t+\n610\t+def _distinction(qid, feature=None):\n611\t+    feats = {\"locally_resolvable\": feature is None,\n612\t+             \"requires_isolation\": False, \"contamination\": False,\n613\t+             \"capability_bearing_artifact\": False, \"spans_sessions\": False,\n614\t+             \"requires_clean_room_authorship\": False,\n615\t+             \"requires_nonauthor_search\": False,\n616\t+             \"requires_independent_decomposition\": False,\n617\t+             \"requires_method_disjoint_verification\": False}\n618\t+    if feature:\n619\t+        feats[feature] = True\n620\t+    return {\"id\": qid, \"features\": feats}\n621\t+\n622\t+\n623\t+class GrammarV2Test(unittest.TestCase):\n624\t+    def _gen(self, distinctions, values=None):\n625\t+        values = values or {d[\"id\"]: 0.8 for d in distinctions}\n626\t+        return TT.generate_candidates_v2(\n627\t+            {\"task_id\": \"tX\"}, distinctions, {\"applicable\": []},\n628\t+            CONTRACT, values)\n629\t+\n630\t+    def test_all_required_families_compile_and_validate(self):\n631\t+        seen = set()\n632\t+        for feature in (None, \"requires_nonauthor_search\",\n633\t+                        \"requires_clean_room_authorship\",\n634\t+                        \"requires_independent_decomposition\",\n635\t+                        \"requires_method_disjoint_verification\"):\n636\t+            cands = self._gen([_distinction(\"Q1\", feature)])\n637\t+            for c in cands:\n638\t+                fam = TT.family_of_v2(c.topology_id)\n639\t+                seen.add(fam)\n640\t+                res = TT.validate_topology(c, CONTRACT)\n641\t+                self.assertEqual(res.status, \"PASS\",\n642\t+                                 f\"{c.topology_id}: {res.counterexample}\")\n643\t+        self.assertEqual(seen, set(TT.FAMILIES_V2))\n644\t+\n645\t+    def test_admissibility_filter_rejects_local_for_typed_task(self):\n646\t+        cands = self._gen([_distinction(\"Q1\", \"requires_nonauthor_search\")])\n647\t+        by_fam = {TT.family_of_v2(c.topology_id): c for c in cands}\n648\t+        reqs = [A.requirement_for_distinction(\n649\t+            _distinction(\"Q1\", \"requires_nonauthor_search\"))]\n650\t+        local = by_fam[\"local\"]\n651\t+        adm = A.topology_admissible(\n652\t+            A.provisions_from_spec(local.harness_spec), reqs)\n653\t+        self.assertFalse(adm[\"admissible\"])\n654\t+        exam = by_fam[\"local-independent-examiner\"]\n655\t+        adm = A.topology_admissible(\n656\t+            A.provisions_from_spec(exam.harness_spec), reqs)\n657\t+        self.assertTrue(adm[\"admissible\"])\n658\t+\n659\t+    def test_examiner_beats_isolated_child_on_same_search_requirement(self):\n660\t+        # spec §20.5 key regression + NC8: equal admissibility, lower cost,\n661\t+        # zero marginal coverage => strictly higher utility\n662\t+        cands = self._gen([_distinction(\"Q1\", \"requires_nonauthor_search\")])\n663\t+        by_fam = {TT.family_of_v2(c.topology_id): c for c in cands}\n664\t+        exam, child = by_fam[\"local-independent-examiner\"], \\\n665\t+            by_fam[\"isolated-searcher\"]\n666\t+        cfg = TT.load_utility_config()\n667\t+        u_e = TT.predicted_utility(exam, cfg)\n668\t+        u_c = TT.predicted_utility(child, cfg)\n669\t+        self.assertEqual(exam.predicted_value[\"delta_e\"],\n670\t+                         child.predicted_value[\"delta_e\"])\n671\t+        self.assertLess(exam.predicted_value[\"cost\"],\n672\t+                        child.predicted_value[\"cost\"])\n673\t+        self.assertGreater(u_e, u_c)\n674\t+\n675\t+    def test_inadmissible_candidate_has_zero_epistemic_value(self):\n676\t+        cands = self._gen([_distinction(\"Q1\",\n677\t+                                        \"requires_clean_room_authorship\")])\n678\t+        by_fam = {TT.family_of_v2(c.topology_id): c for c in cands}\n679\t+        self.assertEqual(by_fam[\"local\"].predicted_value[\"delta_e\"], 0.0)\n680\t+\n681\t+    def test_examiner_only_case_needs_no_child_under_minimality(self):\n682\t+        cands = self._gen([_distinction(\"Q1\", \"requires_nonauthor_search\"),\n683\t+                           _distinction(\"Q2\")])\n684\t+        rank = TT.rank_candidates(\n685\t+            [c for c in cands\n686\t+             if c.harness_spec.get(\"admissibility_precheck\")])\n687\t+        self.assertEqual(TT.family_of_v2(rank[0][\"topology_id\"]),\n688\t+                         \"local-independent-examiner\")\n689\t+\n690\t+    def test_local_wins_for_pure_local_task(self):\n691\t+        cands = self._gen([_distinction(\"Q1\"), _distinction(\"Q2\")])\n692\t+        rank = TT.rank_candidates(cands)\n693\t+        self.assertEqual(TT.family_of_v2(rank[0][\"topology_id\"]), \"local\")\n694\t+\n695\t+    def test_redundant_examiner_penalized_on_local_task(self):\n696\t+        cands = self._gen([_distinction(\"Q1\")])\n697\t+        by_fam = {TT.family_of_v2(c.topology_id): c for c in cands}\n698\t+        self.assertGreater(\n699\t+            by_fam[\"local-independent-examiner\"]\n700\t+            .predicted_value[\"redundancy\"],\n701\t+            by_fam[\"local\"].predicted_value[\"redundancy\"])\n702\t+\n703\t+    def test_deterministic_tie_break(self):\n704\t+        cands = self._gen([_distinction(\"Q1\")])\n705\t+        r1 = TT.rank_candidates(cands)\n706\t+        r2 = TT.rank_candidates(list(reversed(cands)))\n707\t+        self.assertEqual([r[\"topology_id\"] for r in r1],\n708\t+                         [r[\"topology_id\"] for r in r2])\n709\t+\n710\t+    def test_v2_predictions_typed_attribution_and_role_falsifier(self):\n711\t+        d = [_distinction(\"Q1\", \"requires_nonauthor_search\")]\n712\t+        cands = self._gen(d)\n713\t+        by_fam = {TT.family_of_v2(c.topology_id): c for c in cands}\n714\t+        exam = by_fam[\"local-independent-examiner\"]\n715\t+        preds = TT.freeze_predictions_v2(exam, d)\n716\t+        resolves = [p for p in preds if p.kind == \"resolves\"]\n717\t+        self.assertEqual(resolves[0].principles, [\"P-NONAUTHOR-SEARCH\"])\n718\t+        role_preds = [p for p in preds\n719\t+                      if p.subject.get(\"checks\") == [\"ROLE_TYPE\"]]\n720\t+        self.assertEqual(len(role_preds), 1)\n721\t+        self.assertTrue(exam.predictions_hash)\n722\t+\n723\t+\n724\t+if __name__ == \"__main__\":\n725\t+    unittest.main()\n726\tdiff --git a/.creator-zero/tests/topology_theory/test_evidence_v2.py b/.creator-zero/tests/topology_theory/test_evidence_v2.py\n727\tnew file mode 100644\n728\tindex 0000000..d6dc07b\n729\t--- /dev/null\n730\t+++ b/.creator-zero/tests/topology_theory/test_evidence_v2.py\n731\t@@ -0,0 +1,127 @@\n732\t+\"\"\"Evidence schema v2 + import layer (spec §20.2, NC4-NC6).\"\"\"\n733\t+from __future__ import annotations\n734\t+import json\n735\t+import tempfile\n736\t+import unittest\n737\t+from pathlib import Path\n738\t+\n739\t+import _bootstrap\n740\t+from _bootstrap import CZROOT, TT\n741\t+\n742\t+E6_SOURCE = CZROOT / \"experiment-6\" / \"theory-evidence-events.jsonl\"\n743\t+PINS = json.loads((CZROOT / \"experiment-7\" / \"frozen-inputs\" /\n744\t+                   \"e6-input-pins.json\").read_text(encoding=\"utf-8\"))\n745\t+\n746\t+\n747\t+def _labels():\n748\t+    out = {}\n749\t+    for d in sorted((CZROOT / \"experiment-6\" / \"task-bank\").iterdir()):\n750\t+        lab = d / \"private\" / \"label.json\"\n751\t+        if lab.exists():\n752\t+            out[d.name] = json.loads(lab.read_text(encoding=\"utf-8\"))\n753\t+    return out\n754\t+\n755\t+\n756\t+class SchemaV2Test(unittest.TestCase):\n757\t+    def test_v1_event_parses(self):\n758\t+        e = TT.PrincipleEvidence.from_dict({\n759\t+            \"principle_id\": \"P-LOCALITY\", \"topology_id\": \"H-x-local\",\n760\t+            \"prediction_id\": \"H-x-local-pr01\", \"effect\": \"SUPPORT\"})\n761\t+        self.assertEqual(e.trial_id, \"\")\n762\t+        self.assertEqual(e.context, {})\n763\t+\n764\t+    def test_v2_context_round_trips_exactly(self):\n765\t+        d = {\"principle_id\": \"P-INDEPENDENCE\", \"topology_id\": \"H-t-iso\",\n766\t+             \"prediction_id\": \"H-t-iso-pr02\", \"effect\": \"FALSIFY\",\n767\t+             \"evidence_refs\": [{\"k\": 1}], \"event_id\": \"ev-1\",\n768\t+             \"source_experiment\": \"experiment-6\",\n769\t+             \"source_commit\": \"bd0cf91e455393d3d601070e5022c565d9ed9ed1\",\n770\t+             \"trial_id\": \"e6-t08\", \"run\": \"shadow\",\n771\t+             \"context\": {\"context_status\": \"OK\",\n772\t+                         \"admissibility_kind\": \"NON_AUTHOR_SEARCH\",\n773\t+                         \"latent_class\": \"COUNTEREXAMPLE\"},\n774\t+             \"source_artifact_id\": \"sha256:abc\"}\n775\t+        e = TT.PrincipleEvidence.from_dict(d)\n776\t+        self.assertEqual(e.to_dict(), d)\n777\t+\n778\t+    def test_unknown_top_level_field_is_typed_rejection(self):\n779\t+        # NC6: a context-stripping parser cannot pass — nothing is silently\n780\t+        # dropped\n781\t+        with self.assertRaises(TT.ModelValidationError):\n782\t+            TT.PrincipleEvidence.from_dict({\n783\t+                \"principle_id\": \"P-X\", \"topology_id\": \"t\",\n784\t+                \"prediction_id\": \"p\", \"effect\": \"SUPPORT\",\n785\t+                \"surprise_context_field\": {\"x\": 1}})\n786\t+\n787\t+    def test_e6_source_lines_parse_with_trial_and_run(self):\n788\t+        lines = [json.loads(l) for l in\n789\t+                 E6_SOURCE.read_text(encoding=\"utf-8\").splitlines()\n790\t+                 if l.strip()]\n791\t+        self.assertEqual(len(lines), 264)\n792\t+        for raw in lines[:5]:\n793\t+            e = TT.PrincipleEvidence.from_dict(raw)\n794\t+            self.assertTrue(e.trial_id.startswith(\"e6-t\"))\n795\t+            self.assertIn(e.run, (\"primary\", \"shadow\"))\n796\t+\n797\t+\n798\t+class ImportLayerTest(unittest.TestCase):\n799\t+    def setUp(self):\n800\t+        self.tmp = tempfile.mkdtemp()"}]},"parent_tool_use_id":null,"session_id":"371b7f47-bc11-46c7-971a-b334740ebdc3","uuid":"73c3657a-d4e9-44f3-9cf9-d1f93bb65306","timestamp":"2026-08-09T19:43:43.390Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-0/-home-user-creator-0/87cd2a2d-a4f9-585b-836f-2648df7a6284/scratchpad/e7/verifier-infra-ws/candidate-patch.diff","content":"diff --git a/.creator-zero/lineage/__init__.py b/.creator-zero/lineage/__init__.py\nnew file mode 100644\nindex 0000000..f18515a\n--- /dev/null\n+++ b/.creator-zero/lineage/__init__.py\n@@ -0,0 +1,24 @@\n+\"\"\"Creator-0 lineage subsystem: externally reconstructible checkpoints.\n+\n+A LineageCheckpoint is evidence about inherited state, not hidden-state\n+continuity: the successor session reconstructs governed state from pinned\n+artifacts (X_{n+1,0} ~=_Lambda_O X_{n,checkpoint}), never from process\n+memory (Z_{n+1} != Z_n is expected and irrelevant).\n+\n+    create_checkpoint(repo_root, ...)       -> LineageCheckpoint\n+    verify_checkpoint(repo_root, cp)        -> CheckpointResult (idempotent)\n+    resume_from_checkpoint(repo_root, cp, destination) -> resume record\n+\n+Verification is a deterministic conjunction with typed failure codes; any\n+critical mismatch maps to LINEAGE_RESUME_FAIL in the caller. No model input\n+reaches any check. The package directory is importable directly (no hyphen).\n+\"\"\"\n+from .model import (LineageCheckpoint, CheckpointResult, LineageError,\n+                    FAILURE_CODES)\n+from .checkpoint import create_checkpoint\n+from .verify import verify_checkpoint\n+from .resume import resume_from_checkpoint\n+\n+__all__ = [\"LineageCheckpoint\", \"CheckpointResult\", \"LineageError\",\n+           \"FAILURE_CODES\", \"create_checkpoint\", \"verify_checkpoint\",\n+           \"resume_from_checkpoint\"]\ndiff --git a/.creator-zero/lineage/_common.py b/.creator-zero/lineage/_common.py\nnew file mode 100644\nindex 0000000..b0dcc02\n--- /dev/null\n+++ b/.creator-zero/lineage/_common.py\n@@ -0,0 +1,44 @@\n+\"\"\"Shared deterministic helpers for the lineage subsystem.\"\"\"\n+from __future__ import annotations\n+import hashlib\n+import importlib\n+import importlib.util\n+import json\n+import subprocess\n+import sys\n+from pathlib import Path\n+from typing import Any\n+\n+CZROOT = Path(__file__).resolve().parents[1]\n+\n+\n+def sha256_file(p: Path | str) -> str:\n+    return hashlib.sha256(Path(p).read_bytes()).hexdigest()\n+\n+\n+def git(repo_root: Path | str, *args: str) -> str:\n+    return subprocess.run([\"git\", *args], cwd=repo_root, capture_output=True,\n+                          text=True, check=True).stdout.strip()\n+\n+\n+def git_ok(repo_root: Path | str, *args: str) -> bool:\n+    return subprocess.run([\"git\", *args], cwd=repo_root,\n+                          capture_output=True).returncode == 0\n+\n+\n+def tt_mod(name: str):\n+    \"\"\"Load a topology-theory submodule through the package machinery.\"\"\"\n+    pkg_dir = CZROOT / \"topology-theory\"\n+    if \"cz_topology_theory\" not in sys.modules:\n+        spec = importlib.util.spec_from_file_location(\n+            \"cz_topology_theory\", pkg_dir / \"__init__.py\",\n+            submodule_search_locations=[str(pkg_dir)])\n+        pkg = importlib.util.module_from_spec(spec)\n+        sys.modules[\"cz_topology_theory\"] = pkg\n+        spec.loader.exec_module(pkg)\n+    return importlib.import_module(f\"cz_topology_theory.{name}\")\n+\n+\n+def protected_manifest_sha256(manifest: dict[str, Any]) -> str:\n+    return hashlib.sha256(json.dumps(manifest, sort_keys=True,\n+                          separators=(\",\", \":\")).encode(\"utf-8\")).hexdigest()\ndiff --git a/.creator-zero/lineage/checkpoint.py b/.creator-zero/lineage/checkpoint.py\nnew file mode 100644\nindex 0000000..bea2620\n--- /dev/null\n+++ b/.creator-zero/lineage/checkpoint.py\n@@ -0,0 +1,92 @@\n+\"\"\"Checkpoint creation: pin every governed identity of the current state.\"\"\"\n+from __future__ import annotations\n+import json\n+from pathlib import Path\n+from typing import Any, Optional\n+\n+from ._common import (CZROOT, git, protected_manifest_sha256, sha256_file,\n+                      tt_mod)\n+from .model import (LineageCheckpoint, LineageError, SCHEMA_VERSION,\n+                    checkpoint_id_for)\n+\n+\n+def create_checkpoint(repo_root: str | Path, *,\n+                      commit_sha: str,\n+                      source_branch: str,\n+                      experiment_id: str,\n+                      experiment_state_path: str,\n+                      experiment_result: str,\n+                      protected_manifest: dict[str, Any],\n+                      theory_version: Optional[int] = None,\n+                      parent_checkpoint_id: Optional[str] = None,\n+                      provenance: Optional[dict[str, Any]] = None,\n+                      artifact_label: str = \"lineage checkpoint\",\n+                      ) -> LineageCheckpoint:\n+    \"\"\"Build an immutable checkpoint of the repo's governed state.\n+\n+    Every identity is computed from the repository, never accepted from a\n+    caller-supplied claim (the caller names WHAT to pin; the values are\n+    measured).\"\"\"\n+    root = Path(repo_root)\n+    czroot = root / \".creator-zero\"\n+    if not czroot.is_dir():\n+        raise LineageError(f\"{root} is not a Creator-0 repository root\")\n+\n+    tree_sha = git(root, \"rev-parse\", f\"{commit_sha}^{{tree}}\")\n+\n+    store_mod = tt_mod(\"theory_store\")\n+    store = store_mod.TheoryStore(czroot / \"state\" / \"topology-theory\")\n+    versions = store.versions()\n+    if not versions:\n+        raise LineageError(\"no theory versions to checkpoint\")\n+    tv = versions[-1] if theory_version is None else int(theory_version)\n+    theory = store.load(tv)\n+    length, head = store.evidence_head()\n+    chain = store.verify_append_only()\n+    if not chain[\"append_only_intact\"]:\n+        raise LineageError(\"refusing to checkpoint a store whose evidence \"\n+                           \"chain is not intact\")\n+\n+    body: dict[str, Any] = {\n+        \"artifact\": artifact_label,\n+        \"schema_version\": SCHEMA_VERSION,\n+        \"commit_sha\": commit_sha,\n+        \"tree_sha\": tree_sha,\n+        \"source_branch\": source_branch,\n+        \"theory_version\": theory.version,\n+        \"theory_artifact_id\": store.version_hash(theory.version),\n+        \"theory_status\": theory.status,\n+        \"evidence_length\": length,\n+        \"evidence_head_hash\": head,\n+        \"root_contract_sha256\": sha256_file(\n+            czroot / \"contracts\" / \"root_contract.json\"),\n+        \"formal_kernel_state_artifact_id\": sha256_file(\n+            czroot / \"state\" / \"formal-semantics-v0.1.json\"),\n+        \"protected_manifest_sha256\": protected_manifest_sha256(\n+            protected_manifest),\n+        \"protected_manifest\": dict(protected_manifest),\n+        \"experiment_id\": experiment_id,\n+        \"experiment_state_path\": experiment_state_path,\n+        \"experiment_state_sha256\": sha256_file(root / experiment_state_path),\n+        \"experiment_result\": experiment_result,\n+        \"parent_checkpoint_id\": parent_checkpoint_id,\n+        \"provenance\": dict(provenance or {}),\n+    }\n+    body[\"checkpoint_id\"] = checkpoint_id_for(body)\n+    return LineageCheckpoint.from_dict(body)\n+\n+\n+def write_checkpoint(cp: LineageCheckpoint, path: str | Path) -> Path:\n+    \"\"\"Write-once persistence: an existing checkpoint file is never\n+    overwritten (checkpoints are immutable).\"\"\"\n+    p = Path(path)\n+    if p.exists():\n+        raise LineageError(f\"refusing to overwrite existing checkpoint {p}\")\n+    p.parent.mkdir(parents=True, exist_ok=True)\n+    p.write_text(cp.serialize(), encoding=\"utf-8\")\n+    return p\n+\n+\n+def load_checkpoint(path: str | Path) -> LineageCheckpoint:\n+    return LineageCheckpoint.from_dict(\n+        json.loads(Path(path).read_text(encoding=\"utf-8\")))\ndiff --git a/.creator-zero/lineage/model.py b/.creator-zero/lineage/model.py\nnew file mode 100644\nindex 0000000..1a97393\n--- /dev/null\n+++ b/.creator-zero/lineage/model.py\n@@ -0,0 +1,106 @@\n+\"\"\"Typed lineage objects: immutable checkpoint + verification result.\"\"\"\n+from __future__ import annotations\n+import hashlib\n+import json\n+from dataclasses import dataclass, field, asdict\n+from typing import Any, Optional\n+\n+SCHEMA_VERSION = \"lineage-checkpoint-v1\"\n+\n+FAILURE_CODES = (\n+    \"COMMIT_MISMATCH\", \"TREE_MISMATCH\", \"THEORY_MISMATCH\",\n+    \"EVIDENCE_HEAD_MISMATCH\", \"ROOT_CONTRACT_MISMATCH\",\n+    \"FORMAL_KERNEL_MISMATCH\", \"EXPERIMENT_STATE_MISMATCH\",\n+    \"PROTECTED_MANIFEST_MISMATCH\", \"EVIDENCE_SOURCE_MISMATCH\",\n+)\n+\n+\n+class LineageError(RuntimeError):\n+    \"\"\"Lineage invariant violation (malformed checkpoint, refused resume).\"\"\"\n+\n+\n+def canonical_dumps(obj: Any) -> str:\n+    return json.dumps(obj, indent=2, sort_keys=True, ensure_ascii=False) + \"\\n\"\n+\n+\n+def checkpoint_id_for(body: dict[str, Any]) -> str:\n+    \"\"\"Deterministic checkpoint identity over the body without its own id.\"\"\"\n+    d = {k: v for k, v in body.items() if k != \"checkpoint_id\"}\n+    return \"sha256:\" + hashlib.sha256(\n+        (json.dumps(d, sort_keys=True, separators=(\",\", \":\"))\n+         + \"\\x00creator-0/lineage/checkpoint\").encode(\"utf-8\")).hexdigest()\n+\n+\n+@dataclass(frozen=True)\n+class LineageCheckpoint:\n+    schema_version: str\n+    checkpoint_id: str\n+\n+    commit_sha: str\n+    tree_sha: str\n+    source_branch: str\n+\n+    theory_version: int\n+    theory_artifact_id: str\n+    theory_status: str\n+\n+    evidence_length: int\n+    evidence_head_hash: str\n+\n+    root_contract_sha256: str\n+    formal_kernel_state_artifact_id: str\n+    protected_manifest_sha256: str\n+    protected_manifest: dict[str, Any] = field(default_factory=dict)\n+\n+    experiment_id: str = \"\"\n+    experiment_state_path: str = \"\"\n+    experiment_state_sha256: str = \"\"\n+    experiment_result: str = \"\"\n+\n+    parent_checkpoint_id: Optional[str] = None\n+    provenance: dict[str, Any] = field(default_factory=dict)\n+    artifact: str = \"\"\n+\n+    def __post_init__(self):\n+        if self.schema_version != SCHEMA_VERSION:\n+            raise LineageError(\n+                f\"unsupported checkpoint schema {self.schema_version!r}\")\n+        for name in (\"commit_sha\", \"tree_sha\", \"source_branch\",\n+                     \"theory_artifact_id\"):\n+            if not getattr(self, name):\n+                raise LineageError(f\"checkpoint missing {name}\")\n+        expected = checkpoint_id_for(self.to_dict())\n+        if self.checkpoint_id != expected:\n+            raise LineageError(\n+                f\"checkpoint_id does not match content: {self.checkpoint_id} \"\n+                f\"!= {expected} (checkpoints are immutable; a drifted id \"\n+                \"means the body was edited after creation)\")\n+\n+    def to_dict(self) -> dict[str, Any]:\n+        return asdict(self)\n+\n+    @classmethod\n+    def from_dict(cls, d: dict[str, Any]) -> \"LineageCheckpoint\":\n+        known = {k: d[k] for k in cls.__dataclass_fields__ if k in d}\n+        unknown = set(d) - set(cls.__dataclass_fields__)\n+        if unknown:\n+            raise LineageError(\n+                f\"checkpoint document carries unknown fields {sorted(unknown)}\"\n+                \" (closed schema; nothing is silently dropped)\")\n+        return cls(**known)\n+\n+    def serialize(self) -> str:\n+        return canonical_dumps(self.to_dict())\n+\n+\n+@dataclass\n+class CheckpointResult:\n+    checkpoint_id: str\n+    status: str                      # PASS | FAIL\n+    checks: dict[str, dict[str, Any]] = field(default_factory=dict)\n+    failed: list[str] = field(default_factory=list)\n+    failure_codes: list[str] = field(default_factory=list)\n+    result: Optional[str] = None     # LINEAGE_RESUME_FAIL on failure\n+\n+    def to_dict(self) -> dict[str, Any]:\n+        return asdict(self)\ndiff --git a/.creator-zero/lineage/resume.py b/.creator-zero/lineage/resume.py\nnew file mode 100644\nindex 0000000..25e0932\n--- /dev/null\n+++ b/.creator-zero/lineage/resume.py\n@@ -0,0 +1,64 @@\n+\"\"\"Resume: realize a new causal trajectory from a verified checkpoint.\n+\n+    resume_from_checkpoint(repo_root, cp, destination, branch_name=None)\n+\n+Creates a git worktree rooted at exactly the checkpoint commit. The source\n+branch is never moved, and resume refuses to run at all unless\n+verify_checkpoint passes first (Resume(L,X)=⊥ on any mismatch). A resumed\n+worktree is Branch(X_n, Δ_{n+1}): a descendant trajectory, not a restart\n+and not hidden-state continuity.\n+\"\"\"\n+from __future__ import annotations\n+from pathlib import Path\n+from typing import Any, Optional\n+\n+from ._common import git\n+from .model import LineageCheckpoint, LineageError\n+from .verify import verify_checkpoint\n+\n+\n+def resume_from_checkpoint(repo_root: str | Path,\n+                           cp: LineageCheckpoint | dict[str, Any],\n+                           destination: str | Path,\n+                           branch_name: Optional[str] = None,\n+                           ) -> dict[str, Any]:\n+    if isinstance(cp, dict):\n+        cp = LineageCheckpoint.from_dict(cp)\n+    root = Path(repo_root)\n+    dest = Path(destination)\n+    if dest.exists():\n+        raise LineageError(f\"resume destination already exists: {dest}\")\n+\n+    verification = verify_checkpoint(root, cp)\n+    if verification.status != \"PASS\":\n+        raise LineageError(\n+            \"LINEAGE_RESUME_FAIL: checkpoint verification failed \"\n+            f\"({verification.failure_codes}); resume refused\")\n+\n+    source_tip_before = git(root, \"rev-parse\", cp.commit_sha)\n+    args = [\"worktree\", \"add\"]\n+    if branch_name:\n+        args += [\"-b\", branch_name]\n+    args += [str(dest), cp.commit_sha]\n+    git(root, *args)\n+\n+    head = git(dest, \"rev-parse\", \"HEAD\")\n+    tree = git(dest, \"rev-parse\", \"HEAD^{tree}\")\n+    if head != cp.commit_sha or tree != cp.tree_sha:\n+        raise LineageError(\n+            f\"resumed worktree does not sit at the checkpoint: head={head} \"\n+            f\"tree={tree}\")\n+    source_tip_after = git(root, \"rev-parse\", cp.commit_sha)\n+    if source_tip_before != source_tip_after:\n+        raise LineageError(\"source commit moved during resume\")\n+\n+    return {\n+        \"artifact\": \"lineage resume record\",\n+        \"checkpoint_id\": cp.checkpoint_id,\n+        \"destination\": str(dest),\n+        \"branch\": branch_name or \"(detached)\",\n+        \"head\": head,\n+        \"tree\": tree,\n+        \"verification\": verification.to_dict(),\n+        \"source_branch_unmodified\": True,\n+    }\ndiff --git a/.creator-zero/lineage/verify.py b/.creator-zero/lineage/verify.py\nnew file mode 100644\nindex 0000000..ac49913\n--- /dev/null\n+++ b/.creator-zero/lineage/verify.py\n@@ -0,0 +1,144 @@\n+\"\"\"Deterministic checkpoint verification.\n+\n+    Verify(L,X) = v_C ∧ v_T ∧ v_Θ ∧ v_E ∧ v_K ∧ v_G ∧ v_S\n+\n+Idempotent: verification reads state and writes nothing. Every clause\n+reports a typed failure code from FAILURE_CODES; any failure maps the whole\n+result to LINEAGE_RESUME_FAIL. Model output cannot override any clause.\n+\"\"\"\n+from __future__ import annotations\n+import json\n+import subprocess\n+from pathlib import Path\n+from typing import Any\n+\n+from ._common import git, git_ok, protected_manifest_sha256, sha256_file, \\\n+    tt_mod\n+from .model import CheckpointResult, LineageCheckpoint\n+\n+\n+def verify_checkpoint(repo_root: str | Path,\n+                      cp: LineageCheckpoint | dict[str, Any],\n+                      ) -> CheckpointResult:\n+    if isinstance(cp, dict):\n+        cp = LineageCheckpoint.from_dict(cp)\n+    root = Path(repo_root)\n+    czroot = root / \".creator-zero\"\n+    checks: dict[str, dict[str, Any]] = {}\n+\n+    def rec(name: str, code: str, ok: bool, why: str) -> None:\n+        checks[name] = {\"status\": \"PASS\" if ok else \"FAIL\",\n+                        \"failure_code\": None if ok else code, \"detail\": why}\n+\n+    # v_C — the pinned commit exists and is an ancestor of the current HEAD\n+    commit_ok = False\n+    try:\n+        commit_ok = git(root, \"cat-file\", \"-t\", cp.commit_sha) == \"commit\"\n+    except subprocess.CalledProcessError:\n+        pass\n+    ancestry = git_ok(root, \"merge-base\", \"--is-ancestor\", cp.commit_sha,\n+                      \"HEAD\")\n+    rec(\"commit\", \"COMMIT_MISMATCH\", commit_ok and ancestry,\n+        f\"commit present={commit_ok}; ancestor_of_HEAD={ancestry}\")\n+\n+    # v_T — the pinned commit's tree matches the pinned tree\n+    tree = \"\"\n+    if commit_ok:\n+        tree = git(root, \"rev-parse\", f\"{cp.commit_sha}^{{tree}}\")\n+    rec(\"tree\", \"TREE_MISMATCH\", tree == cp.tree_sha,\n+        f\"tree={tree[:12]} vs pinned {cp.tree_sha[:12]}\")\n+\n+    # v_Θ — theory version identity and status\n+    store_mod = tt_mod(\"theory_store\")\n+    store = store_mod.TheoryStore(czroot / \"state\" / \"topology-theory\")\n+    try:\n+        theory = store.load(cp.theory_version)\n+        th_hash = store.version_hash(cp.theory_version)\n+        rec(\"theory\", \"THEORY_MISMATCH\",\n+            theory.status == cp.theory_status\n+            and th_hash == cp.theory_artifact_id,\n+            f\"theta-v{cp.theory_version} status={theory.status} \"\n+            f\"hash={th_hash[:24]}…\")\n+    except Exception as e:                       # store/schema failures\n+        rec(\"theory\", \"THEORY_MISMATCH\", False, str(e))\n+\n+    # v_E — the pinned evidence head must be a valid prefix of the current\n+    # append-only chain (the store legitimately grows after resume; what can\n+    # never happen is a rewrite of the pinned prefix), and the chain intact.\n+    length, head = store.evidence_head()\n+    chain = store.verify_append_only()\n+    if cp.evidence_length == 0 and not cp.evidence_head_hash:\n+        prefix_ok = True\n+        prefix_why = \"pinned empty head; any intact chain extends it\"\n+    else:\n+        prefix_ok = False\n+        if store.heads_path.exists():\n+            for line in store.heads_path.read_text(\n+                    encoding=\"utf-8\").splitlines():\n+                if not line.strip():\n+                    continue\n+                h = json.loads(line)\n+                if int(h[\"length\"]) == cp.evidence_length and \\\n+                        str(h[\"hash\"]) == cp.evidence_head_hash:\n+                    prefix_ok = True\n+                    break\n+        prefix_why = (f\"pinned head ({cp.evidence_length},\"\n+                      f\"{cp.evidence_head_hash[:16]}…) \"\n+                      + (\"found in\" if prefix_ok else \"absent from\")\n+                      + \" the head chain\")\n+    rec(\"evidence_head\", \"EVIDENCE_HEAD_MISMATCH\",\n+        prefix_ok and chain[\"append_only_intact\"],\n+        f\"current head=({length},{head[:16]!r}); {prefix_why}; \"\n+        f\"chain_intact={chain['append_only_intact']}\")\n+\n+    # v_G — root contract identity\n+    rc = sha256_file(czroot / \"contracts\" / \"root_contract.json\")\n+    rec(\"root_contract\", \"ROOT_CONTRACT_MISMATCH\",\n+        rc == cp.root_contract_sha256, f\"sha256={rc[:16]}…\")\n+\n+    # v_K — formal kernel state identity\n+    fk = sha256_file(czroot / \"state\" / \"formal-semantics-v0.1.json\")\n+    rec(\"formal_kernel\", \"FORMAL_KERNEL_MISMATCH\",\n+        fk == cp.formal_kernel_state_artifact_id, f\"sha256={fk[:16]}…\")\n+\n+    # v_S — experiment state identity and result\n+    ok_s, why_s = False, \"experiment state not pinned\"\n+    if cp.experiment_state_path:\n+        p = root / cp.experiment_state_path\n+        if p.exists():\n+            es = sha256_file(p)\n+            res = json.loads(p.read_text(encoding=\"utf-8\")).get(\"result\")\n+            ok_s = (es == cp.experiment_state_sha256\n+                    and res == cp.experiment_result)\n+            why_s = f\"sha256={es[:16]}…; result={res!r}\"\n+        else:\n+            why_s = f\"missing {cp.experiment_state_path}\"\n+    rec(\"experiment_state\", \"EXPERIMENT_STATE_MISMATCH\", ok_s, why_s)\n+\n+    # protected manifest + protected-history immutability vs pinned commit\n+    pm_ok = protected_manifest_sha256(cp.protected_manifest) == \\\n+        cp.protected_manifest_sha256\n+    mutations: list[str] = []\n+    if commit_ok:\n+        targets = [p.rstrip(\"/\") for p in\n+                   cp.protected_manifest.get(\"protected_prefixes\", [])]\n+        targets += cp.protected_manifest.get(\"protected_files\", [])\n+        for t in targets:\n+            out = git(root, \"diff\", \"--diff-filter=MD\", \"--name-only\",\n+                      cp.commit_sha, \"HEAD\", \"--\", t)\n+            mutations.extend(out.splitlines())\n+    rec(\"protected_manifest\", \"PROTECTED_MANIFEST_MISMATCH\",\n+        pm_ok and not mutations,\n+        f\"manifest_hash_ok={pm_ok}; historical_mutations={mutations}\")\n+\n+    failed = sorted(k for k, v in checks.items() if v[\"status\"] != \"PASS\")\n+    codes = sorted({checks[k][\"failure_code\"] for k in failed\n+                    if checks[k][\"failure_code\"]})\n+    return CheckpointResult(\n+        checkpoint_id=cp.checkpoint_id,\n+        status=\"PASS\" if not failed else \"FAIL\",\n+        checks=checks,\n+        failed=failed,\n+        failure_codes=codes,\n+        result=None if not failed else \"LINEAGE_RESUME_FAIL\",\n+    )\ndiff --git a/.creator-zero/tests/topology_theory/test_admissibility_grammar_v2.py b/.creator-zero/tests/topology_theory/test_admissibility_grammar_v2.py\nnew file mode 100644\nindex 0000000..90505c1\n--- /dev/null\n+++ b/.creator-zero/tests/topology_theory/test_admissibility_grammar_v2.py\n@@ -0,0 +1,209 @@\n+\"\"\"Typed admissibility + grammar v2 + utility v2 (spec §20.3-20.5).\"\"\"\n+from __future__ import annotations\n+import json\n+import unittest\n+\n+import _bootstrap\n+from _bootstrap import CZROOT, TT\n+\n+A = TT.admissibility\n+\n+CONTRACT = json.loads((CZROOT / \"experiment-6\" / \"contracts\" /\n+                       \"trial-contract.json\").read_text(encoding=\"utf-8\"))\n+\n+\n+def req(kind, qid=\"Q1\", method=\"\"):\n+    vec, roles = A.KIND_REQUIREMENT[kind]\n+    return A.EvidenceRequirement(\n+        requirement_id=f\"req-{qid}\", distinction_id=qid, kind=kind,\n+        independence=A.IndependenceVector.of(vec), allowed_roles=roles,\n+        primary_method_family=method)\n+\n+\n+def prov(role, node=\"n1\", method=\"\"):\n+    return A.provision_for_role(node, role, method_family=method)\n+\n+\n+class AdmissibilityMatrixTest(unittest.TestCase):\n+    def test_local_satisfies_local_requirement(self):\n+        ok, _ = A.admissible(prov(\"local_author\"), req(\"LOCAL\"))\n+        self.assertTrue(ok)\n+\n+    def test_clean_room_author_satisfies_authorship(self):\n+        ok, _ = A.admissible(prov(\"clean_room_author\"),\n+                             req(\"CLEAN_ROOM_AUTHORSHIP\"))\n+        self.assertTrue(ok)\n+\n+    def test_clean_room_author_does_not_imply_decomposition(self):\n+        ok, cl = A.admissible(prov(\"clean_room_author\"),\n+                              req(\"INDEPENDENT_DECOMPOSITION\"))\n+        self.assertFalse(ok)\n+        self.assertFalse(cl[\"vector_satisfies\"])\n+\n+    def test_examiner_satisfies_search(self):\n+        ok, _ = A.admissible(prov(\"non_author_examiner\"),\n+                             req(\"NON_AUTHOR_SEARCH\"))\n+        self.assertTrue(ok)\n+\n+    def test_verifier_does_not_imply_decomposition_or_search(self):\n+        self.assertFalse(A.admissible(prov(\"method_disjoint_verifier\",\n+                                           method=\"alt\"),\n+                                      req(\"INDEPENDENT_DECOMPOSITION\"))[0])\n+        self.assertFalse(A.admissible(prov(\"method_disjoint_verifier\",\n+                                           method=\"alt\"),\n+                                      req(\"NON_AUTHOR_SEARCH\"))[0])\n+\n+    def test_decomposer_does_not_imply_method_disjoint(self):\n+        self.assertFalse(A.admissible(prov(\"independent_decomposer\"),\n+                                      req(\"METHOD_DISJOINT_VERIFICATION\"))[0])\n+\n+    def test_right_graph_wrong_role_fails(self):\n+        # NC7: an isolated clean-room child (correct shape for isolation)\n+        # is inadmissible for a search requirement — wrong epistemic role\n+        ok, cl = A.admissible(prov(\"clean_room_author\", node=\"child-return\"),\n+                              req(\"NON_AUTHOR_SEARCH\"))\n+        self.assertFalse(ok)\n+\n+    def test_right_role_prohibited_source_fails(self):\n+        p = A.EvidenceProvision(\n+            node_id=\"n\", role=\"non_author_examiner\",\n+            independence=A.IndependenceVector.of((0, 1, 0, 0)),\n+            source=\"contaminated\")\n+        r = A.EvidenceRequirement(\n+            requirement_id=\"r\", distinction_id=\"Q1\",\n+            kind=\"NON_AUTHOR_SEARCH\",\n+            independence=A.IndependenceVector.of((0, 1, 0, 0)),\n+            allowed_roles=(\"non_author_examiner\",),\n+            prohibited_sources=(\"contaminated\",))\n+        self.assertFalse(A.admissible(p, r)[0])\n+\n+    def test_method_disjointness_enforced(self):\n+        r = req(\"METHOD_DISJOINT_VERIFICATION\", method=\"primary\")\n+        self.assertFalse(A.admissible(\n+            prov(\"method_disjoint_verifier\", method=\"primary\"), r)[0])\n+        self.assertTrue(A.admissible(\n+            prov(\"method_disjoint_verifier\", method=\"secondary\"), r)[0])\n+\n+    def test_vector_coverage_without_role_is_insufficient(self):\n+        p = A.EvidenceProvision(\n+            node_id=\"n\", role=\"clean_room_author\",\n+            independence=A.IndependenceVector.of((1, 1, 1, 1)))\n+        self.assertFalse(A.admissible(p, req(\"NON_AUTHOR_SEARCH\"))[0])\n+\n+\n+def _distinction(qid, feature=None):\n+    feats = {\"locally_resolvable\": feature is None,\n+             \"requires_isolation\": False, \"contamination\": False,\n+             \"capability_bearing_artifact\": False, \"spans_sessions\": False,\n+             \"requires_clean_room_authorship\": False,\n+             \"requires_nonauthor_search\": False,\n+             \"requires_independent_decomposition\": False,\n+             \"requires_method_disjoint_verification\": False}\n+    if feature:\n+        feats[feature] = True\n+    return {\"id\": qid, \"features\": feats}\n+\n+\n+class GrammarV2Test(unittest.TestCase):\n+    def _gen(self, distinctions, values=None):\n+        values = values or {d[\"id\"]: 0.8 for d in distinctions}\n+        return TT.generate_candidates_v2(\n+            {\"task_id\": \"tX\"}, distinctions, {\"applicable\": []},\n+            CONTRACT, values)\n+\n+    def test_all_required_families_compile_and_validate(self):\n+        seen = set()\n+        for feature in (None, \"requires_nonauthor_search\",\n+                        \"requires_clean_room_authorship\",\n+                        \"requires_independent_decomposition\",\n+                        \"requires_method_disjoint_verification\"):\n+            cands = self._gen([_distinction(\"Q1\", feature)])\n+            for c in cands:\n+                fam = TT.family_of_v2(c.topology_id)\n+                seen.add(fam)\n+                res = TT.validate_topology(c, CONTRACT)\n+                self.assertEqual(res.status, \"PASS\",\n+                                 f\"{c.topology_id}: {res.counterexample}\")\n+        self.assertEqual(seen, set(TT.FAMILIES_V2))\n+\n+    def test_admissibility_filter_rejects_local_for_typed_task(self):\n+        cands = self._gen([_distinction(\"Q1\", \"requires_nonauthor_search\")])\n+        by_fam = {TT.family_of_v2(c.topology_id): c for c in cands}\n+        reqs = [A.requirement_for_distinction(\n+            _distinction(\"Q1\", \"requires_nonauthor_search\"))]\n+        local = by_fam[\"local\"]\n+        adm = A.topology_admissible(\n+            A.provisions_from_spec(local.harness_spec), reqs)\n+        self.assertFalse(adm[\"admissible\"])\n+        exam = by_fam[\"local-independent-examiner\"]\n+        adm = A.topology_admissible(\n+            A.provisions_from_spec(exam.harness_spec), reqs)\n+        self.assertTrue(adm[\"admissible\"])\n+\n+    def test_examiner_beats_isolated_child_on_same_search_requirement(self):\n+        # spec §20.5 key regression + NC8: equal admissibility, lower cost,\n+        # zero marginal coverage => strictly higher utility\n+        cands = self._gen([_distinction(\"Q1\", \"requires_nonauthor_search\")])\n+        by_fam = {TT.family_of_v2(c.topology_id): c for c in cands}\n+        exam, child = by_fam[\"local-independent-examiner\"], \\\n+            by_fam[\"isolated-searcher\"]\n+        cfg = TT.load_utility_config()\n+        u_e = TT.predicted_utility(exam, cfg)\n+        u_c = TT.predicted_utility(child, cfg)\n+        self.assertEqual(exam.predicted_value[\"delta_e\"],\n+                         child.predicted_value[\"delta_e\"])\n+        self.assertLess(exam.predicted_value[\"cost\"],\n+                        child.predicted_value[\"cost\"])\n+        self.assertGreater(u_e, u_c)\n+\n+    def test_inadmissible_candidate_has_zero_epistemic_value(self):\n+        cands = self._gen([_distinction(\"Q1\",\n+                                        \"requires_clean_room_authorship\")])\n+        by_fam = {TT.family_of_v2(c.topology_id): c for c in cands}\n+        self.assertEqual(by_fam[\"local\"].predicted_value[\"delta_e\"], 0.0)\n+\n+    def test_examiner_only_case_needs_no_child_under_minimality(self):\n+        cands = self._gen([_distinction(\"Q1\", \"requires_nonauthor_search\"),\n+                           _distinction(\"Q2\")])\n+        rank = TT.rank_candidates(\n+            [c for c in cands\n+             if c.harness_spec.get(\"admissibility_precheck\")])\n+        self.assertEqual(TT.family_of_v2(rank[0][\"topology_id\"]),\n+                         \"local-independent-examiner\")\n+\n+    def test_local_wins_for_pure_local_task(self):\n+        cands = self._gen([_distinction(\"Q1\"), _distinction(\"Q2\")])\n+        rank = TT.rank_candidates(cands)\n+        self.assertEqual(TT.family_of_v2(rank[0][\"topology_id\"]), \"local\")\n+\n+    def test_redundant_examiner_penalized_on_local_task(self):\n+        cands = self._gen([_distinction(\"Q1\")])\n+        by_fam = {TT.family_of_v2(c.topology_id): c for c in cands}\n+        self.assertGreater(\n+            by_fam[\"local-independent-examiner\"]\n+            .predicted_value[\"redundancy\"],\n+            by_fam[\"local\"].predicted_value[\"redundancy\"])\n+\n+    def test_deterministic_tie_break(self):\n+        cands = self._gen([_distinction(\"Q1\")])\n+        r1 = TT.rank_candidates(cands)\n+        r2 = TT.rank_candidates(list(reversed(cands)))\n+        self.assertEqual([r[\"topology_id\"] for r in r1],\n+                         [r[\"topology_id\"] for r in r2])\n+\n+    def test_v2_predictions_typed_attribution_and_role_falsifier(self):\n+        d = [_distinction(\"Q1\", \"requires_nonauthor_search\")]\n+        cands = self._gen(d)\n+        by_fam = {TT.family_of_v2(c.topology_id): c for c in cands}\n+        exam = by_fam[\"local-independent-examiner\"]\n+        preds = TT.freeze_predictions_v2(exam, d)\n+        resolves = [p for p in preds if p.kind == \"resolves\"]\n+        self.assertEqual(resolves[0].principles, [\"P-NONAUTHOR-SEARCH\"])\n+        role_preds = [p for p in preds\n+                      if p.subject.get(\"checks\") == [\"ROLE_TYPE\"]]\n+        self.assertEqual(len(role_preds), 1)\n+        self.assertTrue(exam.predictions_hash)\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()\ndiff --git a/.creator-zero/tests/topology_theory/test_evidence_v2.py b/.creator-zero/tests/topology_theory/test_evidence_v2.py\nnew file mode 100644\nindex 0000000..d6dc07b\n--- /dev/null\n+++ b/.creator-zero/tests/topology_theory/test_evidence_v2.py\n@@ -0,0 +1,127 @@\n+\"\"\"Evidence schema v2 + import layer (spec §20.2, NC4-NC6).\"\"\"\n+from __future__ import annotations\n+import json\n+import tempfile\n+import unittest\n+from pathlib import Path\n+\n+import _bootstrap\n+from _bootstrap import CZROOT, TT\n+\n+E6_SOURCE = CZROOT / \"experiment-6\" / \"theory-evidence-events.jsonl\"\n+PINS = json.loads((CZROOT / \"experiment-7\" / \"frozen-inputs\" /\n+                   \"e6-input-pins.json\").read_text(encoding=\"utf-8\"))\n+\n+\n+def _labels():\n+    out = {}\n+    for d in sorted((CZROOT / \"experiment-6\" / \"task-bank\").iterdir()):\n+        lab = d / \"private\" / \"label.json\"\n+        if lab.exists():\n+            out[d.name] = json.loads(lab.read_text(encoding=\"utf-8\"))\n+    return out\n+\n+\n+class SchemaV2Test(unittest.TestCase):\n+    def test_v1_event_parses(self):\n+        e = TT.PrincipleEvidence.from_dict({\n+            \"principle_id\": \"P-LOCALITY\", \"topology_id\": \"H-x-local\",\n+            \"prediction_id\": \"H-x-local-pr01\", \"effect\": \"SUPPORT\"})\n+        self.assertEqual(e.trial_id, \"\")\n+        self.assertEqual(e.context, {})\n+\n+    def test_v2_context_round_trips_exactly(self):\n+        d = {\"principle_id\": \"P-INDEPENDENCE\", \"topology_id\": \"H-t-iso\",\n+             \"prediction_id\": \"H-t-iso-pr02\", \"effect\": \"FALSIFY\",\n+             \"evidence_refs\": [{\"k\": 1}], \"event_id\": \"ev-1\",\n+             \"source_experiment\": \"experiment-6\",\n+             \"source_commit\": \"bd0cf91e455393d3d601070e5022c565d9ed9ed1\",\n+             \"trial_id\": \"e6-t08\", \"run\": \"shadow\",\n+             \"context\": {\"context_status\": \"OK\",\n+                         \"admissibility_kind\": \"NON_AUTHOR_SEARCH\",\n+                         \"latent_class\": \"COUNTEREXAMPLE\"},\n+             \"source_artifact_id\": \"sha256:abc\"}\n+        e = TT.PrincipleEvidence.from_dict(d)\n+        self.assertEqual(e.to_dict(), d)\n+\n+    def test_unknown_top_level_field_is_typed_rejection(self):\n+        # NC6: a context-stripping parser cannot pass — nothing is silently\n+        # dropped\n+        with self.assertRaises(TT.ModelValidationError):\n+            TT.PrincipleEvidence.from_dict({\n+                \"principle_id\": \"P-X\", \"topology_id\": \"t\",\n+                \"prediction_id\": \"p\", \"effect\": \"SUPPORT\",\n+                \"surprise_context_field\": {\"x\": 1}})\n+\n+    def test_e6_source_lines_parse_with_trial_and_run(self):\n+        lines = [json.loads(l) for l in\n+                 E6_SOURCE.read_text(encoding=\"utf-8\").splitlines()\n+                 if l.strip()]\n+        self.assertEqual(len(lines), 264)\n+        for raw in lines[:5]:\n+            e = TT.PrincipleEvidence.from_dict(raw)\n+            self.assertTrue(e.trial_id.startswith(\"e6-t\"))\n+            self.assertIn(e.run, (\"primary\", \"shadow\"))\n+\n+\n+class ImportLayerTest(unittest.TestCase):\n+    def setUp(self):\n+        self.tmp = tempfile.mkdtemp()","numLines":800,"startLine":1,"totalLines":2852}}}
