be expressible in the cart shape {quantity: int, loyalty_member: bool, category: str, coupon_code_applied: bool}.\",\n        \"Deliverable must match the specified result.json shape.\"\n      ],\n      \"evidence_requirement_refs\": [\n        \"E-C\"\n      ],\n      \"dependencies\": [\n        \"Q1\",\n        \"Q2\"\n      ],\n      \"features\": {\n        \"locally_resolvable\": true,\n        \"requires_isolation\": false,\n        \"contamination\": false,\n        \"capability_bearing_artifact\": false,\n        \"spans_sessions\": false\n      }\n    }\n  ]\n}\n","numLines":76,"startLine":0,"totalLines":76}}}
