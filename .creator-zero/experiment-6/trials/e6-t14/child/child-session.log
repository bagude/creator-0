sponse_changes_parent_state\": false, \"transfers_authority\": false}\n  ],\n  \"ledger_contract\": {\n    \"path\": \"execution-ledger.jsonl (child workspace root)\",\n    \"schema\": \"normalized formal event schema: one JSON object per line with event_id, label, actor, timestamp, artifact_refs, metadata; node executions carry metadata.completes_node\",\n    \"required_node_execution_events\": [\n      {\"label\": \"observe\", \"actor\": \"node:observe-inputs\", \"metadata\": {\"completes_node\": \"observe-inputs\"}},\n      {\"label\": \"propose\", \"actor\": \"node:produce-evidence\", \"metadata\": {\"completes_node\": \"produce-evidence\"}},\n      {\"label\": \"verify\", \"actor\": \"node:self-check\", \"metadata\": {\"completes_node\": \"self-check\"}},\n      {\"label\": \"return\", \"actor\": \"node:return-result\", \"metadata\": {\"completes_node\": \"return-result\"}}\n    ],\n    \"terminal_event\": {\"label\": \"complete\", \"actor\": \"child\"},\n    \"optional_events\": \"non-authority events (observe, propose, validate, consult, reject, persist, reconstruct, return) with actor 'child' are permitted as governance self-loops; tau lines permitted with metadata.reason\"\n  }\n}\n","numLines":62,"startLine":1,"totalLines":62}}}
