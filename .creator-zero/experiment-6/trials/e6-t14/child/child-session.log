s":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2291,"cache_read_input_tokens":27732,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2291},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"b5ddeda4-6290-4008-b7fc-4879dc2a6c4a","uuid":"41c648c6-290a-4e41-ad4e-bdf08aadb560","timestamp":"2026-08-09T17:26:45.835Z","request_id":"req_011CdsZohr2iwA34ihMUA5rq"}
