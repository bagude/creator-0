{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "creator-zero/formal/formal-result.schema.json",
  "title": "Creator-0 formal check result",
  "type": "object",
  "required": ["check", "status", "formal_relation", "counterexample",
               "evidence", "assumptions", "unmapped_events"],
  "properties": {
    "check": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["PASS", "FAIL", "INDETERMINATE"]},
    "formal_relation": {"type": "string"},
    "counterexample": {"type": ["object", "null"]},
    "evidence": {"type": "array"},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "unmapped_events": {"type": "array"},
    "detail": {"type": "object"}
  }
}
